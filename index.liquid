---
layout: base.liquid
title: Home
permalink: /
---

<div id="top-banner">
    <div class="swapper-container banner-swapper">
        {% assign banners = collections.offer | reverse %}
        
        {% for item in banners %}
        <div class="swapper-item {% if forloop.first %}active{% endif %}" data-type="{% if item.data.video %}video{% else %}image{% endif %}">
            {% if item.data.video %}
                <video src="{{ item.data.video | url }}" muted playsinline preload="metadata" {% if forloop.first %}autoplay{% endif %} aria-label="{{ item.data.title | default: 'Video Ad' }}"></video>
            {% else %}
                <img src="{{ item.data.image | url }}" alt="{{ item.data.title | default: 'Advertisement' }}">
            {% endif %}
            
            {% if item.data.link %}
                <a href="{{ item.data.link | url }}" class="banner-link-overlay" aria-label="View Offer"></a>
            {% endif %}
        </div>
        {% endfor %}
        
        {% if banners.size > 1 %}
        <div class="banner-pagination">
            {% for item in banners %}
            <span class="banner-dot {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
            {% endfor %}
        </div>
        {% endif %}
        
        {% if banners.size == 0 %}
            <p class='empty-gallery-message'>Loading offers...</p>
        {% endif %}
    </div>
</div>

<a href="/products/" class="prada-panel">
    <div class="prada-panel-label">ALiF Products</div>
    
    <div class="swapper-container products-panel-gallery">
        {% assign seen_categories = "" %}
        {% assign highlight_count = 0 %}
        {% assign recent_products = collections.product | reverse %}
        
        {% for item in recent_products %}
            {% if item.data.category %}
                {% assign cat = item.data.category | downcase %}
                {% assign cat_marker = "|" | append: cat | append: "|" %}
                
                {% unless seen_categories contains cat_marker %}
                    <div class="swapper-item {% if highlight_count == 0 %}active{% endif %}">
                        <img src="{{ item.data.image | url }}" alt="{{ item.data.title }}">
                    </div>
                    {% assign seen_categories = seen_categories | append: cat_marker %}
                    {% assign highlight_count = highlight_count | plus: 1 %}
                {% endunless %}
            {% endif %}
        {% endfor %}

        {% if collections.product.size == 0 %}
            <p class='empty-gallery-message'>Products coming soon.</p>
        {% endif %}
    </div>
</a>

<div class="cta-buttons panel-btn-wrapper">
    <a href="/products/" class="btn-full">Explore Products</a>
</div>

