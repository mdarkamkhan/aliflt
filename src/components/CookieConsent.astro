---
// src/components/CookieConsent.astro
// Luxury Glassmorphic Cookie & Privacy Consent Banner for alif.
---

<div id="alifCookieBanner" class="alif-cookie-banner" aria-hidden="true" role="region" aria-label="Privacy and Cookie Consent">
    <div class="alif-cookie-inner">
        <div class="alif-cookie-content">
            <div class="alif-cookie-header">
                <span class="alif-cookie-tag">PRIVACY & PREFERENCES</span>
            </div>
            <p class="alif-cookie-text">
                We use cookies and local area personalization to provide doorstep tailoring pickup, accurate local delivery estimates in Sahibganj, and an elevated boutique shopping experience.
            </p>
            <div class="alif-cookie-links">
                <a href="/privacy-policy/" class="alif-cookie-link">Privacy Policy</a>
                <span class="alif-cookie-dot" aria-hidden="true">·</span>
                <a href="/terms-of-service/" class="alif-cookie-link">Terms</a>
            </div>
        </div>

        <div class="alif-cookie-actions">
            <button type="button" id="cookieAcceptAllBtn" class="alif-cookie-btn primary">
                ACCEPT ALL
            </button>
            <button type="button" id="cookieEssentialBtn" class="alif-cookie-btn secondary">
                ESSENTIAL ONLY
            </button>
        </div>
    </div>
</div>

<style>
    .alif-cookie-banner {
        position: fixed;
        left: 16px;
        right: 16px;
        bottom: 80px; /* Sits above mobile bottom nav bar */
        z-index: 9990;
        max-width: 460px;
        margin: 0 auto;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px);
        transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
                    transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                    visibility 0.35s;
        pointer-events: none;
    }

    @media (min-width: 768px) {
        .alif-cookie-banner {
            left: 24px;
            right: auto;
            bottom: 24px;
            max-width: 440px;
            margin: 0;
        }
    }

    .alif-cookie-banner.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }

    .alif-cookie-inner {
        background: rgba(18, 18, 20, 0.94);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(212, 175, 55, 0.32);
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35), 0 0 1px 1px rgba(255, 255, 255, 0.05);
        border-radius: 14px;
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        color: #FBF9F6;
    }

    .alif-cookie-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 4px;
    }

    .alif-cookie-tag {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 600;
        color: #D4AF37;
    }

    .alif-cookie-text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 12.5px;
        line-height: 1.5;
        color: #E2E0D8;
        margin: 0;
    }

    .alif-cookie-links {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
    }

    .alif-cookie-link {
        font-size: 11px;
        color: #B5B3A8;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: color 0.2s ease;
    }

    .alif-cookie-link:hover {
        color: #D4AF37;
    }

    .alif-cookie-dot {
        font-size: 12px;
        color: #666;
    }

    .alif-cookie-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .alif-cookie-btn {
        flex: 1;
        padding: 9px 12px;
        border-radius: 8px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
    }

    .alif-cookie-btn.primary {
        background: #D4AF37;
        color: #121212;
        border: 1px solid #D4AF37;
    }

    .alif-cookie-btn.primary:hover {
        background: #E5C358;
        border-color: #E5C358;
    }

    .alif-cookie-btn.secondary {
        background: transparent;
        color: #D6D4CB;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .alif-cookie-btn.secondary:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #FFFFFF;
        border-color: rgba(255, 255, 255, 0.35);
    }
</style>

<script is:inline>
(function() {
    function initCookieBanner() {
        const banner = document.getElementById('alifCookieBanner');
        const acceptAllBtn = document.getElementById('cookieAcceptAllBtn');
        const essentialBtn = document.getElementById('cookieEssentialBtn');
        if (!banner) return;

        const storedConsent = localStorage.getItem('alif_cookie_consent');

        if (!storedConsent) {
            // Show after a polite 1.2s delay to prioritize initial view
            setTimeout(() => {
                banner.classList.add('is-visible');
                banner.setAttribute('aria-hidden', 'false');
            }, 1200);
        }

        function setConsent(choice) {
            localStorage.setItem('alif_cookie_consent', choice);
            localStorage.setItem('alif_cookie_consent_time', new Date().toISOString());
            banner.classList.remove('is-visible');
            banner.setAttribute('aria-hidden', 'true');
            window.dispatchEvent(new CustomEvent('alif:consent-updated', { 
                detail: { consent: choice } 
            }));
        }

        if (acceptAllBtn) {
            acceptAllBtn.onclick = () => setConsent('accepted');
        }
        if (essentialBtn) {
            essentialBtn.onclick = () => setConsent('essential');
        }

        window.openAlifCookiePreferences = function() {
            banner.classList.add('is-visible');
            banner.setAttribute('aria-hidden', 'false');
        };
    }

    document.addEventListener('astro:page-load', initCookieBanner);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initCookieBanner);
    } else {
        initCookieBanner();
    }
})();
</script>
