---
// src/components/CookieConsent.astro
// Monochrome Editorial Couture Cookie & Privacy Consent Banner for alif.
---

<div id="alifCookieBanner" class="alif-cookie-banner" aria-hidden="true" role="region" aria-label="Privacy and Cookie Consent" transition:persist>
    <div class="alif-cookie-inner">
        <div class="alif-cookie-top">
            <span class="alif-cookie-tag">PRIVACY &amp; COOKIES</span>
            <button type="button" id="cookieCloseIconBtn" class="alif-cookie-close" aria-label="Accept essential cookies and close">
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </svg>
            </button>
        </div>

        <p class="alif-cookie-text">
            We use cookies to personalize your atelier browsing, improve store performance, and verify local tailoring availability.
        </p>

        <div class="alif-cookie-links">
            <a href="/privacy-policy/" class="alif-cookie-link">Privacy Policy</a>
            <span class="alif-cookie-dot" aria-hidden="true">·</span>
            <a href="/terms-of-service/" class="alif-cookie-link">Terms of Service</a>
        </div>

        <div class="alif-cookie-actions">
            <button type="button" id="cookieAcceptAllBtn" class="alif-cookie-btn primary">
                ACCEPT ALL
            </button>
            <button type="button" id="cookieEssentialBtn" class="alif-cookie-btn secondary">
                ESSENTIAL ONLY
            </button>
        </div>
    </div>
</div>

<style>
    /* Mobile: Edge-to-edge monochrome bottom drawer (Zero overlap with #chat-button) */
    .alif-cookie-banner {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 10005;
        width: 100%;
        opacity: 0;
        visibility: hidden;
        transform: translateY(100%);
        transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
                    visibility 0.3s;
        pointer-events: none;
    }

    @media (min-width: 768px) {
        /* Desktop: Crisp bottom-left architectural frame (opposite right-side #chat-widget) */
        .alif-cookie-banner {
            left: 24px;
            right: auto;
            bottom: 24px;
            max-width: 390px;
            transform: translateY(16px);
        }
    }

    .alif-cookie-banner.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }

    .alif-cookie-inner {
        background: #FFFFFF;
        border-top: 1px solid #111111;
        box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.12);
        border-radius: 0px;
        padding: 16px 18px calc(18px + env(safe-area-inset-bottom, 0px)) 18px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        color: #111111;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
    }

    @media (min-width: 768px) {
        .alif-cookie-inner {
            border: 1px solid #111111;
            box-shadow: 0 12px 36px rgba(0, 0, 0, 0.12);
            padding: 18px 20px;
        }
    }

    .alif-cookie-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .alif-cookie-tag {
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.64rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: 500;
        color: #666666;
    }

    /* Signature Dotted Close Button matching MinimalistSidebar */
    .alif-cookie-close {
        width: 26px;
        height: 26px;
        border: 1px dotted rgba(0, 0, 0, 0.45);
        background: #FFFFFF;
        color: #111111;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        padding: 0;
        border-radius: 0px;
        transition: border-color 0.2s ease, border-style 0.2s ease;
    }

    .alif-cookie-close:hover {
        border-color: #000000;
        border-style: solid;
    }

    .alif-cookie-text {
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.8rem;
        line-height: 1.55;
        color: #333333;
        margin: 0;
    }

    .alif-cookie-links {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .alif-cookie-link {
        font-size: 0.7rem;
        letter-spacing: 0.4px;
        color: #111111;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: opacity 0.2s ease;
    }

    .alif-cookie-link:hover {
        opacity: 0.6;
    }

    .alif-cookie-dot {
        font-size: 11px;
        color: #999999;
    }

    .alif-cookie-actions {
        display: flex;
        gap: 10px;
        margin-top: 4px;
    }

    .alif-cookie-btn {
        flex: 1;
        padding: 11px 12px;
        border-radius: 0px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        cursor: pointer;
        transition: all 0.2s ease;
        text-align: center;
        -webkit-tap-highlight-color: transparent;
    }

    .alif-cookie-btn.primary {
        background: #111111;
        color: #FFFFFF;
        border: 1px solid #111111;
    }

    .alif-cookie-btn.primary:hover {
        background: #000000;
    }

    .alif-cookie-btn.secondary {
        background: #FFFFFF;
        color: #111111;
        border: 1px solid #111111;
    }

    .alif-cookie-btn.secondary:hover {
        background: #F4F2EE;
    }
</style>

<script>
function setConsentChoice(choice) {
    const banner = document.getElementById('alifCookieBanner');
    localStorage.setItem('alif_cookie_consent', choice);
    localStorage.setItem('alif_cookie_consent_time', new Date().toISOString());
    if (banner) {
        banner.classList.remove('is-visible');
        banner.setAttribute('aria-hidden', 'true');
    }
    window.dispatchEvent(
        new CustomEvent('alif:consent-updated', {
            detail: { consent: choice }
        })
    );
}

function showCookieBanner() {
    const banner = document.getElementById('alifCookieBanner');
    if (banner) {
        banner.classList.add('is-visible');
        banner.setAttribute('aria-hidden', 'false');
    }
}

function bindCookieBannerEvents() {
    if (window.__alifCookieBound) return;
    window.__alifCookieBound = true;

    window.openAlifCookiePreferences = showCookieBanner;

    document.addEventListener('click', (e) => {
        const target = e.target;
        if (!target || !target.closest) return;

        if (target.closest('#cookieAcceptAllBtn')) {
            setConsentChoice('accepted');
            return;
        }
        if (target.closest('#cookieEssentialBtn') || target.closest('#cookieCloseIconBtn')) {
            setConsentChoice('essential');
            return;
        }
        if (target.closest('#openCookiePrefsBtn')) {
            showCookieBanner();
        }
    });
}

function initCookieBanner() {
    bindCookieBannerEvents();
    const banner = document.getElementById('alifCookieBanner');
    if (!banner) return;

    const storedConsent = localStorage.getItem('alif_cookie_consent');
    if (!storedConsent && !window.__alifCookieScheduled) {
        window.__alifCookieScheduled = true;
        setTimeout(() => {
            if (!localStorage.getItem('alif_cookie_consent')) {
                showCookieBanner();
            }
        }, 1200);
    }
}

document.addEventListener('astro:page-load', initCookieBanner);
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
} else {
    initCookieBanner();
}
</script>
