---
// src/components/LocalityModal.astro
// Heritage Monochrome Delivery & Tailoring Location Check + Background Reverse-Geocoding
---

<!-- Polite Top Delivery Check Popover (Positioned cleanly below Marquee) -->
<div id="localityNudge" class="alif-loc-nudge" aria-hidden="true" role="status" transition:persist>
    <div class="alif-loc-nudge-arrow" aria-hidden="true"></div>
    <div class="alif-loc-nudge-content">
        <div class="alif-loc-nudge-copy">
            <span class="alif-loc-nudge-eyebrow">ATELIER DELIVERY</span>
            <span class="alif-loc-nudge-text">Check doorstep tailoring availability</span>
        </div>
        <div class="alif-loc-nudge-actions">
            <button type="button" id="nudgeDetectBtn" class="alif-loc-nudge-cta">DETECT</button>
            <button type="button" id="nudgeDismissBtn" class="alif-loc-nudge-close" aria-label="Dismiss location prompt">
                <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </svg>
            </button>
        </div>
    </div>
</div>

<!-- Monochrome Couture Location Modal -->
<div id="localityModal" class="alif-locality-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="localityModalTitle" transition:persist>
    <div class="alif-locality-backdrop" id="localityBackdrop"></div>
    <div class="alif-locality-card">
        <div class="alif-locality-drag-pill" aria-hidden="true"></div>

        <div class="alif-locality-header">
            <div>
                <span class="alif-locality-tag">DELIVERY &amp; TAILORING</span>
                <h3 id="localityModalTitle" class="alif-locality-title">Verify Your Location</h3>
            </div>
            <button type="button" class="alif-locality-close-btn" id="closeLocalityModalBtn" aria-label="Close dialog">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                    <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                </svg>
            </button>
        </div>

        <p class="alif-locality-subtitle">
            Allow location access to check doorstep home measurement and local delivery in Sahibganj, or Pan-India parcel shipping across India.
        </p>

        <!-- Current / Detected Service Availability Card -->
        <div id="locationServiceResult" class="alif-service-card" style="display:none;">
            <div class="alif-service-badge" id="locationServiceBadge"></div>
            <p class="alif-service-desc" id="locationServiceDesc"></p>
        </div>

        <!-- GPS Detection Binary Choice (Allow GPS or Decline) -->
        <div class="alif-gps-box">
            <button type="button" id="detectGpsBtn" class="alif-gps-btn">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
                <span>DETECT MY LOCATION</span>
            </button>
            <button type="button" id="declineGpsBtn" class="alif-gps-decline-btn">
                NOT NOW
            </button>
            <div id="gpsStatusMessage" class="alif-gps-status" style="display:none;"></div>
        </div>
    </div>
</div>

<style>
    /* Top Polite Popover Nudge - Monochrome Architectural Card below Marquee */
    .alif-loc-nudge {
        position: fixed;
        top: 100px; /* Clears 60px top nav + 32px marquee cleanly */
        left: 15px;
        z-index: 9985;
        max-width: 300px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-6px);
        transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s;
        pointer-events: none;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
    }

    @media (min-width: 601px) {
        .alif-loc-nudge {
            top: 114px; /* Clears 70px nav + 36px marquee */
            left: 20px;
        }
    }

    .alif-loc-nudge.is-visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
        pointer-events: auto;
    }

    .alif-loc-nudge-arrow {
        width: 9px;
        height: 9px;
        background: #FFFFFF;
        border-left: 1px solid #111111;
        border-top: 1px solid #111111;
        transform: rotate(45deg);
        margin-left: 64px;
        margin-bottom: -5px;
        position: relative;
        z-index: 2;
    }

    .alif-loc-nudge-content {
        background: #FFFFFF;
        border: 1px solid #111111;
        border-radius: 0px;
        padding: 11px 13px;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #111111;
    }

    .alif-loc-nudge-copy {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .alif-loc-nudge-eyebrow {
        font-size: 0.58rem;
        letter-spacing: 1.8px;
        color: #777777;
        font-weight: 500;
        text-transform: uppercase;
    }

    .alif-loc-nudge-text {
        font-size: 0.76rem;
        line-height: 1.35;
        color: #111111;
    }

    .alif-loc-nudge-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }

    .alif-loc-nudge-cta {
        background: #111111;
        color: #FFFFFF;
        border: 1px solid #111111;
        border-radius: 0px;
        padding: 6px 11px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .alif-loc-nudge-cta:hover {
        background: #000000;
    }

    .alif-loc-nudge-close {
        width: 24px;
        height: 24px;
        background: #FFFFFF;
        border: 1px dotted rgba(0, 0, 0, 0.45);
        color: #111111;
        padding: 0;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0px;
        transition: border-color 0.2s ease, border-style 0.2s ease;
    }

    .alif-loc-nudge-close:hover {
        border-color: #000000;
        border-style: solid;
    }

    /* Main Modal (Matches pwa-modal-card & mono-chat-window) */
    .alif-locality-modal {
        position: fixed;
        inset: 0;
        z-index: 10006;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.3s ease, visibility 0.3s;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
    }

    @media (min-width: 768px) {
        .alif-locality-modal {
            align-items: center;
        }
    }

    .alif-locality-modal.is-open {
        opacity: 1;
        visibility: visible;
    }

    .alif-locality-backdrop {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(6px);
        -webkit-backdrop-filter: blur(6px);
    }

    .alif-locality-card {
        position: relative;
        background: #FFFFFF;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        width: 100%;
        max-width: 440px;
        max-height: 85vh;
        overflow-y: auto;
        padding: 16px 22px calc(24px + env(safe-area-inset-bottom, 0px)) 22px;
        box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.2);
        color: #111111;
        transform: translateY(100%);
        transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
        box-sizing: border-box;
    }

    @media (min-width: 768px) {
        .alif-locality-card {
            border: 1px solid #111111;
            border-radius: 0px;
            padding: 24px 26px 28px;
            transform: translateY(16px);
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.2);
        }
    }

    .alif-locality-modal.is-open .alif-locality-card {
        transform: translateY(0);
    }

    .alif-locality-drag-pill {
        width: 36px;
        height: 4px;
        background: #D4D4D4;
        border-radius: 4px;
        margin: 0 auto 16px;
    }

    @media (min-width: 768px) {
        .alif-locality-drag-pill {
            display: none;
        }
    }

    .alif-locality-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        padding-bottom: 14px;
        margin-bottom: 14px;
        border-bottom: 1px solid #F0EDE6;
    }

    .alif-locality-tag {
        font-size: 0.64rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #666666;
        font-weight: 500;
        display: block;
        margin-bottom: 4px;
    }

    .alif-locality-title {
        font-family: var(--font-editorial, 'Playfair Display', Georgia, serif);
        font-size: 1.25rem;
        font-weight: 400;
        color: #000000;
        margin: 0;
        letter-spacing: 0.4px;
    }

    /* Signature % Arabica Dotted Box Close Button */
    .alif-locality-close-btn {
        width: 34px;
        height: 34px;
        background: #FFFFFF;
        border: 1px dotted rgba(0, 0, 0, 0.5);
        color: #000000;
        padding: 0;
        cursor: pointer;
        border-radius: 0px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
        flex-shrink: 0;
    }

    .alif-locality-close-btn:hover {
        border-color: #000000;
        border-style: solid;
        transform: scale(1.05);
    }

    .alif-locality-subtitle {
        font-size: 0.82rem;
        color: #444444;
        line-height: 1.6;
        margin: 0 0 18px;
    }

    .alif-service-card {
        padding: 12px 14px;
        border-radius: 0px;
        margin-bottom: 16px;
        background: #FBF9F6;
        border: 1px solid #E5E5E5;
        border-left: 3px solid #111111;
    }

    .alif-service-card.is-panindia {
        border-left-color: #666666;
    }

    .alif-service-badge {
        font-size: 0.66rem;
        font-weight: 600;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        color: #111111;
        margin-bottom: 4px;
    }

    .alif-service-desc {
        font-size: 0.78rem;
        color: #333333;
        line-height: 1.5;
        margin: 0;
    }

    .alif-gps-box {
        margin-bottom: 4px;
    }

    .alif-gps-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 18px;
        background: #111111;
        color: #FFFFFF;
        border: 1px solid #111111;
        border-radius: 0px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s ease, transform 0.15s ease;
    }

    .alif-gps-btn:hover:not(:disabled) {
        background: #000000;
    }

    .alif-gps-btn:disabled {
        opacity: 0.65;
        cursor: wait;
    }

    .alif-gps-decline-btn {
        width: 100%;
        margin-top: 10px;
        padding: 12px 18px;
        background: #FFFFFF;
        color: #333333;
        border: 1px solid #EAEAEA;
        border-radius: 0px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
    }

    .alif-gps-decline-btn:hover {
        border-color: #111111;
        color: #000000;
        background: #FAFAFA;
    }

    .alif-gps-status {
        font-size: 0.74rem;
        color: #333333;
        text-align: center;
        margin-top: 10px;
        padding: 8px 10px;
        background: #F4F2EE;
        border-radius: 0px;
    }
</style>

<script>
import {
    NUDGE_DISMISS_KEY,
    getLocationProfile,
    saveLocationProfile,
    syncHeaderLocationBadge,
    reverseGeocodeAndClassify
} from '../scripts/locationStore.js';

const SEVEN_DAYS_MS = 7 * 24 * 60 * 60 * 1000;

function hideNudge() {
    const nudge = document.getElementById('localityNudge');
    if (nudge) {
        nudge.classList.remove('is-visible');
        nudge.setAttribute('aria-hidden', 'true');
    }
}

function renderServiceResult(profile) {
    const card = document.getElementById('locationServiceResult');
    const badge = document.getElementById('locationServiceBadge');
    const desc = document.getElementById('locationServiceDesc');
    if (!card || !badge || !desc) return;

    if (!profile) {
        card.style.display = 'none';
        return;
    }

    card.style.display = 'block';
    card.classList.remove('is-local', 'is-panindia');

    if (profile.in_sahibganj) {
        card.classList.add('is-local');
        badge.textContent = 'SAHIBGANJ VERIFIED';
        desc.textContent =
            'Doorstep tailoring home measurement and free local delivery are available at your location.';
    } else {
        card.classList.add('is-panindia');
        badge.textContent = `${profile.display_city.toUpperCase()} — PAN-INDIA SHIPPING`;
        desc.textContent =
            'Doorstep tailoring pickup is in Sahibganj. Pan-India parcel delivery is available for Fabrics, Laces and Curated Sets.';
    }
}

function openModal() {
    const modal = document.getElementById('localityModal');
    if (!modal) return;
    hideNudge();
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    const modal = document.getElementById('localityModal');
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
}

function declineLocationPrompt() {
    localStorage.setItem(NUDGE_DISMISS_KEY, String(Date.now()));
    hideNudge();
    closeModal();
}

function requestGpsDetection(fromNudge = false) {
    const detectGpsBtn = document.getElementById('detectGpsBtn');
    const statusEl = document.getElementById('gpsStatusMessage');
    const nudgeBtn = document.getElementById('nudgeDetectBtn');

    if (!navigator.geolocation) {
        if (fromNudge) openModal();
        if (statusEl) {
            statusEl.style.display = 'block';
            statusEl.textContent = 'Location detection is not supported by your browser.';
        }
        return;
    }

    if (detectGpsBtn) detectGpsBtn.setAttribute('disabled', 'true');
    if (nudgeBtn) nudgeBtn.textContent = 'WAIT...';
    if (statusEl) {
        statusEl.style.display = 'block';
        statusEl.textContent = 'Detecting your exact location...';
    }

    navigator.geolocation.getCurrentPosition(
        async (position) => {
            try {
                const { latitude, longitude, accuracy } = position.coords;
                const profile = await reverseGeocodeAndClassify(latitude, longitude, accuracy);
                saveLocationProfile(profile);
                renderServiceResult(profile);
                hideNudge();

                if (statusEl) {
                    statusEl.textContent = profile.in_sahibganj
                        ? 'Location verified: Sahibganj'
                        : `Location detected: ${profile.display_city}`;
                }

                setTimeout(() => {
                    closeModal();
                }, 900);
            } catch {
                if (statusEl) {
                    statusEl.textContent = 'Could not verify location right now. Please try again.';
                }
            } finally {
                if (detectGpsBtn) detectGpsBtn.removeAttribute('disabled');
                if (nudgeBtn) nudgeBtn.textContent = 'DETECT';
            }
        },
        (error) => {
            if (detectGpsBtn) detectGpsBtn.removeAttribute('disabled');
            if (nudgeBtn) nudgeBtn.textContent = 'DETECT';

            if (fromNudge) openModal();
            if (statusEl) {
                statusEl.style.display = 'block';
                statusEl.textContent =
                    error.code === error.TIMEOUT
                        ? 'Location request timed out. Please try again.'
                        : 'Location access declined. Allow location permission anytime to verify.';
            }
        },
        {
            enableHighAccuracy: true,
            timeout: 12000,
            maximumAge: 60000
        }
    );
}

function schedulePoliteNudge() {
    if (window.__alifNudgeScheduled) return;
    window.__alifNudgeScheduled = true;

    const existing = getLocationProfile();
    if (existing) return;

    const dismissedAt = Number(localStorage.getItem(NUDGE_DISMISS_KEY) || 0);
    if (dismissedAt && Date.now() - dismissedAt < SEVEN_DAYS_MS) return;

    setTimeout(() => {
        if (getLocationProfile()) return;
        const modal = document.getElementById('localityModal');
        const sidebar = document.getElementById('sidebarMenu');
        if (modal && modal.classList.contains('is-open')) return;
        if (sidebar && sidebar.classList.contains('is-open')) return;

        const nudge = document.getElementById('localityNudge');
        if (nudge) {
            nudge.classList.add('is-visible');
            nudge.setAttribute('aria-hidden', 'false');
        }
    }, 4500);
}

function bindGlobalLocationEvents() {
    if (window.__alifLocalityBound) return;
    window.__alifLocalityBound = true;

    window.openAlifLocalityModal = openModal;
    window.closeAlifLocalityModal = closeModal;

    document.addEventListener('click', (e) => {
        const target = e.target;
        if (!target || !target.closest) return;

        if (target.closest('#headerLocalityBtn')) {
            openModal();
            return;
        }
        if (target.closest('#closeLocalityModalBtn') || target.closest('#localityBackdrop')) {
            closeModal();
            return;
        }
        if (target.closest('#declineGpsBtn')) {
            declineLocationPrompt();
            return;
        }
        if (target.closest('#detectGpsBtn')) {
            requestGpsDetection(false);
            return;
        }
        if (target.closest('#nudgeDetectBtn')) {
            requestGpsDetection(true);
            return;
        }
        if (target.closest('#nudgeDismissBtn')) {
            declineLocationPrompt();
            return;
        }
    });

    document.addEventListener('astro:before-swap', () => {
        closeModal();
    });
}

function initLocalityUI() {
    bindGlobalLocationEvents();
    const profile = getLocationProfile();
    syncHeaderLocationBadge(profile);
    renderServiceResult(profile);
    schedulePoliteNudge();
}

document.addEventListener('astro:page-load', initLocalityUI);
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLocalityUI);
} else {
    initLocalityUI();
}
</script>
