---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allWorks = await getCollection('works');
const works = [...allWorks].reverse();
---

<BaseLayout 
  title="Our Work Portfolio" 
  description="Explore finished custom outfits, bridal blouses, suits, and hand-stitched garments crafted by master tailors at ALiF."
>
  <div class="container section fade-in-section">
    <div class="page-header">
      <h1>Our Work Portfolio</h1>
      <p>Real customer orders and finished outfits handcrafted by ALiF experienced tailors.</p>
    </div>

    <div class="product-grid">
      {works.map((item) => (
        <div class="product-card">
          <div class="product-card-image-wrapper" style="aspect-ratio: 4 / 5; overflow: hidden; position: relative; border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title || 'Our Work'} style="width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;" loading="lazy" />
          </div>

          <div class="product-card-name">
            <div class="product-card-title">
              {item.data.title || 'Our Work'}
            </div>

            {item.data.category && (
              <div class="product-card-category" style="font-size: 0.8rem; color: #777; margin-top: 4px; text-transform: uppercase; letter-spacing: 0.5px;">
                {item.data.category}
              </div>
            )}

            {item.data.description && (
              <p style="font-size: 0.82rem; color: #555; margin: 8px 0 0 0; line-height: 1.4;">
                {item.data.description}
              </p>
            )}
          </div>
        </div>
      ))}

      {works.length === 0 && (
        <p class="empty-gallery-message" style="position:static; transform:none; color:#333; width:100%; text-align:center; padding: 40px 0;">
          Our work gallery coming soon. Check back shortly to see our latest creations!
        </p>
      )}
    </div>
  </div>
</BaseLayout>
