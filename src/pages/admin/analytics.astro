---
// src/pages/admin/analytics.astro
// Monochrome Couture Owner Telemetry Dashboard for alif.
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Atelier Analytics Dashboard" description="Live visitor dwell time, Sahibganj vs out-of-town breakdown, and exact GPS addresses for alif." hideFooter={true}>
    <div class="analytics-shell">
        <div class="analytics-container">
            <!-- Dashboard Header -->
            <header class="dash-header">
                <div>
                    <span class="dash-tag">ATELIER TELEMETRY</span>
                    <h1 class="dash-title">Audience &amp; Location Insights</h1>
                    <p class="dash-subtitle">Exact active dwell time, Sahibganj vs out-of-town breakdown, and reverse-geocoded visitor pins.</p>
                </div>

                <div class="dash-auth-box">
                    <input type="password" id="ownerPinInput" placeholder="Enter PIN" class="dash-pin-input" value="alif7250" />
                    <button type="button" id="refreshDataBtn" class="dash-refresh-btn">
                        REFRESH
                    </button>
                </div>
            </header>

            <!-- KPI Summary Cards -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-label">TOTAL PAGEVIEWS</span>
                    <div class="kpi-value" id="kpiPageviews">-</div>
                    <span class="kpi-caption">Active browse sessions</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">UNIQUE VISITORS</span>
                    <div class="kpi-value" id="kpiVisitors">-</div>
                    <span class="kpi-caption">Distinct devices</span>
                </div>
                <div class="kpi-card highlight">
                    <span class="kpi-label">AVG ACTIVE DWELL</span>
                    <div class="kpi-value" id="kpiDwell">-</div>
                    <span class="kpi-caption">Exact active viewing time</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-label">SAHIBGANJ VS OUTSIDE</span>
                    <div class="kpi-value" id="kpiRegionSplit">-</div>
                    <span class="kpi-caption" id="kpiRegionCaption">Verified visitor locations</span>
                </div>
            </div>

            <!-- 2-Column Analytics Breakdown -->
            <div class="breakdown-grid">
                <!-- City / Status Breakdown -->
                <div class="panel-card">
                    <div class="panel-header">
                        <h2 class="panel-title">Visitor Cities &amp; Status</h2>
                        <span class="panel-badge">Unique Visitors</span>
                    </div>
                    <p class="panel-sub">Sahibganj verified visitors vs out-of-town visitors and unshared sessions.</p>

                    <div id="localityBars" class="locality-bars-list">
                        <div class="empty-state">Loading location breakdown...</div>
                    </div>
                </div>

                <!-- Top Viewed Products & Pages -->
                <div class="panel-card">
                    <div class="panel-header">
                        <h2 class="panel-title">Top Pages &amp; Dwell Time</h2>
                        <span class="panel-badge">Engagement</span>
                    </div>
                    <p class="panel-sub">Fabrics, curated sets, and services where visitors linger longest.</p>

                    <div class="table-wrap">
                        <table class="dash-table">
                            <thead>
                                <tr>
                                    <th>Page / Product</th>
                                    <th style="text-align:right;">Views</th>
                                    <th style="text-align:right;">Avg Time</th>
                                </tr>
                            </thead>
                            <tbody id="topPagesBody">
                                <tr><td colspan="3" class="table-empty">Loading top items...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Exact Visitor Addresses & Map Pins -->
            <div class="panel-card full-width" style="margin-bottom: 24px;">
                <div class="panel-header">
                    <div>
                        <h2 class="panel-title">Exact Visitor Locations (Admin View)</h2>
                        <p class="panel-sub" style="margin: 4px 0 0;">Granular reverse-geocoded street/mohalla address and Google Maps pin when GPS permission is granted.</p>
                    </div>
                    <span class="panel-badge">GPS Precision</span>
                </div>
                <div class="table-wrap" style="margin-top: 14px;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Last Seen</th>
                                <th>City / Status</th>
                                <th>Exact Address</th>
                                <th>Accuracy</th>
                                <th>Device</th>
                                <th style="text-align:right;">Map Pin</th>
                            </tr>
                        </thead>
                        <tbody id="exactLocationsBody">
                            <tr><td colspan="6" class="table-empty">Waiting for visitors to allow GPS location...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Real-Time Activity Log -->
            <div class="panel-card full-width">
                <div class="panel-header">
                    <h2 class="panel-title">Recent Visitor Stream</h2>
                    <span class="panel-live-pill">LIVE PULSE</span>
                </div>
                <div class="table-wrap" style="margin-top: 12px;">
                    <table class="dash-table">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Event</th>
                                <th>Page</th>
                                <th>City / Exact Location</th>
                                <th>Active Secs</th>
                                <th>Scroll</th>
                                <th>Device</th>
                            </tr>
                        </thead>
                        <tbody id="recentEventsBody">
                            <tr><td colspan="7" class="table-empty">Connecting to telemetry buffer...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    .analytics-shell {
        background: #FBF9F6;
        min-height: calc(100vh - 106px);
        width: 100%;
    }

    .analytics-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 36px 20px 80px;
        color: #111111;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
    }

    .dash-header {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin-bottom: 28px;
        border-bottom: 1px solid #EAEAEA;
        padding-bottom: 22px;
    }

    @media (min-width: 768px) {
        .dash-header {
            flex-direction: row;
            align-items: flex-end;
            justify-content: space-between;
        }
    }

    .dash-tag {
        font-size: 0.64rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: #666666;
        font-weight: 500;
        display: block;
        margin-bottom: 6px;
    }

    .dash-title {
        font-family: var(--font-editorial, 'Playfair Display', Georgia, serif);
        font-size: 1.85rem;
        font-weight: 400;
        color: #000000;
        margin: 0 0 6px;
        letter-spacing: 0.4px;
    }

    .dash-subtitle {
        font-size: 0.84rem;
        color: #555555;
        margin: 0;
    }

    .dash-auth-box {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .dash-pin-input {
        background: #FFFFFF;
        border: 1px solid #EAEAEA;
        color: #111111;
        padding: 10px 14px;
        border-radius: 0px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.82rem;
        outline: none;
        transition: border-color 0.2s ease;
    }

    .dash-pin-input:focus {
        border-color: #111111;
    }

    .dash-refresh-btn {
        background: #111111;
        color: #FFFFFF;
        border: 1px solid #111111;
        padding: 10px 18px;
        border-radius: 0px;
        font-family: var(--font-body, 'Ubuntu', sans-serif);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .dash-refresh-btn:hover {
        background: #000000;
    }

    /* KPI Grid */
    .kpi-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
        margin-bottom: 24px;
    }

    @media (min-width: 900px) {
        .kpi-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    .kpi-card {
        background: #FFFFFF;
        border: 1px solid #EAEAEA;
        border-radius: 0px;
        padding: 18px 20px;
    }

    .kpi-card.highlight {
        border-color: #111111;
        box-shadow: inset 3px 0 0 #111111;
    }

    .kpi-label {
        font-size: 0.62rem;
        letter-spacing: 1.8px;
        text-transform: uppercase;
        color: #666666;
        font-weight: 500;
        display: block;
        margin-bottom: 8px;
    }

    .kpi-value {
        font-family: var(--font-editorial, 'Playfair Display', Georgia, serif);
        font-size: 1.75rem;
        font-weight: 500;
        color: #000000;
        margin-bottom: 4px;
    }

    .kpi-caption {
        font-size: 0.72rem;
        color: #777777;
    }

    /* Breakdown Grid */
    .breakdown-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
        margin-bottom: 24px;
    }

    @media (min-width: 900px) {
        .breakdown-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    .panel-card {
        background: #FFFFFF;
        border: 1px solid #EAEAEA;
        border-radius: 0px;
        padding: 22px;
    }

    .panel-card.full-width {
        margin-top: 10px;
    }

    .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
        gap: 12px;
    }

    .panel-title {
        font-family: var(--font-heading, 'Ubuntu', sans-serif);
        font-size: 0.92rem;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #000000;
        margin: 0;
    }

    .panel-badge {
        font-size: 0.6rem;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        padding: 4px 8px;
        border-radius: 0px;
        background: #F4F2EE;
        color: #333333;
        font-weight: 500;
        white-space: nowrap;
    }

    .panel-live-pill {
        font-size: 0.6rem;
        letter-spacing: 1.6px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 0px;
        background: #111111;
        color: #FFFFFF;
        font-weight: 500;
    }

    .panel-sub {
        font-size: 0.78rem;
        color: #666666;
        margin: 0 0 18px;
    }

    /* Locality Bars */
    .locality-bars-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .locality-bar-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .locality-bar-meta {
        display: flex;
        justify-content: space-between;
        font-size: 0.8rem;
        color: #111111;
        font-weight: 400;
    }

    .locality-bar-track {
        height: 6px;
        background: #F0EDE6;
        border-radius: 0px;
        overflow: hidden;
    }

    .locality-bar-fill {
        height: 100%;
        background: #111111;
        border-radius: 0px;
        transition: width 0.5s ease;
    }

    /* Tables */
    .table-wrap {
        overflow-x: auto;
    }

    .dash-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
        text-align: left;
    }

    .dash-table th {
        padding: 10px 12px;
        border-bottom: 1px solid #EAEAEA;
        color: #666666;
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 1.4px;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .dash-table td {
        padding: 11px 12px;
        border-bottom: 1px solid #F0EDE6;
        color: #111111;
        vertical-align: middle;
    }

    .dash-table tr:hover td {
        background: #FAFAFA;
    }

    .map-pin-link {
        display: inline-block;
        padding: 5px 10px;
        background: #FFFFFF;
        color: #111111;
        border: 1px solid #111111;
        border-radius: 0px;
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        text-decoration: none;
        white-space: nowrap;
        transition: all 0.2s ease;
    }

    .map-pin-link:hover {
        background: #111111;
        color: #FFFFFF;
    }

    .loc-chip {
        display: inline-block;
        padding: 3px 8px;
        border-radius: 0px;
        font-size: 0.64rem;
        font-weight: 500;
        letter-spacing: 0.8px;
        text-transform: uppercase;
    }

    .loc-chip.local {
        background: #111111;
        color: #FFFFFF;
        border: 1px solid #111111;
    }

    .loc-chip.outside {
        background: #FFFFFF;
        color: #111111;
        border: 1px solid #111111;
    }

    .loc-chip.unset {
        background: #F4F2EE;
        color: #666666;
        border: 1px solid #E5E5E5;
    }

    .table-empty, .empty-state {
        text-align: center;
        padding: 24px;
        color: #777777;
        font-size: 0.8rem;
    }
</style>

<script is:inline>
(function() {
    function escapeHtml(val) {
        return String(val == null ? '' : val)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function safeMapUrl(url) {
        const s = String(url || '').trim();
        if (/^https:\/\/(www\.)?google\.com\/maps\?q=[-0-9.,]+$/i.test(s)) {
            return s;
        }
        return '';
    }

    function formatSeconds(secs) {
        if (!secs || isNaN(secs)) return '0s';
        if (secs < 60) return `${secs}s`;
        const m = Math.floor(secs / 60);
        const s = secs % 60;
        return `${m}m ${s}s`;
    }

    function getStatusBadgeHtml(city, inSahibganj) {
        const safeCity = escapeHtml(city || 'Location Not Shared');
        if (inSahibganj === true) {
            return `<span class="loc-chip local">${safeCity}</span>`;
        }
        if (inSahibganj === false) {
            return `<span class="loc-chip outside">${safeCity}</span>`;
        }
        return `<span class="loc-chip unset">${safeCity}</span>`;
    }

    async function loadAnalytics() {
        const pinInput = document.getElementById('ownerPinInput');
        const pin = pinInput ? pinInput.value.trim() : 'alif7250';

        try {
            const res = await fetch(`/.netlify/functions/analytics?pin=${encodeURIComponent(pin)}`);
            if (!res.ok) {
                alert('Authentication required or invalid PIN.');
                return;
            }
            const data = await res.json();

            // Populate KPIs
            document.getElementById('kpiPageviews').textContent = data.total_pageviews || 0;
            document.getElementById('kpiVisitors').textContent = data.unique_visitors_count || 0;
            document.getElementById('kpiDwell').textContent = formatSeconds(data.avg_dwell_seconds);

            const split = data.sahibganj_split || { sahibganj: 0, outside: 0, not_shared: 0 };
            document.getElementById('kpiRegionSplit').textContent = `${split.sahibganj} · ${split.outside}`;
            document.getElementById('kpiRegionCaption').textContent =
                `${split.sahibganj} Sahibganj · ${split.outside} Outside · ${split.not_shared} Unshared`;

            // Render Locality Bars
            const locEntries = Object.entries(data.localities || {}).sort((a, b) => b[1] - a[1]);
            const localityListEl = document.getElementById('localityBars');
            if (localityListEl) {
                if (locEntries.length === 0) {
                    localityListEl.innerHTML = '<div class="empty-state">No visitor locations recorded yet.</div>';
                } else {
                    const maxVal = locEntries[0][1] || 1;
                    localityListEl.innerHTML = locEntries
                        .map(([name, count]) => {
                            const pct = Math.round((count / maxVal) * 100);
                            return `
                                <div class="locality-bar-item">
                                    <div class="locality-bar-meta">
                                        <span>${escapeHtml(name)}</span>
                                        <span>${count} visitors</span>
                                    </div>
                                    <div class="locality-bar-track">
                                        <div class="locality-bar-fill" style="width: ${pct}%"></div>
                                    </div>
                                </div>
                            `;
                        })
                        .join('');
                }
            }

            // Render Top Pages
            const topPagesBody = document.getElementById('topPagesBody');
            if (topPagesBody) {
                const pages = data.top_pages || [];
                if (pages.length === 0) {
                    topPagesBody.innerHTML =
                        '<tr><td colspan="3" class="table-empty">No page telemetry recorded yet.</td></tr>';
                } else {
                    topPagesBody.innerHTML = pages
                        .map(
                            (p) => `
                            <tr>
                                <td style="font-family: monospace; font-size: 12px; color: #111111;">${escapeHtml(p.path)}</td>
                                <td style="text-align:right; font-weight: 500;">${p.views}</td>
                                <td style="text-align:right;">${formatSeconds(p.avg_seconds)}</td>
                            </tr>
                        `
                        )
                        .join('');
                }
            }

            // Render Exact Visitor Locations Table
            const exactBody = document.getElementById('exactLocationsBody');
            if (exactBody) {
                const locs = data.exact_locations || [];
                if (locs.length === 0) {
                    exactBody.innerHTML =
                        '<tr><td colspan="6" class="table-empty">No visitors have allowed GPS location yet.</td></tr>';
                } else {
                    exactBody.innerHTML = locs
                        .map((item) => {
                            const timeStr = new Date(item.last_seen).toLocaleTimeString([], {
                                hour: '2-digit',
                                minute: '2-digit'
                            });
                            const safeUrl = safeMapUrl(item.map_link);
                            const mapHtml = safeUrl
                                ? `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer" class="map-pin-link">View Map</a>`
                                : `<span style="color:#777777;font-size:11.5px;">-</span>`;
                            const methodText =
                                item.gps_accuracy_m != null ? `GPS (${item.gps_accuracy_m}m)` : 'GPS';

                            return `
                                <tr>
                                    <td style="color:#666666; font-size:12px; white-space:nowrap;">${escapeHtml(timeStr)}</td>
                                    <td>${getStatusBadgeHtml(item.city || item.locality, item.in_sahibganj)}</td>
                                    <td style="font-size:12.5px; max-width:340px;">
                                        <div>${escapeHtml(item.exact_address || item.locality_detail || '-')}</div>
                                        ${item.coordinates ? `<div style="font-family:monospace; font-size:11px; color:#666666; margin-top:2px;">${escapeHtml(item.coordinates)}</div>` : ''}
                                    </td>
                                    <td style="font-size:12px; color:#444444;">${escapeHtml(methodText)}</td>
                                    <td style="font-size:12px; color:#444444;">${escapeHtml(item.device)}</td>
                                    <td style="text-align:right;">${mapHtml}</td>
                                </tr>
                            `;
                        })
                        .join('');
                }
            }

            // Render Recent Events Stream
            const recentEventsBody = document.getElementById('recentEventsBody');
            if (recentEventsBody) {
                const events = data.recent_events || [];
                if (events.length === 0) {
                    recentEventsBody.innerHTML =
                        '<tr><td colspan="7" class="table-empty">No stream events yet.</td></tr>';
                } else {
                    recentEventsBody.innerHTML = events
                        .map((e) => {
                            const timeStr = new Date(e.timestamp).toLocaleTimeString([], {
                                hour: '2-digit',
                                minute: '2-digit',
                                second: '2-digit'
                            });
                            const safeUrl = safeMapUrl(e.map_link);
                            const addrSub = e.exact_address
                                ? `<div style="font-size:11px; color:#555555; margin-top:2px;">${escapeHtml(e.exact_address)} ${safeUrl ? `<a href="${safeUrl}" target="_blank" rel="noopener noreferrer" style="color:#000000; text-decoration:underline; margin-left:4px;">Map</a>` : ''}</div>`
                                : '';

                            return `
                                <tr>
                                    <td style="color: #666666; font-size: 12px; white-space:nowrap;">${escapeHtml(timeStr)}</td>
                                    <td><span style="font-weight: 500; text-transform: uppercase; font-size: 11px; letter-spacing: 0.6px;">${escapeHtml(e.event_type)}</span></td>
                                    <td style="font-family: monospace; font-size: 11.5px;">${escapeHtml(e.page_path)}</td>
                                    <td>
                                        ${getStatusBadgeHtml(e.city || e.locality, e.in_sahibganj)}
                                        ${addrSub}
                                    </td>
                                    <td>${e.active_seconds ? `${e.active_seconds}s` : '-'}</td>
                                    <td>${e.scroll_depth ? `${e.scroll_depth}%` : '-'}</td>
                                    <td><span style="color: #444444; font-size: 11.5px;">${escapeHtml(e.device)}</span></td>
                                </tr>
                            `;
                        })
                        .join('');
                }
            }
        } catch (err) {
            console.error('Failed to fetch analytics:', err);
        }
    }

    document.addEventListener('astro:page-load', () => {
        const btn = document.getElementById('refreshDataBtn');
        if (btn) btn.onclick = loadAnalytics;
        loadAnalytics();
    });

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadAnalytics);
    } else {
        loadAnalytics();
    }
})();
</script>
