---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import reelsData from '../../data/reels.json';

const products = await getCollection('products');
const productsMap = new Map(products.map((p) => [p.id, p]));
const productsByCode = new Map(products.map((p) => [p.data.product_code, p]));

const curatedSetsByReelId = new Map();
products.forEach((p) => {
  const cat = (p.data.category || '').toLowerCase();
  if (cat === 'curated sets' || cat === 'curated set' || cat === 'dress set') {
    if (p.data.linked_reel_id) {
      curatedSetsByReelId.set(p.data.linked_reel_id, p);
    }
  }
});

function resolveCuratedSetForReel(reelId, slug, code) {
  const setProduct = (slug && productsMap.get(slug))
    || (reelId && curatedSetsByReelId.get(reelId))
    || (code && productsByCode.get(code));

  if (!setProduct) return null;

  const rawCombo = setProduct.data.combo_products || setProduct.data.combo_items || [];
  const items = rawCombo.map((item) => {
    const itemId = typeof item === 'string' ? item : (item.id || item.slug);
    const prod = productsMap.get(itemId) 
      || productsByCode.get(itemId)
      || products.find(p => p.id === itemId || p.id.includes(itemId) || (p.data.product_code && p.data.product_code.toLowerCase() === itemId.toLowerCase()));

    if (prod) {
      return {
        id: prod.id,
        title: prod.data.title,
        category: (prod.data.category || 'Piece').toUpperCase(),
        image: prod.data.image,
      };
    }

    let cleanCategory = 'PIECE';
    const low = itemId.toLowerCase();
    if (low.includes('fabric') || low.includes('crape') || low.includes('silk')) cleanCategory = 'FABRIC';
    else if (low.includes('latkan') || low.includes('tassel')) cleanCategory = 'LATKAN';
    else if (low.includes('lace') || low.includes('border')) cleanCategory = 'LACE';
    else if (low.includes('dupatta')) cleanCategory = 'DUPATTA';

    return {
      id: itemId,
      title: itemId,
      category: cleanCategory,
      image: null,
    };
  }).filter(Boolean);

  return {
    slug: setProduct.id,
    title: setProduct.data.title,
    price: setProduct.data.offer_price || setProduct.data.price,
    origPrice: setProduct.data.price,
    category: 'DRESS SET',
    url: `/products/${setProduct.id}/`,
    items: items.slice(0, 4)
  };
}

// Pure Reel Feed from reels.json with Enriched Atelier Metadata & Curated Sets
const reelsList = (reelsData || []).map((r, index) => {
  const reelId = r.id || `reel-${index + 1}`;
  const curatedSet = resolveCuratedSetForReel(reelId, r.curated_set_slug, r.curated_set_code);

  return {
    id: reelId,
    title: r.title || `Reel #${index + 1}`,
    video: r.video,
    raw_url: r.raw_url,
    public_id: r.public_id,
    image: r.poster || r.image || '/icons/icon-512x512.png',
    duration: r.duration || null,
    category: r.category || 'blouse',
    style: r.style || 'festive',
    tags: r.tags || [],
    linked_service: r.linked_service || null,
    linked_products: r.linked_products || [],
    curatedSet: curatedSet
  };
});
---

<BaseLayout 
  title="Reels & Atelier Stories" 
  description="Watch bespoke craftsmanship and luxury stitching in motion."
  hideFooter={true}
>
  <div class="reels-page-container">
    
    <!-- 1 Card at a Time Focused Feed with Native Instagram / Shorts Snap -->
    <div class="reels-feed-container">
      <div class="reels-feed" id="reelsFeed" tabindex="0" role="region" aria-label="Reels Video Feed">
        {reelsList.length > 0 ? (
          reelsList.map((item) => (
            <div 
              class="atelier-reel-card" 
              data-reel-id={item.id} 
              id={`reel-${item.id}`}
              data-category={item.category}
              data-style={item.style}
              data-tags={JSON.stringify(item.tags)}
              data-service={item.linked_service || ''}
              data-products={JSON.stringify(item.linked_products)}
            >
              <!-- Edge-to-Edge Reel Video (Single active playback handled by JS) -->
              <video 
                src={item.video} 
                poster={item.image}
                loop 
                muted 
                playsinline 
                webkit-playsinline
                preload="metadata"
                class="reel-video-element"
              ></video>

              <!-- Top Overlay: Clean Title with Persistent Sound Pill & Underline -->
              <div class="reel-top-bar">
                <div class="reel-top-row">
                  <h3 class="reel-top-title">{item.title}</h3>
                  <button type="button" class="reel-audio-pill sound-muted" aria-label="Toggle Sound" onclick="event.stopPropagation();" title="Toggle Sound">
                    <!-- Sound ON Icon -->
                    <svg class="audio-icon icon-vol-on" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                      <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                    <!-- Sound OFF (Muted) Icon -->
                    <svg class="audio-icon icon-vol-mute" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                      <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                    </svg>
                  </button>
                </div>
                <div class="reel-title-divider" aria-hidden="true"></div>
              </div>

              <!-- Center Audio & Play/Pause Controller -->
              <button type="button" class="reel-center-ctrl state-mute" aria-label="Audio and Playback Control">
                <!-- Mute Icon -->
                <svg class="center-icon icon-mute" viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
                  <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                </svg>
                <!-- Pause Icon -->
                <svg class="center-icon icon-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                  <rect x="7" y="5" width="2.5" height="14" rx="1.2" />
                  <rect x="14.5" y="5" width="2.5" height="14" rx="1.2" />
                </svg>
                <!-- Play Icon -->
                <svg class="center-icon icon-play" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                  <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/>
                </svg>
              </button>

              {item.curatedSet ? (
                <a 
                  href={item.curatedSet.url}
                  data-astro-prefetch="viewport"
                  class="reel-curated-strip" 
                  onclick="event.stopPropagation();"
                  aria-label={`View Curated Set - ${item.curatedSet.title}`}
                >
                  {/* Left: 3:4 Tall Portrait Mini Cards */}
                  <div class="rc-items-row">
                    {item.curatedSet.items.map((piece) => (
                      <div class="rc-mini-card" title={piece.title}>
                        {piece.image ? (
                          <img src={piece.image} alt={piece.title} loading="lazy" />
                        ) : (
                          <div class="rc-mini-fallback">
                            <span>{piece.category}</span>
                          </div>
                        )}
                      </div>
                    ))}
                  </div>

                  {/* Vertical Divider */}
                  <div class="rc-strip-divider" aria-hidden="true"></div>

                  {/* Right: Set Tag & Sharp Editorial Action Button */}
                  <div class="rc-action-col">
                    <span class="rc-set-tag">DRESS SET</span>
                    <span class="rc-action-btn">
                      <span>SHOW PRODUCT</span>
                      <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </span>
                  </div>
                </a>
              ) : null}
            </div>
          ))
        ) : (
          <div class="reels-empty-card">
            <div class="empty-inner">
              <span class="empty-badge">alif. ATELIER</span>
              <h2 class="empty-title">Reel Studio Syncing</h2>
              <p class="empty-desc">Your reels are staged and ready.</p>
            </div>
          </div>
        )}
      </div>

      <!-- Desktop Floating Quick Nav Buttons (Insta/Shorts style) -->
      <div class="reels-nav-controls" aria-label="Reels Navigation">
        <button type="button" class="reel-nav-btn btn-prev" id="reelNavPrev" aria-label="Previous Reel" title="Previous Reel (Up Arrow)">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </button>
        <button type="button" class="reel-nav-btn btn-next" id="reelNavNext" aria-label="Next Reel" title="Next Reel (Down Arrow)">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.2" fill="none">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
      </div>
    </div>

  </div>

  <!-- Embedded Catalog Data for Client-Side Personalization Engine -->
  <script id="reels-catalog-data" type="application/json" set:html={JSON.stringify(reelsList)} />

  <script>
    import {
      rankReelsFeed,
      trackWatchProgress,
      trackReelComplete,
      trackReelSkip,
      trackReelInteraction,
      markReelSessionSeen
    } from '../../utils/reelsEngine.js';

    // Luxury Reels: Instagram / YouTube Shorts 1-at-a-Time Playback & Next-Level Personalization
    function initReelInteractions() {
      const reelsFeed = document.getElementById('reelsFeed');
      if (!reelsFeed) return;

      // 1. Dynamic Client Personalization: Reorder DOM cards based on affinity & anti-fatigue
      const catalogEl = document.getElementById('reels-catalog-data');
      let catalog = [];
      if (catalogEl) {
        try {
          catalog = JSON.parse(catalogEl.textContent || '[]');
        } catch (_) {}
      }

      if (catalog.length > 0 && !reelsFeed._rankedOnce) {
        reelsFeed._rankedOnce = true;
        const cardMap = new Map();
        document.querySelectorAll('.atelier-reel-card').forEach((c) => {
          const id = c.getAttribute('data-reel-id');
          if (id) cardMap.set(id, c);
        });

        // Run Algorithm Re-ranking
        const ranked = rankReelsFeed(catalog);
        const frag = document.createDocumentFragment();
        ranked.forEach((item) => {
          const card = cardMap.get(item.id);
          if (card) frag.appendChild(card);
        });
        reelsFeed.appendChild(frag);
      }

      let cards = Array.from(document.querySelectorAll('.atelier-reel-card'));
      const btnPrev = document.getElementById('reelNavPrev');
      const btnNext = document.getElementById('reelNavNext');

      if (cards.length === 0) return;

      // Base template cards for never-ending infinite looping
      const baseCards = cards.map(c => c.cloneNode(true));
      let loopBatchCounter = 1;
      let isAppendingLoop = false;

      // Global Audio State (Persists across reels once user turns sound on)
      let isAudioGloballyActive = false;
      let activeCard = null;
      let activeStartTime = 0;
      let activeReelItem = null;

      function getCardData(card) {
        if (!card) return null;
        const id = card.getAttribute('data-reel-id');
        return catalog.find((c) => c.id === id) || { id };
      }

      // Strictly pause and mute all videos except targetCard
      function pauseAllExcept(targetCard) {
        cards.forEach((card) => {
          if (card !== targetCard) {
            const v = card.querySelector('video');
            const centerBtn = card.querySelector('.reel-center-ctrl');
            if (v) {
              if (!v.paused || v.currentTime > 0) {
                v.pause();
              }
              v.muted = true;
            }
            if (centerBtn) {
              centerBtn.classList.remove('state-paused');
            }
          }
        });
      }

      function updateSoundUI() {
        cards.forEach((card) => {
          const video = card.querySelector('video');
          const centerBtn = card.querySelector('.reel-center-ctrl');
          const soundPill = card.querySelector('.reel-audio-pill');

          if (soundPill) {
            if (isAudioGloballyActive) {
              soundPill.classList.add('sound-active');
              soundPill.classList.remove('sound-muted');
            } else {
              soundPill.classList.add('sound-muted');
              soundPill.classList.remove('sound-active');
            }
          }

          if (video) {
            // ONLY the current active card gets unmuted; ALL others remain muted
            if (card === activeCard) {
              video.muted = !isAudioGloballyActive;
            } else {
              video.muted = true;
            }
          }

          if (centerBtn && card === activeCard) {
            if (isAudioGloballyActive) {
              centerBtn.classList.remove('state-mute');
              if (video && !video.paused) {
                centerBtn.classList.add('fade-hidden');
              }
            } else {
              centerBtn.classList.add('state-mute');
              centerBtn.classList.remove('fade-hidden', 'state-paused');
            }
          }
        });
      }

      // Append Next Infinite Loop Batch (Never-ending Reels Feed)
      function appendNextInfiniteLoop() {
        if (!baseCards.length || isAppendingLoop) return;
        isAppendingLoop = true;
        const frag = document.createDocumentFragment();
        const batchNum = loopBatchCounter++;

        baseCards.forEach((baseCard) => {
          const clone = baseCard.cloneNode(true);
          const origId = clone.getAttribute('data-reel-id') || 'reel';
          clone.id = `${origId}-loop-${batchNum}`;
          clone._setupDone = false;

          const v = clone.querySelector('video');
          if (v) {
            v.pause();
            v.currentTime = 0;
            v.muted = true;
            v._telemetryBound = false;
          }

          setupCard(clone);
          frag.appendChild(clone);
        });

        reelsFeed.appendChild(frag);
        cards = Array.from(reelsFeed.querySelectorAll('.atelier-reel-card'));
        isAppendingLoop = false;
      }

      function activateCard(targetCard, forcePlay = false) {
        if (!targetCard) return;
        if (targetCard === activeCard && !forcePlay) return;

        // Auto append next batch when approaching bottom of feed
        const activeIdx = cards.indexOf(targetCard);
        if (activeIdx >= cards.length - 4) {
          appendNextInfiniteLoop();
        }

        // Hard rule: Pause and mute every other video immediately
        pauseAllExcept(targetCard);

        // Telemetry: Evaluate previous active reel watch time
        if (activeCard && activeCard !== targetCard) {
          if (activeReelItem && activeStartTime > 0) {
            const elapsedSec = (Date.now() - activeStartTime) / 1000;
            trackReelSkip(activeReelItem, elapsedSec);
            markReelSessionSeen(activeReelItem.id);
          }
        }

        // Set new active card & record start time
        activeCard = targetCard;
        activeStartTime = Date.now();
        activeReelItem = getCardData(targetCard);

        const video = targetCard.querySelector('video');
        const centerBtn = targetCard.querySelector('.reel-center-ctrl');

        if (!video) return;

        // Apply persistent sound state strictly to target card
        video.muted = !isAudioGloballyActive;

        if (centerBtn) {
          centerBtn.classList.remove('state-paused');
          if (isAudioGloballyActive) {
            centerBtn.classList.remove('state-mute');
            centerBtn.classList.add('fade-hidden');
          } else {
            centerBtn.classList.add('state-mute');
            centerBtn.classList.remove('fade-hidden');
          }
        }

        // Attach telemetry progress handler on active video
        if (!video._telemetryBound) {
          video._telemetryBound = true;
          video.addEventListener('timeupdate', () => {
            if (activeCard === targetCard && activeReelItem) {
              trackWatchProgress(activeReelItem, video.currentTime, video.duration);
            }
          });
          video.addEventListener('ended', () => {
            if (activeReelItem) {
              trackReelComplete(activeReelItem);
            }
          });
        }

        // Play single active video
        const playPromise = video.play();
        if (playPromise !== undefined) {
          playPromise.catch(() => {
            video.muted = true;
            video.play().catch(() => {});
            if (centerBtn) {
              centerBtn.classList.add('state-mute');
              centerBtn.classList.remove('fade-hidden');
            }
          });
        }
      }

      // Cleanup existing observer if re-initialized
      if (reelsFeed._observer) {
        reelsFeed._observer.disconnect();
      }

      // IntersectionObserver: Pause cards leaving viewport, activate dominant card
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || entry.intersectionRatio < 0.25) {
            if (entry.target !== activeCard) {
              const v = entry.target.querySelector('video');
              if (v && (!v.paused || v.currentTime > 0)) {
                v.pause();
                v.muted = true;
              }
            }
          }
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            activateCard(entry.target);
          }
        });
      }, {
        root: reelsFeed,
        threshold: [0.1, 0.25, 0.5, 0.75]
      });
      reelsFeed._observer = observer;

      // Scroll Fail-safe: Detects snap landing accurately on all devices
      let scrollCheckRaf = null;
      function checkCenterCard() {
        const feedRect = reelsFeed.getBoundingClientRect();
        const feedCenterY = feedRect.top + feedRect.height / 2;
        let closestCard = null;
        let minDiff = Infinity;

        cards.forEach((card) => {
          const r = card.getBoundingClientRect();
          const cardCenterY = r.top + r.height / 2;
          const diff = Math.abs(feedCenterY - cardCenterY);
          if (diff < minDiff) {
            minDiff = diff;
            closestCard = card;
          }
        });

        if (closestCard && closestCard !== activeCard && minDiff < feedRect.height * 0.45) {
          activateCard(closestCard);
        }

        if (closestCard) {
          const idx = cards.indexOf(closestCard);
          if (idx >= cards.length - 4) {
            appendNextInfiniteLoop();
          }
        }
      }

      reelsFeed.addEventListener('scroll', () => {
        if (reelsFeed.scrollHeight - reelsFeed.scrollTop - reelsFeed.clientHeight < 1200) {
          appendNextInfiniteLoop();
        }
        if (scrollCheckRaf) cancelAnimationFrame(scrollCheckRaf);
        scrollCheckRaf = requestAnimationFrame(checkCenterCard);
      }, { passive: true });

      if ('onscrollend' in window) {
        reelsFeed.addEventListener('scrollend', checkCenterCard, { passive: true });
      }

      // Global Audio Toggle
      function toggleAudioGlobal() {
        isAudioGloballyActive = !isAudioGloballyActive;
        updateSoundUI();
        if (isAudioGloballyActive && activeReelItem) {
          trackReelInteraction(activeReelItem, 'audio_unmute');
        }
        if (activeCard) {
          const video = activeCard.querySelector('video');
          if (video && video.paused) {
            video.play().catch(() => {});
          }
        }
      }

      // Setup and attach interactions to each reel card
      function setupCard(card) {
        if (card._setupDone) return;
        card._setupDone = true;

        observer.observe(card);

        const video = card.querySelector('video');
        const centerBtn = card.querySelector('.reel-center-ctrl');
        const soundPill = card.querySelector('.reel-audio-pill');

        if (!video) return;

        // Sound Pill Click
        if (soundPill) {
          soundPill.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            toggleAudioGlobal();
          });
        }

        // Center Button Click
        if (centerBtn) {
          centerBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();

            if (card !== activeCard) {
              isAudioGloballyActive = true;
              activateCard(card, true);
              return;
            }

            if (video.paused) {
              isAudioGloballyActive = true;
              pauseAllExcept(card);
              video.muted = false;
              video.play().catch(() => {});
              updateSoundUI();
              centerBtn.classList.remove('state-paused', 'state-mute');
              centerBtn.classList.add('fade-hidden');
            } else if (video.muted) {
              isAudioGloballyActive = true;
              updateSoundUI();
              video.muted = false;
              centerBtn.classList.remove('state-mute');
              centerBtn.classList.add('fade-hidden');
            } else {
              video.pause();
              centerBtn.classList.remove('fade-hidden');
              centerBtn.classList.add('state-paused');
            }
          });
        }

        // Distinguish between touch scroll (swipe) and tap
        let touchStartY = 0;
        let isTouchSwipe = false;

        card.addEventListener('touchstart', (e) => {
          if (e.touches && e.touches[0]) {
            touchStartY = e.touches[0].clientY;
            isTouchSwipe = false;
          }
        }, { passive: true });

        card.addEventListener('touchmove', (e) => {
          if (e.touches && e.touches[0]) {
            if (Math.abs(e.touches[0].clientY - touchStartY) > 10) {
              isTouchSwipe = true;
            }
          }
        }, { passive: true });

        // Tap card to unmute or toggle play/pause (only when not swiping)
        card.addEventListener('click', (e) => {
          if (isTouchSwipe) return; // User was scrolling, ignore tap
          if (e.target.closest('button') || e.target.closest('a')) return;

          if (card !== activeCard) {
            isAudioGloballyActive = true;
            activateCard(card, true);
            return;
          }

          if (video.paused) {
            isAudioGloballyActive = true;
            pauseAllExcept(card);
            video.muted = false;
            video.play().catch(() => {
              video.muted = true;
              video.play().catch(() => {});
            });
            updateSoundUI();
            if (centerBtn) {
              centerBtn.classList.remove('state-paused', 'state-mute');
              centerBtn.classList.add('fade-hidden');
            }
          } else if (video.muted) {
            isAudioGloballyActive = true;
            updateSoundUI();
            video.muted = false;
            if (centerBtn) {
              centerBtn.classList.remove('state-mute');
              centerBtn.classList.add('fade-hidden');
            }
          } else {
            video.pause();
            if (centerBtn) {
              centerBtn.classList.remove('fade-hidden');
              centerBtn.classList.add('state-paused');
            }
          }
        });
      }

      // Initialize all initial cards
      cards.forEach(card => setupCard(card));

      // Quick Nav Buttons (Next & Prev) with loop-around & endless loading
      function scrollToRelativeCard(delta) {
        if (cards.length === 0) return;
        const currentIdx = activeCard ? cards.indexOf(activeCard) : 0;
        let nextIdx = currentIdx + delta;

        // Auto append if approaching end
        if (nextIdx >= cards.length - 2) {
          appendNextInfiniteLoop();
        }

        if (nextIdx >= cards.length) {
          nextIdx = cards.length - 1;
        }

        if (nextIdx < 0) {
          nextIdx = cards.length - 1;
        }

        const target = cards[nextIdx];
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          activateCard(target, true);
        }
      }

      if (btnPrev) {
        btnPrev.onclick = () => scrollToRelativeCard(-1);
      }
      if (btnNext) {
        btnNext.onclick = () => scrollToRelativeCard(1);
      }

      // Keyboard Shortcuts (ArrowDown / ArrowUp / Space / M)
      window.addEventListener('keydown', (e) => {
        if (['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName)) return;

        if (e.key === 'ArrowDown' || e.key === 'PageDown') {
          e.preventDefault();
          scrollToRelativeCard(1);
        } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
          e.preventDefault();
          scrollToRelativeCard(-1);
        } else if (e.key === ' ' /* Space */) {
          e.preventDefault();
          if (activeCard) {
            const video = activeCard.querySelector('video');
            const centerBtn = activeCard.querySelector('.reel-center-ctrl');
            if (video) {
              if (video.paused) {
                pauseAllExcept(activeCard);
                video.play().catch(() => {});
                if (centerBtn) {
                  centerBtn.classList.remove('state-paused');
                  centerBtn.classList.add('fade-hidden');
                }
              } else {
                video.pause();
                if (centerBtn) {
                  centerBtn.classList.remove('fade-hidden');
                  centerBtn.classList.add('state-paused');
                }
              }
            }
          }
        } else if (e.key === 'm' || e.key === 'M') {
          e.preventDefault();
          toggleAudioGlobal();
        }
      });

      // Initialize: pause all videos, then start first visible
      cards.forEach((c) => {
        const v = c.querySelector('video');
        if (v) {
          v.pause();
          v.currentTime = 0;
          v.muted = true;
        }
      });

      let targetInitialCard = null;
      if (window.location.hash) {
        try {
          targetInitialCard = document.querySelector(window.location.hash);
        } catch (_) {}
      }
      if (targetInitialCard && cards.includes(targetInitialCard)) {
        targetInitialCard.scrollIntoView({ behavior: 'auto', block: 'start' });
        activateCard(targetInitialCard, true);
      } else if (cards.length > 0) {
        activateCard(cards[0], true);
      }
    }

    // Safety Cleanup: Stop all reels playback when navigating away or switching tabs
    function cleanupAllReels() {
      document.querySelectorAll('.atelier-reel-card video').forEach((v) => {
        v.pause();
        v.muted = true;
      });
    }

    document.addEventListener('astro:before-swap', cleanupAllReels);
    window.addEventListener('pagehide', cleanupAllReels);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        cleanupAllReels();
      }
    });

    document.addEventListener('astro:page-load', initReelInteractions);
  </script>

