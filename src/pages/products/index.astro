---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import categoryFilters from '../../data/categoryFilters.json';
import { getCardImageAttrs } from '../../utils/imagePerf';

const allProducts = await getCollection('products');

// ─── Build-Time Smart Shuffle ────────────────────────────────────────────────
// Goal: category-interleaved order so the grid never clusters identical items.
// A per-build deterministic jitter (based on build timestamp) ensures every
// Netlify deploy produces a meaningfully different base ordering.

// 1. Bucket products by category (newest-first within each bucket via date desc)
const byCategory: Record<string, typeof allProducts> = {};
for (const p of allProducts) {
  const cat = (p.data.category || 'other').toLowerCase();
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(p);
}

// Sort within each bucket newest → oldest so fresh stock surfaces first
for (const cat of Object.keys(byCategory)) {
  byCategory[cat].sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
}

// 2. Per-build seed so each deploy rotates the starting category
const BUILD_SEED = Date.now();
const catKeys = Object.keys(byCategory).sort(); // stable sort
const startOffset = BUILD_SEED % catKeys.length;
const rotatedCats = [...catKeys.slice(startOffset), ...catKeys.slice(0, startOffset)];

// 3. Round-robin interleave across all categories
const products: typeof allProducts = [];
const queues = rotatedCats.map(k => byCategory[k]);
let hasMore = true;
while (hasMore) {
  hasMore = false;
  for (const queue of queues) {
    if (queue.length > 0) {
      products.push(queue.shift()!);
      hasMore = true;
    }
  }
}

const firstCardAttrs = products.length > 0
  ? getCardImageAttrs(products[0].data.image, '(max-width: 600px) 46vw, (max-width: 1024px) 30vw, 220px')
  : null;
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout 
  title="Our Products" 
  description="Explore our exquisite collection of designer laces, borders, latkans, and boutique fabrics at alif. ladies tailor."
  preloadImage={firstCardAttrs?.src}
  preloadImageSrcset={firstCardAttrs?.srcset}
  preloadImageSizes={firstCardAttrs?.sizes}
>
  <div class="container section fade-in-section products-page-container">

    <!-- Editorial Typography Category Tabs (Zara / Haute Couture Style) -->
    <div class="editorial-tabs-wrapper">
      <div class="editorial-tabs-track" role="tablist" aria-label="Product Categories">
        <button 
          type="button"
          class="editorial-tab-btn active" 
          data-filter-values="all" 
          data-category-name="All Products"
          role="tab"
          aria-selected="true"
        >
          <span class="tab-label">All</span>
        </button>

        {categoryFilters.categories.map((category) => (
          <button 
            type="button"
            class="editorial-tab-btn" 
            data-filter-values={category.values.join(',').toLowerCase()}
            data-category-name={category.name}
            role="tab"
            aria-selected="false"
          >
            <span class="tab-label">{category.name}</span>
          </button>
        ))}

        <a 
          href="/reels/" 
          class="editorial-tab-btn reels-direct-link"
          role="tab"
          aria-selected="false"
          title="Watch all 54 atelier video reels"
        >
          <span class="tab-label">Reels</span>
        </a>
      </div>
    </div>

    <!-- Product Status Bar (Live Count & Minimalist Filter Trigger) -->
    <div class="product-status-bar" id="productStatusBar">
      <div class="status-left">
        <span class="status-count-label" id="productCountLabel">All Products ({products.length})</span>
      </div>
      <div class="status-right">
        <button type="button" class="minimal-filter-btn" id="openFilterBtn" aria-label="Open Filter and Sort Drawer">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="7" y1="12" x2="17" y2="12"></line>
            <line x1="10" y1="18" x2="14" y2="18"></line>
          </svg>
          <span>Filter &amp; Sort</span>
          <span class="filter-count-badge" id="activeFilterBadge" style="display: none;">0</span>
        </button>
      </div>
    </div>

    <!-- Active Filter Chips Bar (Dismissible Pills) -->
    <div class="active-filters-bar" id="activeFiltersBar" style="display: none;">
      <div class="active-chips-track" id="activeChipsTrack"></div>
      <button type="button" class="clear-all-filters-btn" id="clearAllFiltersBtn">Clear All</button>
    </div>

    <!-- Product Grid -->
    <div class="product-grid" data-shuffle-type="product" id="productGrid">
      {products.map((item, index) => {
        const { title, price, offer_price, image, category, combo_items } = item.data;
        const catLower = (category || '').toLowerCase();
        const hasVideo = !!item.data.reel_video;
        const isCuratedSet = (catLower === 'curated sets' || catLower === 'curated set' || catLower === 'curated') && !hasVideo;
        // Affinity tokens baked into HTML so client JS can score without extra fetch
        const affinityTokens = [
          item.data.fabric,
          item.data.colour,
          item.data.work,
          item.data.pattern,
          category,
          ...(item.data.ideal_for ? item.data.ideal_for.split(/[,\/]/) : [])
        ].filter(Boolean).map(t => t.toLowerCase().trim()).join(' ');
        const imgAttrs = getCardImageAttrs(image, '(max-width: 600px) 46vw, (max-width: 1024px) 30vw, 220px');
        const numPrice = Number(offer_price || price || 0);
        const hasOffer = Boolean(offer_price && Number(offer_price) < Number(price));
        const itemDate = item.data.date ? new Date(item.data.date).getTime() : 0;
        const fabricLower = (item.data.fabric || '').toLowerCase();
        const colourLower = (item.data.colour || '').toLowerCase();
        const workLower = (item.data.work || '').toLowerCase();
        return (
          <a 
            href={`/products/${item.id}/`} 
            class="product-card" 
            data-category={catLower} 
            data-has-video={item.data.reel_video ? "true" : "false"} 
            data-is-curated={isCuratedSet ? "true" : "false"} 
            data-affinity-tokens={affinityTokens}
            data-price={numPrice}
            data-has-offer={hasOffer ? "true" : "false"}
            data-date={itemDate}
            data-fabric={fabricLower}
            data-colour={colourLower}
            data-work={workLower}
            data-original-index={index}
          >
            <div class="product-card-image-wrapper">
              <img
                {...imgAttrs}
                alt={title}
                width="384"
                height="480"
                loading={index < 4 ? "eager" : "lazy"}
                fetchpriority={index < 2 ? "high" : "auto"}
                decoding="async"
                class="product-card-cover-img"
              />
              {item.data.reel_video && (
                <video 
                  data-src={item.data.reel_video} 
                  loop 
                  muted 
                  playsinline 
                  webkit-playsinline
                  preload="none"
                  class="product-grid-video"
                ></video>
              )}
              {item.data.reel_video && !isCuratedSet && (
                <span class="product-card-video-badge" title="Watch Atelier Reel Video">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  REEL
                </span>
              )}
            </div>

            <div class="product-card-name">
              <div class="product-card-title">{title}</div>

              <div class="product-card-bottom-row">
                {category && (
                  <div class="product-card-category">{category}</div>
                )}

                <div class="product-card-price-wrapper">
                  {offer_price ? (
                    <div class="product-card-price has-offer">
                      <del class="original-price">₹{price}</del>
                      <span class="offer-price">₹{offer_price}</span>
                    </div>
                  ) : (
                    <div class="product-card-price">₹{price}</div>
                  )}
                </div>
              </div>
            </div>
          </a>
        );
      })}

      {products.length === 0 && (
        <p class="empty-gallery-message" style="position:static; transform:none; color:#333; width:100%; text-align:center; padding: 40px 0;">
          Products coming soon.
        </p>
      )}

      <div id="categoryEmptyMessage" style="display: none; width: 100%; text-align: center; padding: 60px 20px; grid-column: 1 / -1;">
        <p style="font-family: var(--font-body); font-size: 1rem; color: #555; margin: 0 0 8px 0; letter-spacing: 0.5px;">New collection arriving soon.</p>
        <p style="font-size: 0.82rem; color: #999; margin: 0;">We are currently curating exclusive designs for this category.</p>
      </div>

      <div id="filterEmptyMessage" class="filter-empty-state" style="display: none;">
        <p class="filter-empty-title">No matching pieces found</p>
        <p class="filter-empty-desc">Try clearing or adjusting some of your selected filters to view more items.</p>
        <button type="button" class="filter-empty-reset-btn" id="emptyResetBtn">Reset All Filters</button>
      </div>
    </div>

  </div>

  <!-- Minimalist Filter & Sort Drawer (Idea 1 + Idea 3: Visual Swatches & Tactile Chips) -->
  <div class="filter-drawer-backdrop" id="filterBackdrop" aria-hidden="true"></div>

  <aside class="filter-drawer" id="filterDrawer" aria-label="Filter and sort products" aria-hidden="true">
    <div class="drawer-drag-pill" aria-hidden="true"></div>

    <div class="drawer-header">
      <div class="drawer-header-left">
        <h2 class="drawer-title">Filter &amp; Sort</h2>
        <span class="drawer-subtitle" id="drawerLiveCount">{products.length} Products</span>
      </div>
      <button type="button" class="drawer-close-btn" id="closeFilterBtn" aria-label="Close Filter Drawer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="drawer-body">
      <!-- Section 1: Sort By -->
      <div class="drawer-section">
        <div class="section-label-row">
          <span class="section-label">Sort By</span>
        </div>
        <div class="sort-options-grid">
          <label class="sort-pill-label">
            <input type="radio" name="productSortRadio" value="default" checked />
            <span class="pill-text">Featured</span>
          </label>
          <label class="sort-pill-label">
            <input type="radio" name="productSortRadio" value="price-asc" />
            <span class="pill-text">Price: Low to High</span>
          </label>
          <label class="sort-pill-label">
            <input type="radio" name="productSortRadio" value="price-desc" />
            <span class="pill-text">Price: High to Low</span>
          </label>
          <label class="sort-pill-label">
            <input type="radio" name="productSortRadio" value="newest" />
            <span class="pill-text">Newest First</span>
          </label>
        </div>
      </div>

      <!-- Section 2: Color Palette (Idea 3: Visual Swatches) -->
      <div class="drawer-section">
        <div class="section-label-row">
          <span class="section-label">Color Palette</span>
          <span class="section-badge-count" id="activeColorCount" style="display: none;">0</span>
        </div>
        <div class="color-swatches-grid" id="colorSwatchesGrid">
          <button type="button" class="color-swatch-btn" data-color="wine" aria-label="Wine Maroon">
            <span class="swatch-circle" style="background-color: #6A1A24;"></span>
            <span class="swatch-label">Wine</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="teal" aria-label="Teal Peacock">
            <span class="swatch-circle" style="background-color: #0B6477;"></span>
            <span class="swatch-label">Teal</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="rani" aria-label="Rani Pink">
            <span class="swatch-circle" style="background-color: #D81B60;"></span>
            <span class="swatch-label">Rani Pink</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="yellow" aria-label="Haldi Yellow">
            <span class="swatch-circle" style="background-color: #E6A100;"></span>
            <span class="swatch-label">Haldi</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="ivory" aria-label="Pearl Ivory">
            <span class="swatch-circle swatch-light" style="background-color: #F8F6F0;"></span>
            <span class="swatch-label">Ivory</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="green" aria-label="Emerald Green">
            <span class="swatch-circle" style="background-color: #185338;"></span>
            <span class="swatch-label">Emerald</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="gold" aria-label="Metallic Gold">
            <span class="swatch-circle" style="background-color: #C5A059;"></span>
            <span class="swatch-label">Gold</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="black" aria-label="Jet Black">
            <span class="swatch-circle" style="background-color: #111111;"></span>
            <span class="swatch-label">Black</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="red" aria-label="Scarlet Red">
            <span class="swatch-circle" style="background-color: #C62828;"></span>
            <span class="swatch-label">Red</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="rust" aria-label="Sunset Rust">
            <span class="swatch-circle" style="background-color: #D35400;"></span>
            <span class="swatch-label">Rust</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="mauve" aria-label="Dusty Mauve">
            <span class="swatch-circle" style="background-color: #A36B79;"></span>
            <span class="swatch-label">Mauve</span>
          </button>
          <button type="button" class="color-swatch-btn" data-color="blue" aria-label="Royal Turquoise Blue">
            <span class="swatch-circle" style="background-color: #1565C0;"></span>
            <span class="swatch-label">Blue</span>
          </button>
        </div>
      </div>

      <!-- Section 3: Fabric Type (Idea 3: Tactile Fabric Chips) -->
      <div class="drawer-section">
        <div class="section-label-row">
          <span class="section-label">Fabric Type</span>
          <span class="section-badge-count" id="activeFabricCount" style="display: none;">0</span>
        </div>
        <div class="chips-flex-wrap" id="fabricChipsGroup">
          <button type="button" class="filter-chip-btn" data-fabric="crush">Crush Silk</button>
          <button type="button" class="filter-chip-btn" data-fabric="fandy">Fandy Silk</button>
          <button type="button" class="filter-chip-btn" data-fabric="tissue">Tissue Silk</button>
          <button type="button" class="filter-chip-btn" data-fabric="organza">Organza</button>
          <button type="button" class="filter-chip-btn" data-fabric="georgette">Georgette</button>
          <button type="button" class="filter-chip-btn" data-fabric="velvet">Velvet</button>
          <button type="button" class="filter-chip-btn" data-fabric="satin">Satin</button>
          <button type="button" class="filter-chip-btn" data-fabric="cotton">Pure Cotton</button>
          <button type="button" class="filter-chip-btn" data-fabric="net">Net</button>
          <button type="button" class="filter-chip-btn" data-fabric="crape">Moss Crape</button>
        </div>
      </div>

      <!-- Section 4: Work & Craft -->
      <div class="drawer-section">
        <div class="section-label-row">
          <span class="section-label">Work &amp; Craft</span>
          <span class="section-badge-count" id="activeWorkCount" style="display: none;">0</span>
        </div>
        <div class="chips-flex-wrap" id="workChipsGroup">
          <button type="button" class="filter-chip-btn" data-work="zari">Zari Work</button>
          <button type="button" class="filter-chip-btn" data-work="sequin">Sequin Jaal</button>
          <button type="button" class="filter-chip-btn" data-work="scallop">Scallop Cutwork</button>
          <button type="button" class="filter-chip-btn" data-work="floral">Floral Embroidery</button>
          <button type="button" class="filter-chip-btn" data-work="mirror">Mirror Work</button>
          <button type="button" class="filter-chip-btn" data-work="plain">Plain Solid</button>
        </div>
      </div>

      <!-- Section 5: Price Range -->
      <div class="drawer-section">
        <div class="section-label-row">
          <span class="section-label">Price Range</span>
          <span class="section-badge-count" id="activePriceCount" style="display: none;">0</span>
        </div>
        <div class="chips-flex-wrap" id="priceChipsGroup">
          <button type="button" class="filter-chip-btn" data-price-range="under-500">Under ₹500</button>
          <button type="button" class="filter-chip-btn" data-price-range="500-1000">₹500 – ₹1,000</button>
          <button type="button" class="filter-chip-btn" data-price-range="1000-2000">₹1,000 – ₹2,000</button>
          <button type="button" class="filter-chip-btn" data-price-range="above-2000">Above ₹2,000</button>
        </div>
      </div>

      <!-- Section 6: Offers & Special Pricing -->
      <div class="drawer-section drawer-section-compact">
        <div class="drawer-toggle-row">
          <div class="toggle-text-block">
            <span class="toggle-label-main">Sale &amp; Special Offers</span>
            <span class="toggle-label-sub">Show pieces with promotional discount</span>
          </div>
          <label class="minimal-switch-label" for="offersOnlyCheckbox">
            <input type="checkbox" id="offersOnlyCheckbox" class="switch-native-input" />
            <span class="switch-custom-track"></span>
          </label>
        </div>
      </div>
    </div>

    <!-- Drawer Sticky Footer -->
    <div class="drawer-footer">
      <button type="button" class="drawer-reset-action-btn" id="drawerResetBtn">Reset</button>
      <button type="button" class="drawer-apply-action-btn" id="drawerApplyBtn">
        <span>View Products</span>
        <span class="apply-count" id="drawerApplyCount">({products.length})</span>
      </button>
    </div>
  </aside>

  <script>
    // ─── Client-Side Affinity Ranker ────────────────────────────────────────
    // Reads user's unified affinity profile (shared with reels engine) and
    // re-sorts product cards so items matching the user's taste float to top.
    function applyAffinityRanking() {
      const grid = document.getElementById('productGrid') as any;
      if (!grid || grid._affinityRanked) return;
      grid._affinityRanked = true;

      let affinity: Record<string, number> = {};
      try {
        const reelsAff = JSON.parse(localStorage.getItem('alif_reels_affinity') || '{}');
        const prodAff  = JSON.parse(localStorage.getItem('alif_product_affinity') || '{}');
        affinity = { ...reelsAff };
        for (const [k, v] of Object.entries(prodAff)) {
          affinity[k] = (affinity[k] || 0) + Number(v);
        }
      } catch (_) { return; }

      const totalSignal = Object.values(affinity).reduce((s, v) => s + Math.abs(Number(v)), 0);
      if (totalSignal < 5) return;

      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
      if (!cards.length) return;

      let maxScore = 0;
      const scored = cards.map(card => {
        const tokens = (card.getAttribute('data-affinity-tokens') || '').split(' ');
        let score = 0;
        for (let i = 0; i < tokens.length; i++) {
          const token = tokens[i];
          if (token && affinity[token]) score += Number(affinity[token]);
        }
        if (score > maxScore) maxScore = score;
        return { card, score };
      });

      if (maxScore < 5) return;

      scored.sort((a, b) => b.score - a.score);

      const fragment = document.createDocumentFragment();
      for (const { card } of scored) fragment.appendChild(card);
      grid.querySelectorAll(':scope > :not(.product-card)').forEach((el: Element) => fragment.appendChild(el));
      grid.appendChild(fragment);
    }

    function trackProductView(tokens: string[]) {
      if (!tokens || !tokens.length) return;
      try {
        const aff = JSON.parse(localStorage.getItem('alif_product_affinity') || '{}');
        for (const token of tokens) {
          const k = token.toLowerCase().trim();
          if (!k) continue;
          aff[k] = Math.min(150, (aff[k] || 0) + 5);
        }
        localStorage.setItem('alif_product_affinity', JSON.stringify(aff));
      } catch (_) {}
    }

    if (typeof BroadcastChannel !== 'undefined' && !(window as any)._alifBroadcastBound) {
      (window as any)._alifBroadcastBound = true;
      const ch = new BroadcastChannel('alif_product_signals');
      ch.onmessage = (e) => {
        if (e.data && e.data.type === 'product_view') {
          trackProductView(e.data.tokens);
        }
      };
    }

    let videoObserver: IntersectionObserver | null = null;

    function ensureVideoObserver() {
      if (videoObserver || !('IntersectionObserver' in window)) return;
      videoObserver = new IntersectionObserver((entries) => {
        const grid = document.getElementById('productGrid');
        const isReelsMode = grid && grid.classList.contains('mode-reels-outfit');
        entries.forEach(entry => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && isReelsMode) {
            const src = video.getAttribute('data-src');
            if (src && !video.src) {
              video.src = src;
              video.load();
            }
            video.play().catch(() => {});
          } else if (video.src && !video.paused) {
            video.pause();
          }
        });
      }, { threshold: 0.25, rootMargin: '100px 0px' });

      document.querySelectorAll('.product-grid-video').forEach(v => videoObserver!.observe(v));
    }

    // ─── Minimalist Filter & Sort Engine (Idea 1 + Idea 3) ───────────────────
    const COLOR_KEYWORDS: Record<string, string[]> = {
      wine: ['wine', 'maroon', 'burgundy', 'aubergine', 'plum', 'cherry'],
      teal: ['teal', 'peacock', 'turquoise', 'aqua'],
      rani: ['rani', 'pink', 'magenta', 'fuchsia', 'rose'],
      yellow: ['yellow', 'haldi', 'mustard', 'ochre', 'amber'],
      ivory: ['ivory', 'white', 'cream', 'champagne', 'off white', 'off-white'],
      green: ['green', 'emerald', 'bottle green', 'forest emerald', 'sage'],
      gold: ['gold', 'golden', 'bronze', 'copper'],
      black: ['black', 'charcoal'],
      red: ['red', 'scarlet', 'crimson', 'vermillion'],
      rust: ['rust', 'terracotta', 'orange'],
      mauve: ['mauve', 'dusty rose', 'lilac', 'lavender', 'levender'],
      blue: ['blue', 'navy', 'royal']
    };

    const FABRIC_KEYWORDS: Record<string, string[]> = {
      crush: ['crush', 'crushed'],
      fandy: ['fandy'],
      tissue: ['tissue'],
      organza: ['organza'],
      georgette: ['georgette', 'jorget'],
      velvet: ['velvet'],
      satin: ['satin', 'saten'],
      cotton: ['cotton'],
      net: ['net'],
      crape: ['crape', 'crepe', 'moss']
    };

    const WORK_KEYWORDS: Record<string, string[]> = {
      zari: ['zari', 'jari'],
      sequin: ['sequin', 'sequence'],
      scallop: ['scallop'],
      floral: ['floral', 'resham', 'dhaga', 'embroidery', 'flower', 'bootis', 'bootas'],
      mirror: ['mirror', 'abhla'],
      plain: ['plain', 'solid']
    };

    const CHIP_LABELS: Record<string, string> = {
      wine: 'Color: Wine',
      teal: 'Color: Teal',
      rani: 'Color: Rani Pink',
      yellow: 'Color: Haldi',
      ivory: 'Color: Ivory',
      green: 'Color: Emerald',
      gold: 'Color: Gold',
      black: 'Color: Black',
      red: 'Color: Red',
      rust: 'Color: Rust',
      mauve: 'Color: Mauve',
      blue: 'Color: Blue',
      crush: 'Fabric: Crush Silk',
      fandy: 'Fabric: Fandy Silk',
      tissue: 'Fabric: Tissue Silk',
      organza: 'Fabric: Organza',
      georgette: 'Fabric: Georgette',
      velvet: 'Fabric: Velvet',
      satin: 'Fabric: Satin',
      cotton: 'Fabric: Cotton',
      net: 'Fabric: Net',
      crape: 'Fabric: Moss Crape',
      zari: 'Work: Zari',
      sequin: 'Work: Sequin Jaal',
      scallop: 'Work: Scallop',
      floral: 'Work: Floral',
      mirror: 'Work: Mirror',
      plain: 'Work: Plain Solid',
      'under-500': 'Price: < ₹500',
      '500-1000': 'Price: ₹500 - ₹1,000',
      '1000-2000': 'Price: ₹1,000 - ₹2,000',
      'above-2000': 'Price: > ₹2,000',
      'price-asc': 'Sort: Low to High',
      'price-desc': 'Sort: High to Low',
      'newest': 'Sort: Newest',
      'offers': 'Special Offers Only'
    };

    function initProductFilters() {
      const grid = document.getElementById('productGrid') as any;
      if (!grid || grid._filtersBound) return;
      grid._filtersBound = true;

      const tabs = Array.from(document.querySelectorAll('.editorial-tab-btn')) as HTMLElement[];
      const countLabel = document.getElementById('productCountLabel');
      const categoryEmptyMsg = document.getElementById('categoryEmptyMessage');
      const filterEmptyMsg = document.getElementById('filterEmptyMessage');
      const openFilterBtn = document.getElementById('openFilterBtn');
      const closeFilterBtn = document.getElementById('closeFilterBtn');
      const filterDrawer = document.getElementById('filterDrawer');
      const filterBackdrop = document.getElementById('filterBackdrop');
      const drawerLiveCount = document.getElementById('drawerLiveCount');
      const drawerApplyCount = document.getElementById('drawerApplyCount');
      const drawerResetBtn = document.getElementById('drawerResetBtn');
      const drawerApplyBtn = document.getElementById('drawerApplyBtn');
      const emptyResetBtn = document.getElementById('emptyResetBtn');
      const clearAllFiltersBtn = document.getElementById('clearAllFiltersBtn');
      const activeFiltersBar = document.getElementById('activeFiltersBar');
      const activeChipsTrack = document.getElementById('activeChipsTrack');
      const activeFilterBadge = document.getElementById('activeFilterBadge');
      const colorBtns = Array.from(document.querySelectorAll('.color-swatch-btn')) as HTMLElement[];
      const fabricBtns = Array.from(document.querySelectorAll('#fabricChipsGroup .filter-chip-btn')) as HTMLElement[];
      const workBtns = Array.from(document.querySelectorAll('#workChipsGroup .filter-chip-btn')) as HTMLElement[];
      const priceBtns = Array.from(document.querySelectorAll('#priceChipsGroup .filter-chip-btn')) as HTMLElement[];
      const offersCheckbox = document.getElementById('offersOnlyCheckbox') as HTMLInputElement | null;
      const sortRadios = Array.from(document.querySelectorAll('input[name="productSortRadio"]')) as HTMLInputElement[];

      // Section count indicators
      const activeColorCount = document.getElementById('activeColorCount');
      const activeFabricCount = document.getElementById('activeFabricCount');
      const activeWorkCount = document.getElementById('activeWorkCount');
      const activePriceCount = document.getElementById('activePriceCount');

      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
      const cardMeta = cards.map((card, idx) => ({
        card,
        initialIndex: idx,
        cat: (card.getAttribute('data-category') || '').toLowerCase().trim(),
        hasVideo: card.getAttribute('data-has-video') === 'true',
        price: Number(card.getAttribute('data-price') || 0),
        hasOffer: card.getAttribute('data-has-offer') === 'true',
        date: Number(card.getAttribute('data-date') || 0),
        fabric: (card.getAttribute('data-fabric') || '').toLowerCase(),
        colour: (card.getAttribute('data-colour') || '').toLowerCase(),
        work: (card.getAttribute('data-work') || '').toLowerCase(),
        tokens: (card.getAttribute('data-affinity-tokens') || '').toLowerCase()
      }));

      // Internal State
      const state = {
        categoryVal: 'all',
        categoryName: 'All Products',
        sort: 'default',
        colors: new Set<string>(),
        fabrics: new Set<string>(),
        works: new Set<string>(),
        prices: new Set<string>(),
        offersOnly: false,
      };

      // Drawer History Tracking
      let isDrawerInHistory = false;

      function openDrawer(pushHistory = true) {
        const drawer = document.getElementById('filterDrawer');
        const backdrop = document.getElementById('filterBackdrop');
        if (!drawer || !backdrop) return;
        drawer.classList.add('is-open');
        backdrop.classList.add('is-open');
        drawer.setAttribute('aria-hidden', 'false');
        backdrop.setAttribute('aria-hidden', 'false');
        document.body.classList.add('drawer-locked');

        if (pushHistory && !isDrawerInHistory) {
          isDrawerInHistory = true;
          window.history.pushState({ alifFilterDrawer: true }, '', window.location.href);
        }
      }

      function closeDrawer(isUserDismiss = false) {
        const drawer = document.getElementById('filterDrawer');
        const backdrop = document.getElementById('filterBackdrop');
        if (drawer) {
          drawer.classList.remove('is-open');
          drawer.setAttribute('aria-hidden', 'true');
        }
        if (backdrop) {
          backdrop.classList.remove('is-open');
          backdrop.setAttribute('aria-hidden', 'true');
        }
        document.body.classList.remove('drawer-locked');

        if (isUserDismiss && isDrawerInHistory) {
          isDrawerInHistory = false;
          window.history.back();
        } else {
          isDrawerInHistory = false;
        }
      }

      function updateActiveBadge() {
        const count = state.colors.size + state.fabrics.size + state.works.size + state.prices.size + (state.offersOnly ? 1 : 0) + (state.sort !== 'default' ? 1 : 0);
        if (activeFilterBadge) {
          if (count > 0) {
            activeFilterBadge.textContent = String(count);
            activeFilterBadge.style.display = 'inline-flex';
          } else {
            activeFilterBadge.style.display = 'none';
          }
        }
        // Section badges
        if (activeColorCount) {
          activeColorCount.textContent = String(state.colors.size);
          activeColorCount.style.display = state.colors.size > 0 ? 'inline-block' : 'none';
        }
        if (activeFabricCount) {
          activeFabricCount.textContent = String(state.fabrics.size);
          activeFabricCount.style.display = state.fabrics.size > 0 ? 'inline-block' : 'none';
        }
        if (activeWorkCount) {
          activeWorkCount.textContent = String(state.works.size);
          activeWorkCount.style.display = state.works.size > 0 ? 'inline-block' : 'none';
        }
        if (activePriceCount) {
          activePriceCount.textContent = String(state.prices.size);
          activePriceCount.style.display = state.prices.size > 0 ? 'inline-block' : 'none';
        }
      }

      function renderActiveChips() {
        if (!activeChipsTrack || !activeFiltersBar) return;
        const totalFilterCount = state.colors.size + state.fabrics.size + state.works.size + state.prices.size + (state.offersOnly ? 1 : 0) + (state.sort !== 'default' ? 1 : 0);

        if (totalFilterCount === 0) {
          activeFiltersBar.style.display = 'none';
          activeChipsTrack.innerHTML = '';
          return;
        }

        activeFiltersBar.style.display = 'flex';
        activeChipsTrack.innerHTML = '';

        function createChip(type: string, value: string, label: string) {
          const chip = document.createElement('button');
          chip.type = 'button';
          chip.className = 'active-filter-chip';
          chip.setAttribute('data-type', type);
          chip.setAttribute('data-val', value);
          chip.innerHTML = `<span>${label}</span><svg class="chip-remove-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>`;
          chip.addEventListener('click', () => {
            removeFilter(type, value);
          });
          return chip;
        }

        // Sort chip
        if (state.sort !== 'default') {
          activeChipsTrack.appendChild(createChip('sort', state.sort, CHIP_LABELS[state.sort] || state.sort));
        }
        // Color chips
        for (const c of state.colors) {
          activeChipsTrack.appendChild(createChip('color', c, CHIP_LABELS[c] || `Color: ${c}`));
        }
        // Fabric chips
        for (const f of state.fabrics) {
          activeChipsTrack.appendChild(createChip('fabric', f, CHIP_LABELS[f] || `Fabric: ${f}`));
        }
        // Work chips
        for (const w of state.works) {
          activeChipsTrack.appendChild(createChip('work', w, CHIP_LABELS[w] || `Work: ${w}`));
        }
        // Price chips
        for (const p of state.prices) {
          activeChipsTrack.appendChild(createChip('price', p, CHIP_LABELS[p] || `Price: ${p}`));
        }
        // Offers chip
        if (state.offersOnly) {
          activeChipsTrack.appendChild(createChip('offers', 'offers', CHIP_LABELS['offers']));
        }
      }

      function removeFilter(type: string, value: string) {
        if (type === 'sort') {
          state.sort = 'default';
          const defRadio = document.querySelector('input[name="productSortRadio"][value="default"]') as HTMLInputElement;
          if (defRadio) defRadio.checked = true;
        } else if (type === 'color') {
          state.colors.delete(value);
          const btn = colorBtns.find(b => b.getAttribute('data-color') === value);
          if (btn) btn.classList.remove('active');
        } else if (type === 'fabric') {
          state.fabrics.delete(value);
          const btn = fabricBtns.find(b => b.getAttribute('data-fabric') === value);
          if (btn) btn.classList.remove('active');
        } else if (type === 'work') {
          state.works.delete(value);
          const btn = workBtns.find(b => b.getAttribute('data-work') === value);
          if (btn) btn.classList.remove('active');
        } else if (type === 'price') {
          state.prices.delete(value);
          const btn = priceBtns.find(b => b.getAttribute('data-price-range') === value);
          if (btn) btn.classList.remove('active');
        } else if (type === 'offers') {
          state.offersOnly = false;
          if (offersCheckbox) offersCheckbox.checked = false;
        }
        applyFiltersAndSort(true);
      }

      function resetAllDrawerFilters() {
        state.sort = 'default';
        state.colors.clear();
        state.fabrics.clear();
        state.works.clear();
        state.prices.clear();
        state.offersOnly = false;

        colorBtns.forEach(b => b.classList.remove('active'));
        fabricBtns.forEach(b => b.classList.remove('active'));
        workBtns.forEach(b => b.classList.remove('active'));
        priceBtns.forEach(b => b.classList.remove('active'));
        if (offersCheckbox) offersCheckbox.checked = false;
        const defRadio = document.querySelector('input[name="productSortRadio"][value="default"]') as HTMLInputElement;
        if (defRadio) defRadio.checked = true;

        applyFiltersAndSort(true);
      }

      function syncUrlParams(push: boolean = true) {
        const url = new URL(window.location.href);
        // Category
        if (state.categoryVal && state.categoryVal !== 'all') {
          const tabName = state.categoryName.toLowerCase().replace(/[\s_]+/g, '-');
          url.searchParams.set('category', tabName);
        } else {
          url.searchParams.delete('category');
        }
        // Sort
        if (state.sort !== 'default') {
          url.searchParams.set('sort', state.sort);
        } else {
          url.searchParams.delete('sort');
        }
        // Colors
        if (state.colors.size > 0) {
          url.searchParams.set('color', Array.from(state.colors).join(','));
        } else {
          url.searchParams.delete('color');
        }
        // Fabrics
        if (state.fabrics.size > 0) {
          url.searchParams.set('fabric', Array.from(state.fabrics).join(','));
        } else {
          url.searchParams.delete('fabric');
        }
        // Works
        if (state.works.size > 0) {
          url.searchParams.set('work', Array.from(state.works).join(','));
        } else {
          url.searchParams.delete('work');
        }
        // Prices
        if (state.prices.size > 0) {
          url.searchParams.set('price', Array.from(state.prices).join(','));
        } else {
          url.searchParams.delete('price');
        }
        // Offers
        if (state.offersOnly) {
          url.searchParams.set('sale', '1');
        } else {
          url.searchParams.delete('sale');
        }

        const newSearch = url.searchParams.toString() ? '?' + url.searchParams.toString() : '';
        const currentSearch = window.location.search;
        const newUrl = url.pathname + newSearch;

        // If query hasn't changed at all, avoid redundant history pushes
        if (newSearch === currentSearch) {
          return;
        }

        if (push) {
          window.history.pushState({ alifFilter: true, search: newSearch }, '', newUrl);
        } else {
          window.history.replaceState({ alifFilter: true, search: newSearch }, '', newUrl);
        }
      }

      function applyFiltersAndSort(pushHistory: boolean = false) {
        const isAll = state.categoryVal === 'all';
        const isVideoFilter = !isAll && (state.categoryVal === 'video' || state.categoryVal.includes('video') || state.categoryVal.includes('reel') || state.categoryName.toLowerCase().includes('reel'));
        const isCuratedFilter = !isAll && (state.categoryVal.includes('curated') || state.categoryName.toLowerCase().includes('curated'));
        const allowedSet = (!isAll && !isVideoFilter && !isCuratedFilter)
          ? new Set(state.categoryVal.split(',').map(s => s.trim().toLowerCase()))
          : null;

        let visibleCount = 0;

        for (let i = 0; i < cardMeta.length; i++) {
          const m = cardMeta[i];
          // 1. Category check
          let matchCat = false;
          if (isAll) {
            matchCat = true;
          } else if (isVideoFilter) {
            matchCat = m.hasVideo || m.cat === 'reels outfit' || m.cat === 'reel outfits' || m.cat === 'reel outfit';
          } else if (isCuratedFilter) {
            matchCat = (m.cat === 'curated sets' || m.cat === 'curated set' || m.cat === 'curated') && !m.hasVideo;
          } else {
            matchCat = allowedSet !== null && allowedSet.has(m.cat);
          }

          if (!matchCat) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // 2. Color check
          let matchColor = true;
          if (state.colors.size > 0) {
            matchColor = false;
            const fullText = m.colour + ' ' + m.tokens;
            for (const c of state.colors) {
              const kwList = COLOR_KEYWORDS[c] || [c];
              if (kwList.some(k => fullText.includes(k))) {
                matchColor = true;
                break;
              }
            }
          }
          if (!matchColor) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // 3. Fabric check
          let matchFabric = true;
          if (state.fabrics.size > 0) {
            matchFabric = false;
            const fullText = m.fabric + ' ' + m.tokens;
            for (const f of state.fabrics) {
              const kwList = FABRIC_KEYWORDS[f] || [f];
              if (kwList.some(k => fullText.includes(k))) {
                matchFabric = true;
                break;
              }
            }
          }
          if (!matchFabric) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // 4. Work check
          let matchWork = true;
          if (state.works.size > 0) {
            matchWork = false;
            const fullText = m.work + ' ' + m.tokens;
            for (const w of state.works) {
              const kwList = WORK_KEYWORDS[w] || [w];
              if (kwList.some(k => fullText.includes(k))) {
                matchWork = true;
                break;
              }
            }
          }
          if (!matchWork) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // 5. Price check
          let matchPrice = true;
          if (state.prices.size > 0) {
            matchPrice = false;
            for (const pr of state.prices) {
              if (pr === 'under-500' && m.price > 0 && m.price < 500) { matchPrice = true; break; }
              if (pr === '500-1000' && m.price >= 500 && m.price <= 1000) { matchPrice = true; break; }
              if (pr === '1000-2000' && m.price > 1000 && m.price <= 2000) { matchPrice = true; break; }
              if (pr === 'above-2000' && m.price > 2000) { matchPrice = true; break; }
            }
          }
          if (!matchPrice) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // 6. Offers check
          if (state.offersOnly && !m.hasOffer) {
            m.card.classList.add('hidden');
            m.card.style.display = 'none';
            continue;
          }

          // Product matches all active filters!
          m.card.classList.remove('hidden');
          m.card.style.display = '';
          visibleCount++;
        }

        // Sorting
        const sortedMeta = [...cardMeta].sort((a, b) => {
          if (state.sort === 'price-asc') return a.price - b.price;
          if (state.sort === 'price-desc') return b.price - a.price;
          if (state.sort === 'newest') return b.date - a.date;
          return a.initialIndex - b.initialIndex;
        });

        const fragment = document.createDocumentFragment();
        for (const item of sortedMeta) {
          fragment.appendChild(item.card);
        }
        if (categoryEmptyMsg) fragment.appendChild(categoryEmptyMsg);
        if (filterEmptyMsg) fragment.appendChild(filterEmptyMsg);
        grid.appendChild(fragment);

        // Reel videos mode handling
        const isReelsMode = isVideoFilter || state.categoryName.toLowerCase().includes('reel');
        if (isReelsMode) {
          grid.classList.add('mode-reels-outfit');
          grid.setAttribute('data-active-category', 'reel-outfits');
          ensureVideoObserver();
          setTimeout(() => {
            document.querySelectorAll('.product-card:not(.hidden) .product-grid-video').forEach(el => {
              const v = el as HTMLVideoElement;
              const rect = v.getBoundingClientRect();
              if (rect.top < window.innerHeight + 100 && rect.bottom > 0) {
                const src = v.getAttribute('data-src');
                if (src && !v.src) {
                  v.src = src;
                  v.load();
                }
                v.play().catch(() => {});
              }
            });
          }, 50);
        } else {
          grid.classList.remove('mode-reels-outfit');
          grid.setAttribute('data-active-category', state.categoryName.toLowerCase().replace(/[\s_]+/g, '-'));
          document.querySelectorAll('.product-grid-video').forEach(el => {
            const v = el as HTMLVideoElement;
            if (v.src && !v.paused) v.pause();
          });
        }

        // Empty state handling
        const hasDrawerFilters = state.colors.size > 0 || state.fabrics.size > 0 || state.works.size > 0 || state.prices.size > 0 || state.offersOnly;
        if (visibleCount === 0) {
          if (hasDrawerFilters) {
            if (filterEmptyMsg) filterEmptyMsg.style.display = 'block';
            if (categoryEmptyMsg) categoryEmptyMsg.style.display = 'none';
          } else {
            if (filterEmptyMsg) filterEmptyMsg.style.display = 'none';
            if (categoryEmptyMsg) categoryEmptyMsg.style.display = 'block';
          }
        } else {
          if (filterEmptyMsg) filterEmptyMsg.style.display = 'none';
          if (categoryEmptyMsg) categoryEmptyMsg.style.display = 'none';
        }

        // Count labels
        if (countLabel) {
          countLabel.textContent = isAll ? `All Products (${visibleCount})` : `${state.categoryName} (${visibleCount})`;
        }
        if (drawerLiveCount) {
          drawerLiveCount.textContent = `${visibleCount} Products`;
        }
        if (drawerApplyCount) {
          drawerApplyCount.textContent = `(${visibleCount})`;
        }

        updateActiveBadge();
        renderActiveChips();
        syncUrlParams(pushHistory);
      }

      function activateTab(tab: HTMLElement) {
        if (tab.tagName === 'A') return;
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        state.categoryVal = tab.getAttribute('data-filter-values') || 'all';
        state.categoryName = tab.getAttribute('data-category-name') || 'Products';

        applyFiltersAndSort(true);
      }

      // Event Listeners: Category tabs
      tabs.forEach(tab => {
        if (tab.tagName !== 'A') {
          tab.addEventListener('click', () => activateTab(tab));
        }
      });

      // Drawer Open / Close buttons
      openFilterBtn?.addEventListener('click', () => openDrawer(true));
      closeFilterBtn?.addEventListener('click', () => closeDrawer(true));
      filterBackdrop?.addEventListener('click', () => closeDrawer(true));
      drawerApplyBtn?.addEventListener('click', () => {
        closeDrawer(false);
        syncUrlParams(true);
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && filterDrawer?.classList.contains('is-open')) {
          closeDrawer(true);
        }
      });

      // Reset buttons
      drawerResetBtn?.addEventListener('click', resetAllDrawerFilters);
      emptyResetBtn?.addEventListener('click', resetAllDrawerFilters);
      clearAllFiltersBtn?.addEventListener('click', resetAllDrawerFilters);

      // Sort radio listeners
      sortRadios.forEach(radio => {
        radio.addEventListener('change', () => {
          if (radio.checked) {
            state.sort = radio.value;
            applyFiltersAndSort(true);
          }
        });
      });

      // Color swatches listeners
      colorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const color = btn.getAttribute('data-color');
          if (!color) return;
          if (state.colors.has(color)) {
            state.colors.delete(color);
            btn.classList.remove('active');
          } else {
            state.colors.add(color);
            btn.classList.add('active');
          }
          applyFiltersAndSort(true);
        });
      });

      // Fabric chips listeners
      fabricBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const fabric = btn.getAttribute('data-fabric');
          if (!fabric) return;
          if (state.fabrics.has(fabric)) {
            state.fabrics.delete(fabric);
            btn.classList.remove('active');
          } else {
            state.fabrics.add(fabric);
            btn.classList.add('active');
          }
          applyFiltersAndSort(true);
        });
      });

      // Work chips listeners
      workBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const work = btn.getAttribute('data-work');
          if (!work) return;
          if (state.works.has(work)) {
            state.works.delete(work);
            btn.classList.remove('active');
          } else {
            state.works.add(work);
            btn.classList.add('active');
          }
          applyFiltersAndSort(true);
        });
      });

      // Price range chips listeners
      priceBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const range = btn.getAttribute('data-price-range');
          if (!range) return;
          if (state.prices.has(range)) {
            state.prices.delete(range);
            btn.classList.remove('active');
          } else {
            state.prices.add(range);
            btn.classList.add('active');
          }
          applyFiltersAndSort(true);
        });
      });

      // Offers toggle checkbox
      offersCheckbox?.addEventListener('change', () => {
        state.offersOnly = !!offersCheckbox.checked;
        applyFiltersAndSort(true);
      });

      // Unified URL hydration function (used for initial load, popstate, and page swaps)
      function hydrateFromUrl(searchString = window.location.search) {
        const urlParams = new URLSearchParams(searchString);

        // 1. Reset state
        state.sort = 'default';
        state.colors.clear();
        state.fabrics.clear();
        state.works.clear();
        state.prices.clear();
        state.offersOnly = false;

        // Reset UI inputs
        sortRadios.forEach(r => { r.checked = (r.value === 'default'); });
        colorBtns.forEach(b => b.classList.remove('active'));
        fabricBtns.forEach(b => b.classList.remove('active'));
        workBtns.forEach(b => b.classList.remove('active'));
        priceBtns.forEach(b => b.classList.remove('active'));
        if (offersCheckbox) offersCheckbox.checked = false;

        // 2. Hydrate Category
        const catParam = (urlParams.get('category') || '').toLowerCase().trim();
        let matchingTab: HTMLElement | null = null;
        if (catParam && catParam !== 'all') {
          matchingTab = tabs.find(t => {
            if (t.tagName === 'A') return false;
            const vals = (t.getAttribute('data-filter-values') || '').toLowerCase();
            const name = (t.getAttribute('data-category-name') || '').toLowerCase().replace(/[\s_]+/g, '-');
            return vals.split(',').map(v => v.trim()).includes(catParam) || name === catParam || vals.includes(catParam);
          }) || null;
        }
        if (!matchingTab) {
          matchingTab = tabs.find(t => (t.getAttribute('data-filter-values') || '').toLowerCase() === 'all') || tabs[0];
        }

        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        if (matchingTab) {
          matchingTab.classList.add('active');
          matchingTab.setAttribute('aria-selected', 'true');
          state.categoryVal = matchingTab.getAttribute('data-filter-values') || 'all';
          state.categoryName = matchingTab.getAttribute('data-category-name') || 'All Products';
        }

        // 3. Hydrate Sort
        const sortParam = urlParams.get('sort');
        if (sortParam && ['price-asc', 'price-desc', 'newest'].includes(sortParam)) {
          state.sort = sortParam;
          const matchingRadio = sortRadios.find(r => r.value === sortParam);
          if (matchingRadio) matchingRadio.checked = true;
        }

        // 4. Hydrate Colors
        const colorParam = urlParams.get('color');
        if (colorParam) {
          colorParam.split(',').forEach(c => {
            const trimmed = c.trim().toLowerCase();
            if (trimmed) {
              state.colors.add(trimmed);
              const btn = colorBtns.find(b => b.getAttribute('data-color') === trimmed);
              if (btn) btn.classList.add('active');
            }
          });
        }

        // 5. Hydrate Fabrics
        const fabricParam = urlParams.get('fabric');
        if (fabricParam) {
          fabricParam.split(',').forEach(f => {
            const trimmed = f.trim().toLowerCase();
            if (trimmed) {
              state.fabrics.add(trimmed);
              const btn = fabricBtns.find(b => b.getAttribute('data-fabric') === trimmed);
              if (btn) btn.classList.add('active');
            }
          });
        }

        // 6. Hydrate Works
        const workParam = urlParams.get('work');
        if (workParam) {
          workParam.split(',').forEach(w => {
            const trimmed = w.trim().toLowerCase();
            if (trimmed) {
              state.works.add(trimmed);
              const btn = workBtns.find(b => b.getAttribute('data-work') === trimmed);
              if (btn) btn.classList.add('active');
            }
          });
        }

        // 7. Hydrate Prices
        const priceParam = urlParams.get('price');
        if (priceParam) {
          priceParam.split(',').forEach(p => {
            const trimmed = p.trim().toLowerCase();
            if (trimmed) {
              state.prices.add(trimmed);
              const btn = priceBtns.find(b => b.getAttribute('data-price-range') === trimmed);
              if (btn) btn.classList.add('active');
            }
          });
        }

        // 8. Hydrate Offers/Sale
        if (urlParams.get('sale') === '1') {
          state.offersOnly = true;
          if (offersCheckbox) offersCheckbox.checked = true;
        }

        // Apply filters without pushing redundant duplicate history entry
        applyFiltersAndSort(false);
      }

      // Initial run from current URL
      hydrateFromUrl(window.location.search);

      // Expose to window for global popstate listener
      (window as any)._alifHydrateProductFilters = hydrateFromUrl;
    }

    // Delegated click handler on document so button ALWAYS responds immediately
    function globalOpenDrawer() {
      const drawer = document.getElementById('filterDrawer');
      const backdrop = document.getElementById('filterBackdrop');
      if (!drawer || !backdrop) return;
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.classList.add('drawer-locked');

      if (!(window as any)._alifDrawerInHistory) {
        (window as any)._alifDrawerInHistory = true;
        window.history.pushState({ alifFilterDrawer: true }, '', window.location.href);
      }
    }

    function globalCloseDrawer(isUserDismiss = false) {
      const drawer = document.getElementById('filterDrawer');
      const backdrop = document.getElementById('filterBackdrop');
      if (drawer) {
        drawer.classList.remove('is-open');
        drawer.setAttribute('aria-hidden', 'true');
      }
      if (backdrop) {
        backdrop.classList.remove('is-open');
        backdrop.setAttribute('aria-hidden', 'true');
      }
      document.body.classList.remove('drawer-locked');

      if (isUserDismiss && (window as any)._alifDrawerInHistory) {
        (window as any)._alifDrawerInHistory = false;
        window.history.back();
      } else {
        (window as any)._alifDrawerInHistory = false;
      }
    }

    // Global Delegated click and Popstate listeners (attached once)
    if (!(window as any)._alifFilterDelegated) {
      (window as any)._alifFilterDelegated = true;
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        if (target.closest('#openFilterBtn')) {
          e.preventDefault();
          globalOpenDrawer();
        } else if (target.closest('#closeFilterBtn') || target.closest('#filterBackdrop')) {
          globalCloseDrawer(true);
        } else if (target.closest('#drawerApplyBtn')) {
          globalCloseDrawer(false);
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          globalCloseDrawer(true);
        }
      });

      // Browser Back & Forward Popstate Handler
      window.addEventListener('popstate', (e) => {
        const drawer = document.getElementById('filterDrawer');
        const backdrop = document.getElementById('filterBackdrop');
        if (drawer && drawer.classList.contains('is-open')) {
          drawer.classList.remove('is-open');
          if (backdrop) backdrop.classList.remove('is-open');
          document.body.classList.remove('drawer-locked');
          (window as any)._alifDrawerInHistory = false;
          return;
        }

        // Exact one-step back filter state hydration
        if (typeof (window as any)._alifHydrateProductFilters === 'function') {
          (window as any)._alifHydrateProductFilters(window.location.search);
        }
      });
    }

    function initProductsPage() {
      applyAffinityRanking();
      initProductFilters();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductsPage);
    } else {
      initProductsPage();
    }

    document.addEventListener('astro:page-load', initProductsPage);

    document.addEventListener('astro:before-swap', () => {
      if (videoObserver) {
        videoObserver.disconnect();
        videoObserver = null;
      }
      document.querySelectorAll('.product-grid-video').forEach(el => {
        const v = el as HTMLVideoElement;
        if (!v.paused) v.pause();
      });
    });
  </script>
</BaseLayout>

