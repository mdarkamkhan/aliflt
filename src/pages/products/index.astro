---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import categoryFilters from '../../data/categoryFilters.json';
import { getCardImageAttrs } from '../../utils/imagePerf';

const allProducts = await getCollection('products');

// ─── Build-Time Smart Shuffle ────────────────────────────────────────────────
// Goal: category-interleaved order so the grid never clusters identical items.
// A per-build deterministic jitter (based on build timestamp) ensures every
// Netlify deploy produces a meaningfully different base ordering.

// 1. Bucket products by category (newest-first within each bucket via date desc)
const byCategory: Record<string, typeof allProducts> = {};
for (const p of allProducts) {
  const cat = (p.data.category || 'other').toLowerCase();
  if (!byCategory[cat]) byCategory[cat] = [];
  byCategory[cat].push(p);
}

// Sort within each bucket newest → oldest so fresh stock surfaces first
for (const cat of Object.keys(byCategory)) {
  byCategory[cat].sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
}

// 2. Per-build seed so each deploy rotates the starting category
const BUILD_SEED = Date.now();
const catKeys = Object.keys(byCategory).sort(); // stable sort
const startOffset = BUILD_SEED % catKeys.length;
const rotatedCats = [...catKeys.slice(startOffset), ...catKeys.slice(0, startOffset)];

// 3. Round-robin interleave across all categories
const products: typeof allProducts = [];
const queues = rotatedCats.map(k => byCategory[k]);
let hasMore = true;
while (hasMore) {
  hasMore = false;
  for (const queue of queues) {
    if (queue.length > 0) {
      products.push(queue.shift()!);
      hasMore = true;
    }
  }
}

const firstCardAttrs = products.length > 0
  ? getCardImageAttrs(products[0].data.image, '(max-width: 600px) 46vw, (max-width: 1024px) 30vw, 220px')
  : null;
// ─────────────────────────────────────────────────────────────────────────────
---

<BaseLayout 
  title="Our Products" 
  description="Explore our exquisite collection of designer laces, borders, latkans, and boutique fabrics at alif. ladies tailor."
  preloadImage={firstCardAttrs?.src}
  preloadImageSrcset={firstCardAttrs?.srcset}
  preloadImageSizes={firstCardAttrs?.sizes}
>
  <div class="container section fade-in-section products-page-container">

    <!-- Editorial Typography Category Tabs (Zara / Haute Couture Style) -->
    <div class="editorial-tabs-wrapper">
      <div class="editorial-tabs-track" role="tablist" aria-label="Product Categories">
        <button 
          type="button"
          class="editorial-tab-btn active" 
          data-filter-values="all" 
          data-category-name="All Products"
          role="tab"
          aria-selected="true"
        >
          <span class="tab-label">All</span>
        </button>

        {categoryFilters.categories.map((category) => (
          <button 
            type="button"
            class="editorial-tab-btn" 
            data-filter-values={category.values.join(',').toLowerCase()}
            data-category-name={category.name}
            role="tab"
            aria-selected="false"
          >
            <span class="tab-label">{category.name}</span>
          </button>
        ))}

        <button 
          type="button"
          class="editorial-tab-btn" 
          data-filter-values="video,reel-outfits,reel outfits" 
          data-category-name="Reel Outfits"
          role="tab"
          aria-selected="false"
        >
          <span class="tab-label">Reel Outfits</span>
        </button>

        <a 
          href="/reels/" 
          class="editorial-tab-btn reels-direct-link"
          role="tab"
          aria-selected="false"
          title="Watch all 54 atelier video reels"
        >
          <span class="tab-label">Reels</span>
        </a>
      </div>
    </div>

    <!-- Product Status Bar (Live Count & Exclusive Designs) -->
    <div class="product-status-bar" id="productStatusBar">
      <div class="status-left">
        <span class="status-count-label" id="productCountLabel">All Products ({products.length})</span>
      </div>
      <span class="status-brand-tag">EXCLUSIVE DESIGNS</span>
    </div>

    <!-- Product Grid -->
    <div class="product-grid" data-shuffle-type="product" id="productGrid">
      {products.map((item, index) => {
        const { title, price, offer_price, image, category, combo_items } = item.data;
        const catLower = (category || '').toLowerCase();
        const isCuratedSet = catLower === 'curated sets' || catLower === 'curated set' || catLower === 'dress set' || (combo_items && combo_items.length > 0);
        // Affinity tokens baked into HTML so client JS can score without extra fetch
        const affinityTokens = [
          item.data.fabric,
          item.data.colour,
          item.data.work,
          item.data.pattern,
          category,
          ...(item.data.ideal_for ? item.data.ideal_for.split(/[,\/]/) : [])
        ].filter(Boolean).map(t => t.toLowerCase().trim()).join(' ');
        const imgAttrs = getCardImageAttrs(image, '(max-width: 600px) 46vw, (max-width: 1024px) 30vw, 220px');
        return (
          <a href={`/products/${item.id}/`} class="product-card" data-category={catLower} data-has-video={item.data.reel_video ? "true" : "false"} data-is-curated={isCuratedSet ? "true" : "false"} data-affinity-tokens={affinityTokens}>
            <div class="product-card-image-wrapper">
              <img
                {...imgAttrs}
                alt={title}
                width="384"
                height="480"
                loading={index < 4 ? "eager" : "lazy"}
                fetchpriority={index < 2 ? "high" : "auto"}
                decoding="async"
                class="product-card-cover-img"
              />
              {item.data.reel_video && (
                <video 
                  data-src={item.data.reel_video} 
                  loop 
                  muted 
                  playsinline 
                  webkit-playsinline
                  preload="none"
                  class="product-grid-video"
                ></video>
              )}
              {item.data.reel_video && !isCuratedSet && (
                <span class="product-card-video-badge" title="Watch Atelier Reel Video">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  REEL
                </span>
              )}
            </div>

            <div class="product-card-name">
              <div class="product-card-title">{title}</div>

              <div class="product-card-bottom-row">
                {category && (
                  <div class="product-card-category">{category}</div>
                )}

                <div class="product-card-price-wrapper">
                  {offer_price ? (
                    <div class="product-card-price has-offer">
                      <del class="original-price">₹{price}</del>
                      <span class="offer-price">₹{offer_price}</span>
                    </div>
                  ) : (
                    <div class="product-card-price">₹{price}</div>
                  )}
                </div>
              </div>
            </div>
          </a>
        );
      })}

      {products.length === 0 && (
        <p class="empty-gallery-message" style="position:static; transform:none; color:#333; width:100%; text-align:center; padding: 40px 0;">
          Products coming soon.
        </p>
      )}

      <div id="categoryEmptyMessage" style="display: none; width: 100%; text-align: center; padding: 60px 20px; grid-column: 1 / -1;">
        <p style="font-family: var(--font-body); font-size: 1rem; color: #555; margin: 0 0 8px 0; letter-spacing: 0.5px;">New collection arriving soon.</p>
        <p style="font-size: 0.82rem; color: #999; margin: 0;">We are currently curating exclusive designs for this category.</p>
      </div>
    </div>

  </div>

  <script>
    // ─── Client-Side Affinity Ranker ────────────────────────────────────────
    // Reads user's unified affinity profile (shared with reels engine) and
    // re-sorts product cards so items matching the user's taste float to top.
    function applyAffinityRanking() {
      const grid = document.getElementById('productGrid') as any;
      if (!grid || grid._affinityRanked) return;
      grid._affinityRanked = true;

      let affinity: Record<string, number> = {};
      try {
        const reelsAff = JSON.parse(localStorage.getItem('alif_reels_affinity') || '{}');
        const prodAff  = JSON.parse(localStorage.getItem('alif_product_affinity') || '{}');
        affinity = { ...reelsAff };
        for (const [k, v] of Object.entries(prodAff)) {
          affinity[k] = (affinity[k] || 0) + Number(v);
        }
      } catch (_) { return; }

      const totalSignal = Object.values(affinity).reduce((s, v) => s + Math.abs(Number(v)), 0);
      if (totalSignal < 5) return;

      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
      if (!cards.length) return;

      let maxScore = 0;
      const scored = cards.map(card => {
        const tokens = (card.getAttribute('data-affinity-tokens') || '').split(' ');
        let score = 0;
        for (let i = 0; i < tokens.length; i++) {
          const token = tokens[i];
          if (token && affinity[token]) score += Number(affinity[token]);
        }
        if (score > maxScore) maxScore = score;
        return { card, score };
      });

      if (maxScore < 5) return;

      scored.sort((a, b) => b.score - a.score);

      const fragment = document.createDocumentFragment();
      for (const { card } of scored) fragment.appendChild(card);
      grid.querySelectorAll(':scope > :not(.product-card)').forEach((el: Element) => fragment.appendChild(el));
      grid.appendChild(fragment);
    }

    function trackProductView(tokens: string[]) {
      if (!tokens || !tokens.length) return;
      try {
        const aff = JSON.parse(localStorage.getItem('alif_product_affinity') || '{}');
        for (const token of tokens) {
          const k = token.toLowerCase().trim();
          if (!k) continue;
          aff[k] = Math.min(150, (aff[k] || 0) + 5);
        }
        localStorage.setItem('alif_product_affinity', JSON.stringify(aff));
      } catch (_) {}
    }

    if (typeof BroadcastChannel !== 'undefined' && !(window as any)._alifBroadcastBound) {
      (window as any)._alifBroadcastBound = true;
      const ch = new BroadcastChannel('alif_product_signals');
      ch.onmessage = (e) => {
        if (e.data && e.data.type === 'product_view') {
          trackProductView(e.data.tokens);
        }
      };
    }

    let videoObserver: IntersectionObserver | null = null;

    function ensureVideoObserver() {
      if (videoObserver || !('IntersectionObserver' in window)) return;
      videoObserver = new IntersectionObserver((entries) => {
        const grid = document.getElementById('productGrid');
        const isReelsMode = grid && grid.classList.contains('mode-reels-outfit');
        entries.forEach(entry => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting && isReelsMode) {
            const src = video.getAttribute('data-src');
            if (src && !video.src) {
              video.src = src;
              video.load();
            }
            video.play().catch(() => {});
          } else if (video.src && !video.paused) {
            video.pause();
          }
        });
      }, { threshold: 0.25, rootMargin: '100px 0px' });

      document.querySelectorAll('.product-grid-video').forEach(v => videoObserver!.observe(v));
    }

    // Smooth Category Filtering logic with pre-cached card metadata
    function initProductFilters() {
      const grid = document.getElementById('productGrid') as any;
      if (!grid || grid._filtersBound) return;
      grid._filtersBound = true;

      const tabs = document.querySelectorAll('.editorial-tab-btn');
      const cards = Array.from(grid.querySelectorAll('.product-card')) as HTMLElement[];
      const countLabel = document.getElementById('productCountLabel');
      const emptyMsg = document.getElementById('categoryEmptyMessage');

      // Pre-cache category and video flags once to avoid repeated DOM attribute parsing on every filter tap
      const cardMeta = cards.map(card => ({
        card,
        cat: (card.getAttribute('data-category') || '').toLowerCase().trim(),
        hasVideo: card.getAttribute('data-has-video') === 'true'
      }));

      function activateTab(tab: Element) {
        if (tab.tagName === 'A') return;
        tabs.forEach(t => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        const filterVal = tab.getAttribute('data-filter-values') || 'all';
        const catName = tab.getAttribute('data-category-name') || 'Products';
        const isAll = filterVal === 'all';
        const isVideoFilter = !isAll && (filterVal === 'video' || filterVal.includes('video') || filterVal.includes('reel'));
        const allowedSet = (!isAll && !isVideoFilter)
          ? new Set(filterVal.split(',').map(s => s.trim().toLowerCase()))
          : null;

        let visibleCount = 0;
        for (let i = 0; i < cardMeta.length; i++) {
          const { card, cat, hasVideo } = cardMeta[i];
          const match = isAll
            ? true
            : isVideoFilter
              ? hasVideo
              : (allowedSet !== null && allowedSet.has(cat));

          if (match) {
            if (card.classList.contains('hidden')) {
              card.style.display = '';
              card.classList.remove('hidden');
            }
            visibleCount++;
          } else if (!card.classList.contains('hidden')) {
            card.style.display = 'none';
            card.classList.add('hidden');
          }
        }

        const isReelsMode = isVideoFilter || catName.toLowerCase().includes('reel');
        if (isReelsMode) {
          grid.classList.add('mode-reels-outfit');
          grid.setAttribute('data-active-category', 'reel-outfits');
          ensureVideoObserver();
          setTimeout(() => {
            document.querySelectorAll('.product-card:not(.hidden) .product-grid-video').forEach(el => {
              const v = el as HTMLVideoElement;
              const rect = v.getBoundingClientRect();
              if (rect.top < window.innerHeight + 100 && rect.bottom > 0) {
                const src = v.getAttribute('data-src');
                if (src && !v.src) {
                  v.src = src;
                  v.load();
                }
                v.play().catch(() => {});
              }
            });
          }, 50);
        } else {
          grid.classList.remove('mode-reels-outfit');
          grid.setAttribute('data-active-category', catName.toLowerCase().replace(/[\s_]+/g, '-'));
          document.querySelectorAll('.product-grid-video').forEach(el => {
            const v = el as HTMLVideoElement;
            if (v.src && !v.paused) v.pause();
          });
        }

        if (emptyMsg) {
          emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
        }

        if (countLabel) {
          countLabel.textContent = isAll ? `All Products (${visibleCount})` : `${catName} (${visibleCount})`;
        }
      }

      tabs.forEach(tab => {
        if (tab.tagName !== 'A') {
          tab.addEventListener('click', () => activateTab(tab));
        }
      });

      // Handle ?category= query param from homepage Featured Categories
      const urlParams = new URLSearchParams(window.location.search);
      const catParam = (urlParams.get('category') || '').toLowerCase().trim();
      if (catParam) {
        const matchingTab = Array.from(tabs).find(t => {
          const vals = (t.getAttribute('data-filter-values') || '').toLowerCase();
          const name = (t.getAttribute('data-category-name') || '').toLowerCase().replace(/[\s_]+/g, '-');
          return vals.split(',').map(v => v.trim()).includes(catParam) || name === catParam || vals.includes(catParam);
        });
        if (matchingTab) {
          activateTab(matchingTab);
        }
      }
    }

    function initProductsPage() {
      applyAffinityRanking();
      initProductFilters();
    }

    document.addEventListener('astro:page-load', initProductsPage);

    document.addEventListener('astro:before-swap', () => {
      if (videoObserver) {
        videoObserver.disconnect();
        videoObserver = null;
      }
      document.querySelectorAll('.product-grid-video').forEach(el => {
        const v = el as HTMLVideoElement;
        if (!v.paused) v.pause();
      });
    });
  </script>
</BaseLayout>

<style>
  /* --- Editorial Typography Category Tabs (Minimal Luxury Haute Couture) --- */
  .editorial-tabs-wrapper {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    margin: 6px 0 16px 0;
    border-bottom: 2px solid rgba(0, 0, 0, 0.08);
  }
  .editorial-tabs-wrapper::-webkit-scrollbar {
    display: none;
  }
  .editorial-tabs-track {
    display: inline-flex;
    gap: 26px;
    align-items: center;
    padding: 0 4px;
    min-width: 100%;
  }
  .editorial-tab-btn {
    display: inline-flex;
    align-items: center;
    padding: 10px 4px 14px 4px;
    background: transparent;
    border: none;
    outline: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    position: relative;
    font-family: var(--font-body, 'Ubuntu', sans-serif);
    -webkit-tap-highlight-color: transparent;
    text-decoration: none;
  }
  .editorial-tab-btn .tab-label {
    font-family: var(--font-body, 'Ubuntu', sans-serif);
    font-size: 1.05rem;
    font-weight: 400;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: #000000; /* ALL categories highlighted in solid black */
    opacity: 1;
    transition: opacity 0.2s ease;
  }
  .editorial-tab-btn:hover .tab-label {
    color: #000000;
  }
  .editorial-tab-btn.active .tab-label {
    font-weight: 400;
    color: #000000;
  }
  /* Architectural Underline Indicator - ONLY on active tab */
  .editorial-tab-btn::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 3px;
    background: #000000;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .editorial-tab-btn.active::after {
    transform: scaleX(1);
  }

  /* --- Product Status & Counter Bar --- */
  .product-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 6px 4px 14px 4px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    margin-bottom: 18px;
    font-family: var(--font-body, 'Ubuntu', sans-serif);
  }
  .status-left {
    display: flex;
    align-items: center;
  }
  .status-count-label {
    font-size: 0.78rem;
    font-weight: 400;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #111111;
  }
  .status-brand-tag {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #777777;
  }

  /* --- Product Card Enhancements (Option 1: Category Left, Price Right) --- */
  .product-card {
    content-visibility: auto;
    contain-intrinsic-size: auto 260px;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                opacity 0.25s ease !important;
  }
  .product-card.hidden {
    display: none !important;
  }
  /* Default: Cover image is visible, video is hidden */
  .product-grid-video {
    display: none !important;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 2;
  }
  .product-card-cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Reel Outfits Mode: Show actual video reel as the cover */
  .product-grid.mode-reels-outfit .product-grid-video {
    display: block !important;
  }
  .product-grid.mode-reels-outfit .product-card-video-badge {
    display: none !important;
  }

  /* Curated Sets category: NEVER show the reel badge */
  .product-card[data-is-curated="true"] .product-card-video-badge,
  .product-grid[data-active-category*="curated"] .product-card-video-badge {
    display: none !important;
  }

  .product-card-video-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-family: var(--font-body, 'Ubuntu', sans-serif);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 3px 8px;
    border-radius: 20px;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
  }
  .product-card-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    margin-top: 5px;
    width: 100%;
  }
  .product-card-category {
    font-weight: 500;
    font-family: var(--font-body, 'Ubuntu', sans-serif);
    font-size: 0.68rem;
    color: #888888;
    margin-top: 0;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .product-card-price-wrapper {
    margin-top: 0;
    margin-left: auto;
    flex-shrink: 0;
    text-align: right;
  }
  .product-card-price {
    font-weight: 400;
    font-family: var(--font-body, 'Ubuntu', sans-serif);
    font-size: 0.95rem;
    color: var(--text-color, #111111);
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 5px;
  }
  .product-card-price.has-offer .original-price {
    font-size: 0.78rem;
    color: #999999;
    text-decoration: line-through;
    font-weight: 400;
  }
  .product-card-price.has-offer .offer-price {
    font-size: 0.95rem;
    font-weight: 500;
    color: #111111;
  }

  @media (max-width: 600px) {
    .editorial-tabs-track {
      gap: 18px;
    }
    .editorial-tab-btn {
      padding: 8px 3px 12px 3px;
    }
    .editorial-tab-btn .tab-label {
      font-size: 0.96rem; /* Clean, bold, easily readable on mobile */
      letter-spacing: 0.6px;
    }
    .product-status-bar {
      margin-bottom: 14px;
      padding-bottom: 10px;
    }
    .status-count-label {
      font-size: 0.74rem;
    }
    .product-card-bottom-row {
      margin-top: 4px;
    }
    .product-card-category {
      font-size: 0.65rem;
    }
    .product-card-price {
      font-size: 0.88rem;
    }
    .product-card-price.has-offer .offer-price {
      font-size: 0.88rem;
    }
    .product-card-price.has-offer .original-price {
      font-size: 0.74rem;
    }
  }
</style>
