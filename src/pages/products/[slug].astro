---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const productsMap = new Map(products.map((p) => [p.id, p]));

  // ─── Multi-Attribute Similarity Scorer ───────────────────────────────────
  // Tokenises a string field into lowercase word tokens for overlap scoring
  function tokenise(str = '') {
    return str.toLowerCase().replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter(Boolean);
  }

  // Jaccard-like overlap: shared tokens / (union tokens)
  function tokenOverlap(a = '', b = '') {
    const ta = new Set(tokenise(a));
    const tb = new Set(tokenise(b));
    if (!ta.size && !tb.size) return 0;
    let shared = 0;
    ta.forEach((t) => { if (tb.has(t)) shared++; });
    return shared / Math.max(ta.size, tb.size, 1);
  }

  // Price bucket: log-scaled so ₹80 vs ₹100 is not same as ₹80 vs ₹800
  function priceBucket(price) {
    const p = Number(price) || 0;
    if (p <= 0) return 0;
    return Math.floor(Math.log10(p + 1) * 10);
  }

  /**
   * Score how similar candidate `c` is to the current entry `e`.
   *
   * Weights (total max ≈ 120):
   *   fabric        30  – highest signal for fabric store
   *   category      20  – same category = strong indicator
   *   colour        20  – colour-family harmony
   *   ideal_for     15  – same occasion/garment end-use
   *   work          15  – embroidery / print / plain technique
   *   pattern       10  – solid / floral / geometric motif
   *   price          10  – similar price bracket
   */
  function scoreProduct(e, c) {
    let score = 0;
    const ed = e.data;
    const cd = c.data;

    // 1. Fabric match (30 pts)
    score += tokenOverlap(ed.fabric, cd.fabric) * 30;

    // 2. Category match (20 pts)
    const ec = (ed.category || '').toLowerCase();
    const cc = (cd.category || '').toLowerCase();
    if (ec && cc && ec === cc) score += 20;

    // 3. Colour family overlap (20 pts)
    score += tokenOverlap(ed.colour, cd.colour) * 20;

    // 4. ideal_for / occasion overlap (15 pts)
    score += tokenOverlap(ed.ideal_for, cd.ideal_for) * 15;

    // 5. Work / technique overlap (15 pts)
    score += tokenOverlap(ed.work, cd.work) * 15;

    // 6. Pattern overlap (10 pts)
    score += tokenOverlap(ed.pattern, cd.pattern) * 10;

    // 7. Price proximity (10 pts — max when identical bucket)
    const ep = priceBucket(ed.offer_price ?? ed.price);
    const cp = priceBucket(cd.offer_price ?? cd.price);
    const priceDiff = Math.abs(ep - cp);
    score += Math.max(0, 10 - priceDiff * 2);

    return score;
  }
  // ─────────────────────────────────────────────────────────────────────────

  return products.map((entry) => {
    const currentCategory = (entry.data.category || '').toLowerCase();
    const isEntryCombo = currentCategory === 'curated sets' || currentCategory === 'curated set' || currentCategory === 'dress set' || (entry.data.combo_products && entry.data.combo_products.length > 0) || (entry.data.combo_items && entry.data.combo_items.length > 0);

    let similar = [];
    let ymal = [];

    const COMBO_CATS = new Set(['curated sets', 'curated set', 'dress set']);

    if (isEntryCombo) {
      // Combo: only other combos, scored by colour/occasion overlap
      similar = products
        .filter((p) => {
          const c = (p.data.category || '').toLowerCase();
          return p.id !== entry.id && (COMBO_CATS.has(c) || (p.data.combo_products && p.data.combo_products.length > 0));
        })
        .map((p) => ({ p, score: scoreProduct(entry, p) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 10)
        .map(({ p }) => p);
      ymal = [];
    } else {
      // Similar: same category, ranked by multi-attribute score
      similar = products
        .filter((p) => {
          const c = (p.data.category || '').toLowerCase();
          return p.id !== entry.id && c === currentCategory && !COMBO_CATS.has(c);
        })
        .map((p) => ({ p, score: scoreProduct(entry, p) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)
        .map(({ p }) => p);

      // YMAL: cross-category, but ranked by highest attribute overlap
      // (fabric/occasion/work similarity even across categories)
      ymal = products
        .filter((p) => {
          const c = (p.data.category || '').toLowerCase();
          return p.id !== entry.id && c !== currentCategory && !COMBO_CATS.has(c);
        })
        .map((p) => ({ p, score: scoreProduct(entry, p) }))
        .sort((a, b) => b.score - a.score)
        .slice(0, 8)
        .map(({ p }) => p);
    }

    // Resolve combo actual products if present
    const comboProductRaw = entry.data.combo_products || [];
    let resolvedComboItems = [];

    if (comboProductRaw.length > 0) {
      resolvedComboItems = comboProductRaw
        .map((item) => {
          const pid = typeof item === 'string' ? item : (item && (item.id || item.slug));
          const meters = (typeof item === 'object' && item && item.meters) ? Number(item.meters) : 1;
          const unit = (typeof item === 'object' && item && item.unit) ? item.unit : 'Meter';
          const p = productsMap.get(pid);
          if (!p) return null;

          const baseOfferOrPrice = Number(p.data.offer_price || p.data.price || 0);
          const calculatedFinalPrice = Math.round(baseOfferOrPrice * meters);
          const calculatedBasePrice = Math.round(Number(p.data.price || 0) * meters);

          let displaySize = p.data.size || '';
          if (meters !== 1) {
            displaySize = `${meters} ${unit}${meters > 1 ? 's' : ''}`;
          }

          return {
            id: p.id,
            title: p.data.title,
            image: p.data.image || '/icons/icon-512x512.png',
            price: calculatedBasePrice,
            offer_price: p.data.offer_price ? calculatedFinalPrice : null,
            final_price: calculatedFinalPrice,
            meters: meters,
            unit: unit,
            category: p.data.category || 'Matching Piece',
            description: p.data.description || '',
            fabric: p.data.fabric || '',
            size: displaySize,
            colour: p.data.colour || '',
            work: p.data.work || '',
            pattern: p.data.pattern || '',
            ideal_for: p.data.ideal_for || '',
            delivery_charges: p.data.delivery_charges || 'Free',
            return_policy: p.data.return_policy || 'NO',
            url: `/products/${p.id}/`
          };
        })
        .filter(Boolean);
    } else if (entry.data.combo_items && entry.data.combo_items.length > 0) {

      resolvedComboItems = entry.data.combo_items.map((ci) => {
        const matched = products.find((p) => p.data.title && p.data.title.toLowerCase().trim() === (ci.name || '').toLowerCase().trim());
        if (matched) {
          return {
            id: matched.id,
            title: matched.data.title,
            image: matched.data.image || ci.image,
            price: matched.data.price,
            offer_price: matched.data.offer_price,
            final_price: matched.data.offer_price || matched.data.price,
            category: matched.data.category || 'Matching Piece',
            description: matched.data.description || '',
            fabric: matched.data.fabric || '',
            size: matched.data.size || '',
            colour: matched.data.colour || '',
            work: matched.data.work || '',
            pattern: matched.data.pattern || '',
            ideal_for: matched.data.ideal_for || '',
            delivery_charges: matched.data.delivery_charges || 'Free',
            return_policy: matched.data.return_policy || 'NO',
            url: `/products/${matched.id}/`
          };
        }
        return {
          id: '',
          title: ci.name,
          image: ci.image,
          price: entry.data.offer_price || entry.data.price,
          offer_price: null,
          final_price: entry.data.offer_price || entry.data.price,
          category: 'Matching Piece',
          description: `Coordinated component matching ${entry.data.title}.`,
          fabric: entry.data.fabric || '',
          size: 'Standard',
          colour: entry.data.colour || '',
          work: entry.data.work || '',
          pattern: entry.data.pattern || '',
          ideal_for: entry.data.ideal_for || '',
          delivery_charges: 'Free',
          return_policy: 'NO',
          url: ''
        };
      });
    }

    return {
      params: { slug: entry.id },
      props: { product: entry, similar, ymal, resolvedComboItems },
    };
  });
}

const { product, similar = [], ymal = [], resolvedComboItems = [] } = Astro.props;
const {
  title,
  price,
  offer_price,
  image,
  category,
  description,
  size,
  colour,
  fabric,
  pattern,
  ideal_for,
  work,
  delivery_charges = "Free",
  return_policy = "No",
  reel_video,
  product_code
} = product.data;

const finalPrice = offer_price || price;
const discountPercent = offer_price && price ? Math.round(((Number(price) - Number(offer_price)) * 100) / Number(price)) : null;

const itemCode = product_code || `ALIF-${product.id.replace(/[^a-zA-Z0-9]/g, '-').toUpperCase()}`;

const catLower = (category || '').toLowerCase();
const isCombo = (catLower === 'curated sets' || catLower === 'curated set' || catLower === 'dress set' || (resolvedComboItems && resolvedComboItems.length > 0));

const comboCutsSummary = (isCombo && resolvedComboItems.length > 0)
  ? resolvedComboItems.map(i => `${i.title} (${i.size || `${i.meters}m`})`).join(' + ')
  : '';

const wappOrderText = (isCombo && comboCutsSummary)
  ? `Hello alif., I want to purchase Curated Set '${title}' [Code: ${itemCode}] (Price: ₹${finalPrice}). Includes: ${comboCutsSummary}.`
  : `Hello alif., I want to purchase '${title}' [Code: ${itemCode}] (Price: ₹${finalPrice}).`;
const wappOrderLink = `https://wa.me/7250470009?text=${encodeURIComponent(wappOrderText)}`;

const comboPayload = isCombo ? {
  defaultSet: {
    id: product.id,
    title: title,
    price: price,
    offer_price: offer_price,
    final_price: finalPrice,
    image: image || '/icons/icon-512x512.png',
    videoSrc: reel_video || null,
    description: description || '',
    category: category || 'Curated Sets',
    wappOrderLink: wappOrderLink,
    specs: {
      product_code: itemCode,
      size: size || comboCutsSummary || 'Curated Ensemble',
      colour: colour || '',
      fabric: fabric || '',
      pattern: pattern || '',
      ideal_for: ideal_for || '',
      work: work || '',
      delivery_charges: delivery_charges || 'Free',
      return_policy: return_policy || 'No'
    }
  },
  items: resolvedComboItems.map((item) => ({
    id: item.id,
    title: item.title,
    price: item.price,
    offer_price: item.offer_price,
    final_price: item.final_price,
    image: item.image,
    category: item.category,
    description: item.description,
    url: item.url,
    wappOrderLink: `https://wa.me/7250470009?text=${encodeURIComponent(`Hello alif., I want to purchase '${item.title}' ${item.size ? `(${item.size})` : ''} (Price: ₹${item.final_price}).`)}`,
    specs: {
      size: item.size || '',
      colour: item.colour || '',
      fabric: item.fabric || '',
      pattern: item.pattern || '',
      ideal_for: item.ideal_for || '',
      work: item.work || '',
      delivery_charges: item.delivery_charges || 'Free',
      return_policy: item.return_policy || 'NO'
    }
  }))
} : null;

---

<BaseLayout 
  title={title} 
  description={description || `${title} available at alif. ladies tailor, Sahibganj.`}
  image={image}
  preloadImage={image}
>
  <div class="container section">
    <div class="product-detail-grid">

      <!-- Left Column: Main Image Card & Combo Cards Directly Under It -->
      <div class="product-detail-image">
        <div class="swapper-container product-swapper" id="mainMediaContainer">
          {reel_video ? (
            <video 
              id="comboMainVideo"
              class="hidden"
              src={reel_video} 
              poster={image}
              loop 
              muted 
              playsinline 
              webkit-playsinline
            ></video>
          ) : null}
          <img 
            id="comboMainImage"
            class="active"
            src={image || '/icons/icon-512x512.png'} 
            alt={title} 
          />
          {reel_video && (
            <button 
              id="toggleReelMediaBtn" 
              type="button" 
              class="reel-media-toggle-pill"
              data-mode="cover"
              title="Switch between fabric cover and outfit video"
              aria-label="Switch between fabric cover and outfit video"
            >
              <span class="pill-media-state state-to-video">
                <svg class="pill-svg icon-play" viewBox="0 0 24 24" width="12" height="12" fill="currentColor">
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <span class="pill-text">Watch Video</span>
              </span>
              <span class="pill-media-state state-to-cover">
                <svg class="pill-svg icon-fabric" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2"/>
                  <path d="M3 15l5-5 4 4 4-4 5 5"/>
                </svg>
                <span class="pill-text">View Cover</span>
              </span>
            </button>
          )}
          {isCombo && (
            <button 
              id="resetToSetBtn" 
              type="button" 
              class="reset-to-set-pill" 
              style="display: none;"
              title="Back to Full Curated Look"
            >
              <svg class="pill-svg" viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
              </svg>
              <span class="pill-text">Full Set Look</span>
            </button>
          )}
        </div>

        <!-- Combo Cards Tray: Directly Under The Image Card (Zara Complete The Look) -->
        {isCombo && resolvedComboItems && resolvedComboItems.length > 0 && (
          <div class="combo-interactive-section">
            <div class="combo-interactive-header">
              <div class="combo-header-left">
                <span class="combo-interactive-label">COMPLETE THE LOOK</span>
                <span class="combo-items-count">({resolvedComboItems.length + 1} PIECES)</span>
              </div>
              <span class="combo-interactive-hint">TAP TO PREVIEW</span>
            </div>
            
            <div class="combo-horizontal-scroll-container">
              <!-- Full Outfit Look Card -->
              <button 
                type="button" 
                class="combo-interactive-card active" 
                data-item-type="full-set"
                id="card-full-set"
              >
                <div class="combo-card-thumb">
                  <img src={image || '/icons/icon-512x512.png'} alt="Full Look" />
                </div>
                <div class="combo-card-body">
                  <span class="combo-card-category">Complete Set</span>
                  <h4 class="combo-card-heading">Full Ensemble</h4>
                  <span class="combo-card-cost">₹{finalPrice}</span>
                </div>
              </button>

              <!-- Single Product Cards -->
              {resolvedComboItems.map((ci, idx) => (
                <button 
                  type="button" 
                  class="combo-interactive-card" 
                  data-item-type="single"
                  data-item-index={idx}
                  id={`card-item-${idx}`}
                >
                  <div class="combo-card-thumb">
                    <img src={ci.image} alt={ci.title} loading="lazy" />
                  </div>
                  <div class="combo-card-body">
                    <span class="combo-card-category">{ci.category || 'Piece'}</span>
                    <h4 class="combo-card-heading" title={ci.title}>{ci.title}</h4>
                    <div class="combo-card-meta-row">
                      <span class="combo-card-cost">₹{ci.final_price}</span>
                      {ci.size && <span class="combo-card-cut-badge">{ci.size}</span>}
                    </div>
                  </div>
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right Column: Product Details & Clean Main Action Buttons -->
      <div class="product-detail-info">
        <div class="product-header-block">
          <span id="previewModeBadge" class="preview-mode-pill" style="display: none;">
            • Inspecting Piece
          </span>
          <div class="product-code-badge" id="displayProductCodeBadge" style="font-family: var(--font-body); font-size: 0.75rem; color: #777; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 8px; font-weight: 500;">
            REF: <span id="displayProductCodeText">{itemCode}</span>
          </div>
          <h1 class="product-detail-title" id="displayTitle">{title}</h1>
        </div>

        <!-- Dynamic Price Display (Zara Minimalist Haute Couture) -->
        <div id="priceSectionWrapper" class="price-section-wrapper">
          {offer_price ? (
            <div class="product-detail-price has-offer">
              <span class="offer-price" id="displayOfferPrice">₹{offer_price}</span>
              <del class="original-price" id="displayOriginalPrice">₹{price}</del> 
            </div>
          ) : (
            <div class="product-detail-price" id="displayStandardPrice">
              <span class="standard-price">₹{price}</span>
            </div>
          )}
        </div>

        <div class="product-delivery-promo">
          Free delivery on orders above ₹199 (within Sahibganj)
        </div>

        <!-- Clean, Standard Action Buttons (No clunky full text) -->
        <div class="product-detail-actions" id="productDetailActions">
          <button 
            type="button"
            class="btn-cart" 
            id="addToCartBtn"
            data-product-id={product.id}
            data-title={title}
            data-price={finalPrice}
            data-image={image}
            data-code={itemCode}
          >
            Add to Cart
          </button>

          <button 
            type="button"
            class="btn-buy" 
            id="buyWhatsAppBtn"
            data-wapp-url={wappOrderLink}
          >
            Buy Now on WhatsApp
          </button>
        </div>



        <!-- Integrated Atelier Accordions -->
        <div class="product-accordion-container">
          {description && (
            <details class="accordion-item" open>
              <summary class="accordion-summary">
                <h3 class="accordion-heading">Description & Atelier Notes</h3>
                <span class="accordion-toggle-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="accordion-content">
                <p class="accordion-description-text" id="displayDescriptionText">{description}</p>
              </div>
            </details>
          )}

          <details class="accordion-item" open>
            <summary class="accordion-summary">
              <h3 class="accordion-heading">Composition & Specifications</h3>
              <span class="accordion-toggle-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            <div class="accordion-content">
              <div class="spec-row-wrapper" id="displaySpecsWrapper">
                <div class="spec-row"><span class="spec-label">Product Code</span><span class="spec-value" id="specProductCode">{itemCode}</span></div>
                {size && <div class="spec-row"><span class="spec-label">Size / Cut</span><span class="spec-value">{size}</span></div>}
                {colour && <div class="spec-row"><span class="spec-label">Colour</span><span class="spec-value">{colour}</span></div>}
                {fabric && <div class="spec-row"><span class="spec-label">Fabric / Material</span><span class="spec-value">{fabric}</span></div>}
                {pattern && <div class="spec-row"><span class="spec-label">Pattern</span><span class="spec-value">{pattern}</span></div>}
                {ideal_for && <div class="spec-row"><span class="spec-label">Ideal For</span><span class="spec-value">{ideal_for}</span></div>}
                {work && <div class="spec-row"><span class="spec-label">Craft & Work</span><span class="spec-value">{work}</span></div>}
                <div class="spec-row"><span class="spec-label">Delivery Charges</span><span class="spec-value">{delivery_charges}</span></div>
                <div class="spec-row"><span class="spec-label">Return Policy</span><span class="spec-value">{return_policy}</span></div>
              </div>
            </div>
          </details>
        </div>

      </div>

    </div>
  </div>

  {similar && similar.length > 0 && (
    <section class="luxury-recommendations-section" id="similar-items-section">
      <div class="luxury-section-header">
        <h3 class="luxury-section-title">
          {isCombo ? 'Similar Combo Sets' : 'Similar Items'}
        </h3>
        <span class="luxury-section-divider"></span>
      </div>

      <div class="luxury-carousel-track" id="similar-items-container">
        {similar.map((item) => {
          const cLower = (item.data.category || '').toLowerCase();
          const itemIsCombo = cLower === 'curated sets' || cLower === 'curated set' || cLower === 'dress set' || (item.data.combo_products && item.data.combo_products.length > 0) || (item.data.combo_items && item.data.combo_items.length > 0);
          const itemFinalPrice = item.data.offer_price || item.data.price;
          return (
            <a href={`/products/${item.id}/`} class="luxury-product-card">
              <div class="luxury-card-media">
                {itemIsCombo && item.data.reel_video ? (
                  <>
                    <video 
                      src={item.data.reel_video} 
                      poster={item.data.image}
                      loop 
                      muted 
                      playsinline 
                      webkit-playsinline
                      preload="none"
                    ></video>
                    <span class="luxury-card-combo-badge">Full Set</span>
                  </>
                ) : (
                  <>
                    <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title} loading="lazy" />
                    {itemIsCombo && <span class="luxury-card-combo-badge">Full Set</span>}
                  </>
                )}
              </div>
              <div class="luxury-card-body">
                <span class="luxury-card-category">{item.data.category || 'Atelier'}</span>
                <h4 class="luxury-card-title" title={item.data.title}>{item.data.title}</h4>
                <div class="luxury-card-pricing">
                  <span class="luxury-price-current">₹{itemFinalPrice}</span>
                  {item.data.offer_price && item.data.price && (
                    <del class="luxury-price-original">₹{item.data.price}</del>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  {ymal && ymal.length > 0 && (
    <section class="luxury-recommendations-section ymal-variant" id="ymal-section">
      <div class="luxury-section-header">
        <h3 class="luxury-section-title">You May Also Like</h3>
        <span class="luxury-section-divider"></span>
      </div>

      <div class="luxury-carousel-track" id="ymal-container">
        {ymal.map((item) => {
          const itemFinalPrice = item.data.offer_price || item.data.price;
          return (
            <a href={`/products/${item.id}/`} class="luxury-product-card">
              <div class="luxury-card-media">
                <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title} loading="lazy" />
              </div>
              <div class="luxury-card-body">
                <span class="luxury-card-category">{item.data.category || 'Atelier'}</span>
                <h4 class="luxury-card-title" title={item.data.title}>{item.data.title}</h4>
                <div class="luxury-card-pricing">
                  <span class="luxury-price-current">₹{itemFinalPrice}</span>
                  {item.data.offer_price && item.data.price && (
                    <del class="luxury-price-original">₹{item.data.price}</del>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Combo Purchase Selection Bottom Sheet Modal -->
  {isCombo && (
    <div id="comboSelectionModal" class="combo-modal-overlay" style="display: none;">
      <div class="combo-modal-sheet">
        <div class="combo-modal-drag-handle" aria-hidden="true"></div>

        <div class="combo-modal-header">
          <div>
            <h3 class="combo-modal-title">Select Items to Purchase</h3>
            <p class="combo-modal-subtitle">Choose the complete bundle or customize specific pieces</p>
          </div>
          <button type="button" id="closeComboModalBtn" class="combo-modal-close" aria-label="Close">✕</button>
        </div>

        <div class="combo-modal-body">
          <!-- Option A: Complete Set Bundle -->
          <div class="bundle-option-card" id="bundleOptionCard">
            <label class="bundle-option-label">
              <input type="radio" name="combo_purchase_type" id="radioCompleteSet" value="complete-set" checked />
              <div class="bundle-option-content">
                <div class="bundle-badge-row">
                  <span class="bundle-badge">★ COMPLETE SET (BEST VALUE)</span>
                </div>
                <div class="bundle-title-row">
                  <span class="bundle-name">{title}</span>
                  <span class="bundle-price">₹{finalPrice}</span>
                </div>
                <p class="bundle-desc">Includes all {resolvedComboItems.length} matching pieces curated together.</p>
              </div>
            </label>
          </div>

          <div class="combo-modal-divider">
            <span>OR PICK SPECIFIC PIECES</span>
          </div>

          <!-- Option B: Individual Pieces Checklist -->
          <div class="custom-pieces-list" id="customPiecesList">
            {resolvedComboItems.map((ci, idx) => (
              <label class="custom-piece-item" id={`pieceItemRow-${idx}`}>
                <input 
                  type="checkbox" 
                  class="piece-checkbox" 
                  data-index={idx}
                  data-id={ci.id}
                  data-title={ci.title}
                  data-price={ci.final_price}
                  data-image={ci.image}
                  data-url={ci.url}
                />
                <div class="piece-thumb">
                  <img src={ci.image} alt={ci.title} loading="lazy" />
                </div>
                <div class="piece-info">
                  <span class="piece-cat">{ci.category || 'PIECE'}{ci.size ? ` • ${ci.size}` : ''}</span>
                  <span class="piece-title">{ci.title}</span>
                </div>
                <div class="piece-price">
                  ₹{ci.final_price}
                </div>
              </label>
            ))}
          </div>
        </div>

        <!-- Modal Footer with Real-Time Total & Action -->
        <div class="combo-modal-footer">
          <div class="combo-modal-total-row">
            <span class="total-label" id="modalSummaryLabel">Complete Set Selected</span>
            <span class="total-value" id="modalTotalPrice">₹{finalPrice}</span>
          </div>

          <button type="button" id="modalConfirmBtn" class="combo-modal-confirm-btn">
            Confirm & Proceed
          </button>
        </div>
      </div>
    </div>
  )}

  <!-- Sticky Mobile Quick-Buy Bar (Luxury Fashion Standard) -->
  <aside class="sticky-mobile-buy-bar visible" id="stickyMobileBuyBar" aria-label="Quick Purchase Bar">
    <div class="sticky-bar-inner">
      <div class="sticky-bar-product">
        <img 
          id="stickyThumb" 
          src={image || '/icons/icon-512x512.png'} 
          alt={title} 
          class="sticky-thumb-img" 
        />
        <div class="sticky-product-meta">
          <span class="sticky-product-title" id="stickyTitle">{title}</span>
          <span class="sticky-product-price" id="stickyPrice">₹{finalPrice}</span>
        </div>
      </div>

      <div class="sticky-bar-actions">
        <button 
          type="button" 
          class="sticky-btn-cart" 
          id="stickyAddToCartBtn"
          aria-label="Add to Bag"
          title="Add to Bag"
        >
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
        </button>
        <button 
          type="button" 
          class="sticky-btn-buy" 
          id="stickyBuyNowBtn"
          aria-label="Buy Now on WhatsApp"
        >
          Buy Now
        </button>
      </div>
    </div>
  </aside>

  {comboPayload && (
    <script id="combo-data" type="application/json" set:html={JSON.stringify(comboPayload)} />
  )}

  <script is:inline>
    // Combo Data & Switcher Logic
    function initProductActions() {
      const comboDataEl = document.getElementById('combo-data');
      if (comboDataEl) {
        try {
          const { defaultSet, items } = JSON.parse(comboDataEl.textContent);

        const mainVideo = document.getElementById('comboMainVideo');
        const mainImage = document.getElementById('comboMainImage');
        const toggleReelBtn = document.getElementById('toggleReelMediaBtn');
        const resetBtn = document.getElementById('resetToSetBtn');
        const displayTitle = document.getElementById('displayTitle');
        const previewBadge = document.getElementById('previewModeBadge');
        const priceWrapper = document.getElementById('priceSectionWrapper');
        const addCartBtn = document.getElementById('addToCartBtn');
        const buyWappBtn = document.getElementById('buyWhatsAppBtn');
        const descText = document.getElementById('displayDescriptionText');
        const specsWrapper = document.getElementById('displaySpecsWrapper');

        // Modal Elements
        const modal = document.getElementById('comboSelectionModal');
        const closeModalBtn = document.getElementById('closeComboModalBtn');
        const radioCompleteSet = document.getElementById('radioCompleteSet');
        const bundleOptionCard = document.getElementById('bundleOptionCard');
        const pieceCheckboxes = document.querySelectorAll('.piece-checkbox');
        const modalSummaryLabel = document.getElementById('modalSummaryLabel');
        const modalTotalPrice = document.getElementById('modalTotalPrice');
        const modalConfirmBtn = document.getElementById('modalConfirmBtn');

        let currentActiveItemIndex = -1; // -1 means Full Set, 0..N means single item
        let currentModalMode = 'cart'; // 'cart' or 'whatsapp'

        function renderPrice(price, offerPrice) {
          if (offerPrice && Number(offerPrice) < Number(price)) {
            return `
              <div class="product-detail-price has-offer">
                <span class="offer-price">₹${offerPrice}</span>
                <del class="original-price">₹${price}</del> 
              </div>
            `;
          }
          return `<div class="product-detail-price"><span class="standard-price">₹${price || offerPrice}</span></div>`;
        }

        function renderSpecs(specs) {
          if (!specsWrapper || !specs) return;
          const fields = [
            { label: 'Product Code', val: specs.product_code },
            { label: 'Size / Cut', val: specs.size },
            { label: 'Colour', val: specs.colour },
            { label: 'Fabric / Material', val: specs.fabric },
            { label: 'Pattern', val: specs.pattern },
            { label: 'Ideal For', val: specs.ideal_for },
            { label: 'Craft & Work', val: specs.work },
            { label: 'Delivery Charges', val: specs.delivery_charges },
            { label: 'Return Policy', val: specs.return_policy },
          ];
          let html = '';
          fields.forEach(f => {
            if (f.val) {
              html += `<div class="spec-row"><span class="spec-label">${f.label}</span><span class="spec-value">${f.val}</span></div>`;
            }
          });
          specsWrapper.innerHTML = html;
        }

        function updateStickyBarData(data) {
          const stickyThumb = document.getElementById('stickyThumb');
          const stickyTitle = document.getElementById('stickyTitle');
          const stickyPrice = document.getElementById('stickyPrice');

          if (stickyThumb && data.image) {
            stickyThumb.src = data.image;
            stickyThumb.alt = data.title;
          }
          if (stickyTitle && data.title) {
            stickyTitle.innerText = data.title;
          }
          if (stickyPrice && data.final_price) {
            stickyPrice.innerText = `₹${data.final_price}`;
          }
        }

        function switchToFullSet() {
          currentActiveItemIndex = -1;

          if (mainVideo) {
            mainVideo.pause();
            mainVideo.classList.remove('active');
            mainVideo.classList.add('hidden');
          }
          if (mainImage) {
            mainImage.src = defaultSet.image;
            mainImage.classList.remove('hidden');
            mainImage.classList.add('active');
          }
          if (toggleReelBtn) {
            toggleReelBtn.classList.remove('hidden-pill');
            toggleReelBtn.style.display = defaultSet.videoSrc ? 'inline-flex' : 'none';
            toggleReelBtn.setAttribute('data-mode', 'cover');
          }
          if (resetBtn) {
            resetBtn.classList.remove('visible');
            resetBtn.style.display = 'none';
          }

          if (displayTitle) displayTitle.innerText = defaultSet.title;
          if (previewBadge) previewBadge.style.display = 'none';

          if (priceWrapper) priceWrapper.innerHTML = renderPrice(defaultSet.price, defaultSet.offer_price);

          // Keep button text clean & minimal
          if (addCartBtn) addCartBtn.innerText = 'Add to Cart';
          if (buyWappBtn) buyWappBtn.innerText = 'Buy Now on WhatsApp';

          if (descText) descText.innerText = defaultSet.description;
          renderSpecs(defaultSet.specs);

          // Sync Phase 4 Sticky Mobile Quick-Buy Bar
          updateStickyBarData({
            image: defaultSet.image,
            title: defaultSet.title,
            final_price: defaultSet.final_price,
            wappOrderLink: defaultSet.wappOrderLink
          });

          document.querySelectorAll('.combo-interactive-card').forEach(c => c.classList.remove('active'));
          const fullSetCard = document.getElementById('card-full-set');
          if (fullSetCard) fullSetCard.classList.add('active');
        }

        function switchToItem(item, idx) {
          currentActiveItemIndex = idx;

          if (mainVideo) {
            mainVideo.pause();
            mainVideo.classList.remove('active');
            mainVideo.classList.add('hidden');
          }
          if (toggleReelBtn) {
            toggleReelBtn.classList.add('hidden-pill');
            toggleReelBtn.style.display = 'none';
          }
          if (mainImage) {
            mainImage.src = item.image;
            mainImage.alt = item.title;
            mainImage.classList.remove('hidden');
            mainImage.classList.add('active');
          }
          if (resetBtn) {
            resetBtn.classList.add('visible');
            resetBtn.style.display = 'inline-flex';
          }

          if (displayTitle) displayTitle.innerText = item.title;
          if (previewBadge) {
            previewBadge.style.display = 'inline-block';
            previewBadge.innerText = `• Inspecting Piece (${idx + 1}/${items.length}) — ${item.category || 'Piece'}`;
          }

          if (priceWrapper) priceWrapper.innerHTML = renderPrice(item.price, item.offer_price);

          // Keep button text clean & minimal as requested
          if (addCartBtn) addCartBtn.innerText = 'Add to Cart';
          if (buyWappBtn) buyWappBtn.innerText = 'Buy Now on WhatsApp';

          if (descText) descText.innerText = item.description || defaultSet.description;
          renderSpecs(item.specs);

          // Sync Phase 4 Sticky Mobile Quick-Buy Bar
          updateStickyBarData({
            image: item.image,
            title: item.title,
            final_price: item.final_price,
            wappOrderLink: item.wappOrderLink
          });

          document.querySelectorAll('.combo-interactive-card').forEach(c => c.classList.remove('active'));
          const targetCard = document.getElementById(`card-item-${idx}`);
          if (targetCard) targetCard.classList.add('active');
        }

        // ==========================================
        // Modal State & Interaction
        // ==========================================
        function updateModalCalculation() {
          if (radioCompleteSet && radioCompleteSet.checked) {
            if (modalSummaryLabel) modalSummaryLabel.innerText = 'Complete Set Selected';
            if (modalTotalPrice) modalTotalPrice.innerText = `₹${defaultSet.final_price}`;
            if (modalConfirmBtn) {
              modalConfirmBtn.disabled = false;
              modalConfirmBtn.innerText = currentModalMode === 'cart' ? `Add Complete Set (₹${defaultSet.final_price}) to Cart` : `Buy Complete Set (₹${defaultSet.final_price}) on WhatsApp`;
            }
            return;
          }

          let sum = 0;
          let count = 0;
          pieceCheckboxes.forEach((cb) => {
            const row = cb.closest('.custom-piece-item');
            if (cb.checked) {
              sum += Number(cb.dataset.price || 0);
              count++;
              if (row) row.classList.add('selected');
            } else {
              if (row) row.classList.remove('selected');
            }
          });

          if (count === 0) {
            if (modalSummaryLabel) modalSummaryLabel.innerText = 'No pieces selected';
            if (modalTotalPrice) modalTotalPrice.innerText = '₹0';
            if (modalConfirmBtn) {
              modalConfirmBtn.disabled = true;
              modalConfirmBtn.innerText = 'Select At Least 1 Item';
            }
          } else {
            if (modalSummaryLabel) modalSummaryLabel.innerText = `${count} piece${count > 1 ? 's' : ''} selected`;
            if (modalTotalPrice) modalTotalPrice.innerText = `₹${sum}`;
            if (modalConfirmBtn) {
              modalConfirmBtn.disabled = false;
              modalConfirmBtn.innerText = currentModalMode === 'cart' ? `Add ${count} Item${count > 1 ? 's' : ''} (₹${sum}) to Cart` : `Order ${count} Item${count > 1 ? 's' : ''} (₹${sum}) on WhatsApp`;
            }
          }
        }

        function openModal(mode) {
          currentModalMode = mode;
          if (!modal) return;

          // Initial selection setup
          if (currentActiveItemIndex >= 0) {
            // Pre-select the currently inspected single piece
            if (radioCompleteSet) radioCompleteSet.checked = false;
            pieceCheckboxes.forEach((cb) => {
              const idx = Number(cb.dataset.index);
              cb.checked = (idx === currentActiveItemIndex);
            });
          } else {
            // Default to Complete Set
            if (radioCompleteSet) radioCompleteSet.checked = true;
            pieceCheckboxes.forEach((cb) => (cb.checked = false));
          }

          updateModalCalculation();

          modal.style.display = 'flex';
          setTimeout(() => {
            modal.classList.add('open');
          }, 10);
        }

        function closeModal() {
          if (!modal) return;
          modal.classList.remove('open');
          setTimeout(() => {
            modal.style.display = 'none';
          }, 250);
        }

        // Close handlers
        if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
        if (modal) {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
          });
        }

        // Radio click selects bundle
        if (radioCompleteSet) {
          radioCompleteSet.addEventListener('change', () => {
            if (radioCompleteSet.checked) {
              pieceCheckboxes.forEach(cb => (cb.checked = false));
              updateModalCalculation();
            }
          });
        }
        if (bundleOptionCard) {
          bundleOptionCard.addEventListener('click', (e) => {
            if (e.target !== radioCompleteSet) {
              if (radioCompleteSet) radioCompleteSet.checked = true;
              pieceCheckboxes.forEach(cb => (cb.checked = false));
              updateModalCalculation();
            }
          });
        }

        // Checkbox clicks deselect radio
        pieceCheckboxes.forEach((cb) => {
          cb.addEventListener('change', () => {
            if (radioCompleteSet) radioCompleteSet.checked = false;
            updateModalCalculation();
          });
        });

        // Confirm button action
        if (modalConfirmBtn) {
          modalConfirmBtn.addEventListener('click', () => {
            const isFullSet = radioCompleteSet && radioCompleteSet.checked;

            if (isFullSet) {
              // Action on Complete Set
              if (currentModalMode === 'cart') {
                let cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
                const existing = cart.find(i => i.id === defaultSet.id);
                if (existing) {
                  existing.quantity = (existing.quantity || 1) + 1;
                } else {
                  cart.push({
                    id: defaultSet.id,
                    title: `${defaultSet.title} (Full Set)`,
                    price: Number(defaultSet.final_price),
                    image: defaultSet.image,
                    quantity: 1
                  });
                }
                localStorage.setItem('alif_cart', JSON.stringify(cart));
                updateCartBadges();
                closeModal();

                if (addCartBtn) {
                  const orig = addCartBtn.innerText;
                  addCartBtn.innerText = 'Added Set to Cart ✓';
                  setTimeout(() => { addCartBtn.innerText = orig; }, 2000);
                }
              } else {
                // WhatsApp
                window.open(defaultSet.wappOrderLink, '_blank');
                closeModal();
              }
            } else {
              // Action on Custom Selected Pieces
              const selectedItems = [];
              let sum = 0;
              pieceCheckboxes.forEach((cb) => {
                if (cb.checked) {
                  const it = {
                    id: cb.dataset.id || `${defaultSet.id}-item-${cb.dataset.index}`,
                    title: cb.dataset.title,
                    price: Number(cb.dataset.price),
                    image: cb.dataset.image
                  };
                  selectedItems.push(it);
                  sum += it.price;
                }
              });

              if (selectedItems.length === 0) return;

              if (currentModalMode === 'cart') {
                let cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
                selectedItems.forEach((it) => {
                  const existing = cart.find(i => i.id === it.id);
                  if (existing) {
                    existing.quantity = (existing.quantity || 1) + 1;
                  } else {
                    cart.push({ ...it, quantity: 1 });
                  }
                });
                localStorage.setItem('alif_cart', JSON.stringify(cart));
                updateCartBadges();
                closeModal();

                if (addCartBtn) {
                  const orig = addCartBtn.innerText;
                  addCartBtn.innerText = `Added ${selectedItems.length} Item${selectedItems.length > 1 ? 's' : ''} ✓`;
                  setTimeout(() => { addCartBtn.innerText = orig; }, 2000);
                }
              } else {
                // WhatsApp
                let msg = `*Order Request for Selected Pieces from ${defaultSet.title}* 📦\n\n`;
                selectedItems.forEach(it => {
                  msg += `▪️ ${it.title} - ₹${it.price}\n`;
                });
                msg += `\n*Total Amount: ₹${sum}*`;
                window.open(`https://wa.me/7250470009?text=${encodeURIComponent(msg)}`, '_blank');
                closeModal();
              }
            }
          });
        }

        // Intercept Add to Cart and Buy on WhatsApp clicks for combos
        if (addCartBtn) {
          addCartBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openModal('cart');
          });
        }

        if (buyWappBtn) {
          buyWappBtn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            openModal('whatsapp');
          });
        }

        // Bind Tray Clicks
        const fullSetCard = document.getElementById('card-full-set');
        if (fullSetCard) {
          fullSetCard.addEventListener('click', switchToFullSet);
        }

        if (resetBtn) {
          resetBtn.addEventListener('click', switchToFullSet);
        }

        items.forEach((item, idx) => {
          const card = document.getElementById(`card-item-${idx}`);
          if (card) {
            card.addEventListener('click', () => switchToItem(item, idx));
          }
        });

      } catch (err) {
        console.error('Error initializing combo logic:', err);
      }
    } else {
      // Regular Non-Combo Product Handling
      const addBtn = document.getElementById('addToCartBtn');
      if (addBtn) {
        addBtn.addEventListener('click', () => {
          const id = addBtn.getAttribute('data-product-id');
          const title = addBtn.getAttribute('data-title');
          const price = Number(addBtn.getAttribute('data-price'));
          const image = addBtn.getAttribute('data-image');
          const code = addBtn.getAttribute('data-code') || '';

          let cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
          const existing = cart.find(item => item.id === id);
          if (existing) {
            existing.quantity = (existing.quantity || 1) + 1;
            if (code && !existing.code) existing.code = code;
          } else {
            cart.push({ id, title, price, image, code, quantity: 1 });
          }
          localStorage.setItem('alif_cart', JSON.stringify(cart));
          updateCartBadges();

          const originalText = addBtn.innerText;
          addBtn.innerText = 'Added to Cart ✓';
          setTimeout(() => { addBtn.innerText = originalText; }, 2000);
        });
      }

      const buyWapp = document.getElementById('buyWhatsAppBtn');
      if (buyWapp) {
        buyWapp.addEventListener('click', () => {
          const url = buyWapp.getAttribute('data-wapp-url');
          if (url) window.open(url, '_blank');
        });
      }
    }

    // Global Media Switcher Pill (Watch Outfit Video <-> View Fabric Cover)
    const toggleReelBtn = document.getElementById('toggleReelMediaBtn');
    const mainVideo = document.getElementById('comboMainVideo');
    const mainImage = document.getElementById('comboMainImage');

    if (toggleReelBtn && mainVideo && mainImage && !toggleReelBtn._bound) {
      toggleReelBtn._bound = true;
      toggleReelBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const isCurrentlyVideo = !mainVideo.classList.contains('hidden');

        if (isCurrentlyVideo) {
          // Switch to Fabric Cover image
          try {
            mainVideo.pause();
          } catch (err) {}
          mainVideo.classList.remove('active');
          mainVideo.classList.add('hidden');

          mainImage.classList.remove('hidden');
          mainImage.classList.add('active');

          toggleReelBtn.setAttribute('data-mode', 'cover');
        } else {
          // Switch to Reel Video
          mainImage.classList.remove('active');
          mainImage.classList.add('hidden');

          mainVideo.classList.remove('hidden');
          mainVideo.classList.add('active');

          // Ensure video is unmuted & plays on user gesture
          mainVideo.muted = true; // start muted for zero-rejection policy on iOS/Android
          const playPromise = mainVideo.play();
          if (playPromise !== undefined) {
            playPromise.catch((err) => {
              console.warn('Video auto-playback blocked or awaiting tap:', err);
            });
          }

          toggleReelBtn.setAttribute('data-mode', 'video');
        }
      });
    }
  }

    function updateCartBadges() {
      const cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
      const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
      const b1 = document.getElementById('cartCount');
      const b2 = document.getElementById('cartCountMobile');
      if (b1) b1.innerText = count;
      if (b2) b2.innerText = count;
    }

    // Phase 4: Sticky Mobile Quick-Buy Bar Initialization & Visibility
    function initStickyBuyBar() {
      const stickyBar = document.getElementById('stickyMobileBuyBar');
      const stickyBuyBtn = document.getElementById('stickyBuyNowBtn');
      const mainBuyBtn = document.getElementById('buyWhatsAppBtn');

      if (!stickyBar) return;

      // Connect sticky Buy Now button to primary buy action
      if (stickyBuyBtn && mainBuyBtn && !stickyBuyBtn._bound) {
        stickyBuyBtn._bound = true;
        stickyBuyBtn.addEventListener('click', (e) => {
          e.preventDefault();
          mainBuyBtn.click();
        });
      }

      // Connect sticky Add to Bag button to primary add to cart action
      const stickyCartBtn = document.getElementById('stickyAddToCartBtn');
      const mainCartBtn = document.getElementById('addToCartBtn');
      if (stickyCartBtn && mainCartBtn && !stickyCartBtn._bound) {
        stickyCartBtn._bound = true;
        stickyCartBtn.addEventListener('click', (e) => {
          e.preventDefault();
          mainCartBtn.click();
        });
      }

      // Starting state: Visible right from the start
      stickyBar.classList.add('visible');

      if (stickyBar._scrollBound) return;
      stickyBar._scrollBound = true;

      // Scroll direction behavior:
      let lastScrollY = window.scrollY || window.pageYOffset || 0;
      let ticking = false;

      function onScroll() {
        const currentScrollY = window.scrollY || window.pageYOffset || 0;

        // If at the very top (starting se), keep it visible
        if (currentScrollY <= 20) {
          stickyBar.classList.add('visible');
          lastScrollY = currentScrollY;
          ticking = false;
          return;
        }

        const diff = currentScrollY - lastScrollY;
        // Small threshold to avoid micro-jitter
        if (Math.abs(diff) > 5) {
          if (diff > 0) {
            // Scrolling DOWN -> Appear
            stickyBar.classList.add('visible');
          } else {
            // Scrolling UP -> Disappear (Gayab)
            stickyBar.classList.remove('visible');
          }
          lastScrollY = currentScrollY;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });
    }

    function initProductDetailPage() {
      initProductActions();
      initStickyBuyBar();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductDetailPage);
    } else {
      initProductDetailPage();
    }
    document.addEventListener('astro:page-load', initProductDetailPage);
  </script>

  <style>
    /* =========================================================
       CRITICAL LAYOUT RESET: Prevent right-shift / grid blowout
       ========================================================= */
    .container.section {
      width: 100% !important;
      max-width: 1060px !important;
      margin: 0 auto !important;
      padding: 16px 16px 40px 16px !important;
      box-sizing: border-box !important;
      overflow-x: hidden !important;
    }

    @media (min-width: 768px) {
      .container.section {
        padding: 32px 24px 60px 24px !important;
      }
    }

    .product-detail-grid {
