    .reel-media-toggle-pill[data-mode="video"] .state-to-video {
      display: none !important;
    }
    .reel-media-toggle-pill[data-mode="video"] .state-to-cover {
      display: inline-flex !important;
    }

    .reel-media-toggle-pill:hover {
