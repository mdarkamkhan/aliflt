    /* Luxury alif. Floating Media Switcher (Watch Video <-> View Cover) */
    .reel-media-toggle-pill {
      position: absolute !important;
      bottom: 14px !important;
      right: 14px !important;
      z-index: 10 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      background: rgba(18, 16, 22, 0.72) !important;
      backdrop-filter: blur(16px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(16px) saturate(180%) !important;
      color: #ffffff !important;
      padding: 8px 14px !important;
      border-radius: 999px !important;
      border: 1px solid rgba(255, 255, 255, 0.22) !important;
      font-family: var(--font-body, 'Ubuntu', sans-serif) !important;
      font-size: 0.68rem !important;
      font-weight: 600 !important;
      letter-spacing: 0.8px !important;
      text-transform: uppercase !important;
      cursor: pointer !important;
      transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1) !important;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.35) !important;
      touch-action: manipulation !important;
      min-height: 34px !important;
    }

    .reel-media-toggle-pill.hidden-pill {
      display: none !important;
    }

    .reel-media-toggle-pill .pill-media-state {
      display: inline-flex !important;
      align-items: center !important;
      gap: 6px !important;
    }

    /* By default (mode="cover"), show "Watch Video", hide "View Cover" */
    .reel-media-toggle-pill[data-mode="cover"] .state-to-video {
      display: inline-flex !important;
    }
    .reel-media-toggle-pill[data-mode="cover"] .state-to-cover {
      display: none !important;
    }

    /* When playing video (mode="video"), show "View Cover", hide "Watch Video" */
    .reel-media-toggle-pill[data-mode="video"] {
      background: rgba(255, 255, 255, 0.92) !important;
      color: #111111 !important;
      border-color: rgba(255, 255, 255, 0.95) !important;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4) !important;
