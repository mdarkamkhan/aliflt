---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services & Works" description="Explore dedicated tailoring services or view our completed customer portfolio at ALiF.">
  <div class="container section fade-in-section">
    <div style="text-align: center; margin-bottom: 30px;">
      <h1 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 2px;">Services &amp; Our Works</h1>
      <p style="color: #666; font-size: 0.95rem; margin: 0; font-family: var(--font-body);">Explore our dedicated tailoring services or view our completed customer portfolio.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; max-width: 800px; margin: 0 auto 40px auto; padding: 10px 4px 25px 4px;">
      
      <a href="/services/" style="text-decoration: none; color: inherit; padding: 34px 26px; text-align: center; background: white; border-radius: 10px; box-shadow: inset 0 -3em 3em rgba(0,0,0,0.1), 0 0 0 2px rgb(190, 190, 190), 0.3em 0.3em 1em rgba(0,0,0,0.3); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <h2 style="font-family: var(--font-heading); font-size: 1.4rem; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 1.5px;">Tailoring Services</h2>
          <p style="font-size: 0.88rem; color: #666; margin: 0 0 20px 0; line-height: 1.5;">Custom blouse stitching, bridal lehenga fitting, suits, kurtis, and boutique tailoring rates.</p>
        </div>
        <div>
          <span style="display: inline-block; padding: 10px 24px; background: #000; color: #fff; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px; border-radius: 4px;">View Services &rarr;</span>
        </div>
      </a>

      <a href="/works/" style="text-decoration: none; color: inherit; padding: 34px 26px; text-align: center; background: white; border-radius: 10px; box-shadow: inset 0 -3em 3em rgba(0,0,0,0.1), 0 0 0 2px rgb(190, 190, 190), 0.3em 0.3em 1em rgba(0,0,0,0.3); transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <h2 style="font-family: var(--font-heading); font-size: 1.4rem; margin: 0 0 10px 0; text-transform: uppercase; letter-spacing: 1.5px;">Our Work Portfolio</h2>
          <p style="font-size: 0.88rem; color: #666; margin: 0 0 20px 0; line-height: 1.5;">Showcase gallery of real customer orders, finished stitching creations, and craftsmanship.</p>
        </div>
        <div>
          <span style="display: inline-block; padding: 10px 24px; background: #000; color: #fff; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px; border-radius: 4px;">View Portfolio &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>
