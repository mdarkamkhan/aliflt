---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services & Works" description="Explore dedicated tailoring services or view our completed customer portfolio at alif..">
  <div class="container section fade-in-section">
    <div style="text-align: center; margin-bottom: 40px; padding-top: 10px;">
      <p style="font-size: 0.75rem; letter-spacing: 2.5px; text-transform: uppercase; color: #888; margin: 0 0 10px 0;">alif. Atelier Directory</p>
      <h1 style="font-family: var(--font-heading); font-size: 2rem; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 2px; font-weight: 400;">Services &amp; Our Works</h1>
      <p style="color: #666; font-size: 0.95rem; margin: 0 auto; max-width: 520px; font-family: var(--font-body); line-height: 1.6;">Explore our dedicated tailoring services or view our completed bespoke customer portfolio.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; max-width: 820px; margin: 0 auto 50px auto; padding: 0 12px;">
      
      <a href="/services/" class="luxury-portal-card" style="text-decoration: none; color: inherit; padding: 40px 32px; text-align: left; background: white; border-radius: 8px; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 16px rgba(0,0,0,0.03); transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        <div>
          <span style="display: inline-block; font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 12px; font-weight: 500;">Bespoke Tailoring</span>
          <h2 style="font-family: var(--font-heading); font-size: 1.5rem; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 400; color: #111;">Tailoring Services</h2>
          <p style="font-size: 0.88rem; color: #666; margin: 0 0 28px 0; line-height: 1.6;">Custom blouse stitching, bridal lehenga fitting, suits, kurtis, and bespoke atelier tailoring rates.</p>
        </div>
        <div>
          <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 400; text-transform: uppercase; letter-spacing: 2px; color: #000; border-bottom: 1px solid #000; padding-bottom: 4px;">Explore Services &rarr;</span>
        </div>
      </a>

      <a href="/works/" class="luxury-portal-card" style="text-decoration: none; color: inherit; padding: 40px 32px; text-align: left; background: white; border-radius: 8px; border: 1px solid rgba(0, 0, 0, 0.08); box-shadow: 0 4px 16px rgba(0,0,0,0.03); transition: transform 0.3s ease, box-shadow 0.3s ease; display: flex; flex-direction: column; justify-content: space-between; position: relative;">
        <div>
          <span style="display: inline-block; font-size: 0.7rem; letter-spacing: 2px; text-transform: uppercase; color: #888; margin-bottom: 12px; font-weight: 500;">Craft Portfolio</span>
          <h2 style="font-family: var(--font-heading); font-size: 1.5rem; margin: 0 0 12px 0; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 400; color: #111;">Our Work Portfolio</h2>
          <p style="font-size: 0.88rem; color: #666; margin: 0 0 28px 0; line-height: 1.6;">Showcase gallery of real customer orders, completed stitching creations, embroidery, and atelier craftsmanship.</p>
        </div>
        <div>
          <span style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.78rem; font-weight: 400; text-transform: uppercase; letter-spacing: 2px; color: #000; border-bottom: 1px solid #000; padding-bottom: 4px;">View Portfolio &rarr;</span>
        </div>
      </a>

    </div>
  </div>
</BaseLayout>
