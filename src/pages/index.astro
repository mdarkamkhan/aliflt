    <script is:inline>
        // Manual Top Banner Carousel (Auto-slide removed, thin navigation buttons < >)
        function initBannerSlider() {
            const banner = document.getElementById('top-banner');
            if (!banner) return;
            const slides = banner.querySelectorAll('.banner-slide-item');
            const btnPrev = document.getElementById('bannerSlidePrev');
            const btnNext = document.getElementById('bannerSlideNext');
            const countEl = document.getElementById('bannerCurrentIdx');
            if (slides.length <= 1) return;

            let currentIndex = 0;

            function showSlide(index) {
                slides.forEach((slide, i) => {
                    if (i === index) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });
                currentIndex = index;
                if (countEl) {
                    countEl.textContent = String(index + 1).padStart(2, '0');
                }
            }

            if (btnPrev && !btnPrev._bound) {
                btnPrev._bound = true;
                btnPrev.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
                    showSlide(prevIndex);
                });
            }

            if (btnNext && !btnNext._bound) {
                btnNext._bound = true;
                btnNext.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const nextIndex = (currentIndex + 1) % slides.length;
                    showSlide(nextIndex);
                });
            }

            // Mobile touch swipe gestures
            let touchStartX = 0;
            let touchEndX = 0;

            if (!banner._touchBound) {
                banner._touchBound = true;
                banner.addEventListener('touchstart', (e) => {
                    touchStartX = e.changedTouches[0].screenX;
                }, { passive: true });

                banner.addEventListener('touchend', (e) => {
                    touchEndX = e.changedTouches[0].screenX;
                    const diffX = touchEndX - touchStartX;
                    if (Math.abs(diffX) > 40) {
                        if (diffX < 0) {
                            showSlide((currentIndex + 1) % slides.length);
                        } else {
                            showSlide((currentIndex - 1 + slides.length) % slides.length);
                        }
                    }
                }, { passive: true });
            }
        }


        // Trending Reels Swipe Interactions & Audio Persistence
        function initHomeReelsInteractions() {
            const viewport = document.getElementById('reelsCardsViewport');
            const track = document.getElementById('reelsCardsTrack');
            const cards = Array.from(document.querySelectorAll('.reels-cards-track .reel-card:not(.reel-watch-all-card)'));

            if (!track || !viewport || cards.length === 0) return;

            let isAudioGloballyActive = false;
            let activeCard = null;

            // Strictly pause and mute all videos except targetCard
            function pauseAllExcept(targetCard) {
                cards.forEach(card => {
                    if (card !== targetCard) {
                        const v = card.querySelector('video');
                        const centerBtn = card.querySelector('.reel-center-ctrl');
                        if (v) {
                            if (!v.paused || v.currentTime > 0) {
                                v.pause();
                            }
                            v.muted = true;
                        }
                        if (centerBtn) {
                            centerBtn.classList.remove('state-paused');
                        }
                    }
                });
            }

            function updateSoundUI() {
                cards.forEach(card => {
                    const video = card.querySelector('video');
                    const centerBtn = card.querySelector('.reel-center-ctrl');
                    const soundPill = card.querySelector('.reel-audio-pill');

                    if (soundPill) {
                        if (isAudioGloballyActive) {
                            soundPill.classList.add('sound-active');
                            soundPill.classList.remove('sound-muted');
                        } else {
                            soundPill.classList.add('sound-muted');
                            soundPill.classList.remove('sound-active');
                        }
                    }

                    if (video) {
                        if (card === activeCard) {
                            video.muted = !isAudioGloballyActive;
                        } else {
                            video.muted = true;
                        }
                    }

                    if (centerBtn && card === activeCard) {
                        if (isAudioGloballyActive) {
                            centerBtn.classList.remove('state-mute');
                            if (video && !video.paused) {
                                centerBtn.classList.add('fade-hidden');
                            }
                        } else {
                            centerBtn.classList.add('state-mute');
                            centerBtn.classList.remove('fade-hidden', 'state-paused');
                        }
                    }
                });
            }

            function activateCard(targetCard, forcePlay = false) {
                if (!targetCard) return;
                if (targetCard === activeCard && !forcePlay) return;

                pauseAllExcept(targetCard);

                activeCard = targetCard;
                const video = targetCard.querySelector('video');
                const centerBtn = targetCard.querySelector('.reel-center-ctrl');

                if (!video) return;

                // Lazy load actual video source on demand
                if (!video.src && video.getAttribute('data-src')) {
                    video.src = video.getAttribute('data-src');
                    video.load();
                }

                video.muted = !isAudioGloballyActive;

                if (centerBtn) {
                    centerBtn.classList.remove('state-paused');
                    if (isAudioGloballyActive) {
                        centerBtn.classList.remove('state-mute');
                        centerBtn.classList.add('fade-hidden');
                    } else {
                        centerBtn.classList.add('state-mute');
                        centerBtn.classList.remove('fade-hidden');
                    }
                }

                const playPromise = video.play();
                if (playPromise !== undefined) {
                    playPromise.catch(() => {
                        if (!video.muted) {
                            video.muted = true;
                            video.play().catch(() => {});
                            if (centerBtn) {
                                centerBtn.classList.add('state-mute');
                                centerBtn.classList.remove('fade-hidden');
                            }
                        }
                    });
                }
            }

            if (track._homeReelsInitialized) return;
            track._homeReelsInitialized = true;

            const reelsSectionObserver = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const best = getMostVisibleCard() || cards[0];
                        if (best) activateCard(best);
                    } else {
                        pauseAllExcept(null);
                    }
                });
            }, { rootMargin: '100px 0px' });
            reelsSectionObserver.observe(viewport);

            function getMostVisibleCard() {
                if (!viewport) return null;
                const viewportRect = viewport.getBoundingClientRect();
                const viewportCenterX = viewportRect.left + viewportRect.width / 2;

                let closestCard = null;
                let minDistance = Infinity;

                cards.forEach(card => {
                    const rect = card.getBoundingClientRect();
                    const cardCenterX = rect.left + rect.width / 2;
                    const dist = Math.abs(viewportCenterX - cardCenterX);
                    if (dist < minDistance) {
                        minDistance = dist;
                        closestCard = card;
                    }
                });

                return closestCard;
            }

            let scrollDebounceTimer = null;
            track.addEventListener('scroll', () => {
                if (scrollDebounceTimer) clearTimeout(scrollDebounceTimer);
                scrollDebounceTimer = setTimeout(() => {
                    const best = getMostVisibleCard();
                    if (best && best !== activeCard) {
                        activateCard(best);
                    }
                }, 120);
            }, { passive: true });

            // IntersectionObserver: Pause when reels section is offscreen
            const section = document.getElementById('reelsSection');
            if (section) {
                const sectionObserver = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (!entry.isIntersecting) {
                            cards.forEach(c => {
                                const v = c.querySelector('video');
                                if (v) v.pause();
                            });
                        } else {
                            if (activeCard) {
                                const v = activeCard.querySelector('video');
                                if (v && v.paused) v.play().catch(() => {});
                            } else if (cards.length > 0) {
                                activateCard(cards[0]);
                            }
                        }
                    });
                }, { threshold: 0.1 });
                sectionObserver.observe(section);
            }

            function toggleAudioGlobal() {
                isAudioGloballyActive = !isAudioGloballyActive;
                updateSoundUI();
                if (activeCard) {
                    const video = activeCard.querySelector('video');
                    if (video && video.paused) {
                        video.play().catch(() => {});
                    }
                }
            }

            cards.forEach(card => {
                const video = card.querySelector('video');
                const centerBtn = card.querySelector('.reel-center-ctrl');
                const soundPill = card.querySelector('.reel-audio-pill');

                if (!video) return;

                if (soundPill) {
                    soundPill.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        toggleAudioGlobal();
                    });
                }

                if (centerBtn) {
                    centerBtn.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();

                        if (card !== activeCard) {
                            isAudioGloballyActive = true;
                            activateCard(card, true);
                            return;
                        }

                        if (video.paused) {
                            isAudioGloballyActive = true;
                            pauseAllExcept(card);
                            video.muted = false;
                            video.play().catch(() => {});
                            updateSoundUI();
                            centerBtn.classList.remove('state-paused', 'state-mute');
                            centerBtn.classList.add('fade-hidden');
                        } else if (video.muted) {
                            isAudioGloballyActive = true;
                            updateSoundUI();
                            video.muted = false;
                            centerBtn.classList.remove('state-mute');
                            centerBtn.classList.add('fade-hidden');
                        } else {
                            video.pause();
                            centerBtn.classList.remove('fade-hidden');
                            centerBtn.classList.add('state-paused');
                        }
                    });
                }

                card.addEventListener('click', (e) => {
                    if (e.target.closest('a') || e.target.closest('button')) return;

                    if (card !== activeCard) {
                        isAudioGloballyActive = true;
                        activateCard(card, true);
                        return;
                    }

                    if (video.paused) {
                        isAudioGloballyActive = true;
                        pauseAllExcept(card);
                        video.muted = false;
                        video.play().catch(() => {
                            video.muted = true;
                            video.play().catch(() => {});
                        });
                        updateSoundUI();
                        if (centerBtn) {
                            centerBtn.classList.remove('state-paused', 'state-mute');
                            centerBtn.classList.add('fade-hidden');
                        }
                    } else if (video.muted) {
                        isAudioGloballyActive = true;
                        updateSoundUI();
                        video.muted = false;
                        if (centerBtn) {
                            centerBtn.classList.remove('state-mute');
                            centerBtn.classList.add('fade-hidden');
                        }
                    } else {
                        video.pause();
                        if (centerBtn) {
                            centerBtn.classList.remove('fade-hidden');
                            centerBtn.classList.add('state-paused');
                        }
                    }
                });
            });

            // Pause all videos initially
            cards.forEach(c => {
                const v = c.querySelector('video');
                if (v) {
                    v.pause();
                    v.currentTime = 0;
                    v.muted = true;
                }
            });
            if (cards.length > 0) {
                activateCard(cards[0]);
            }
        }

        // Hard Cleanup: Stop all homepage video playback when leaving page or changing tabs
        function cleanupHomeReels() {
            document.querySelectorAll('.reels-cards-track video').forEach(v => {
                v.pause();
                v.muted = true;
            });
        }

        document.addEventListener('astro:before-swap', cleanupHomeReels);
        window.addEventListener('pagehide', cleanupHomeReels);
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                cleanupHomeReels();
            }
        });

        function initHomePage() {
            initBannerSlider();
            initHomeReelsInteractions();
        }

        document.addEventListener('astro:page-load', initHomePage);

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initHomePage);
        } else {
            initHomePage();
        }
    </script>

    <style>
      /* --- TOP EDITORIAL BANNER SHOWCASE (Edge-to-Edge Full-Bleed) --- */
      #top-banner {
        position: relative;
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        overflow: hidden;
      }

      @media (min-width: 769px) {
        #top-banner {
          max-width: 580px;
          margin: 16px auto 24px auto;
          border-radius: 20px;
          box-shadow: 0 16px 44px rgba(0, 0, 0, 0.08);
        }
      }

      .banner-carousel {
        position: relative;
        width: 100%;
        aspect-ratio: 1400 / 1980;
        margin: 0;
        padding: 0;
        border-radius: inherit;
        display: grid;
        background: #f7f4ee;
        overflow: hidden;
      }

      .banner-slide-item {
        grid-area: 1 / 1;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.4s ease;
        pointer-events: none;
      }

      .banner-slide-item.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
        pointer-events: auto;
      }

      .banner-slide-item picture,
      .banner-slide-item img {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
        border-radius: inherit;
      }

      /* Thin Slide Navigation Buttons (< >) */
      .banner-thin-nav-btn {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.78);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        color: #111111;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 10;
        transition: all 0.22s ease;
        padding: 0;
        outline: none;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);
        -webkit-tap-highlight-color: transparent;
      }

      .banner-thin-nav-btn:hover {
        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(0, 0, 0, 0.2);
        transform: translateY(-50%) scale(1.06);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.16);
      }

      .banner-thin-nav-btn:active {
        transform: translateY(-50%) scale(0.96);
      }

      .banner-btn-prev {
        left: 16px;
      }

      .banner-btn-next {
        right: 16px;
      }

      @media (max-width: 600px) {
        .banner-thin-nav-btn {
          width: 36px;
          height: 36px;
        }
        .banner-btn-prev {
          left: 10px;
        }
        .banner-btn-next {
          right: 10px;
