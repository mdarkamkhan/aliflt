        background: rgba(255, 255, 255, 0.95);
        border-color: rgba(255, 255, 255, 0.95);
        color: #111111;
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
      }

      .reel-minimal-cta .reel-minimal-arrow {
        transition: transform 0.2s ease;
      }

      .reel-minimal-cta:hover .reel-minimal-arrow {
        transform: translateX(3px);
      }

      @media (max-width: 600px) {
        .trending-reels-section {
          margin: 0 0 80px 0;
        }
        .reel-curated-strip {
          bottom: 12px;
          left: 8px;
          right: 8px;
          padding: 9px 10px;
          gap: 8px;
          border-radius: 14px;
        }
        .rc-items-row {
          gap: 7px;
        }
        .rc-mini-card {
          width: 48px;
          height: 66px;
          min-width: 48px;
          border-radius: 7px;
        }
        .rc-strip-divider {
          height: 42px;
          margin: 0 3px;
        }
        .rc-set-tag {
          font-size: 0.58rem;
          letter-spacing: 1.2px;
        }
        .rc-action-btn {
          height: 30px;
          line-height: 30px;
          padding: 0 11px;
          font-size: 0.62rem;
          gap: 5px;
        }
        .reel-minimal-cta {
          padding: 6px 15px;
          font-size: 0.60rem;
          letter-spacing: 1.5px;
        }
