---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const offers = await getCollection('offers');
const products = await getCollection('products');
const services = await getCollection('services');
const works = await getCollection('works');
const designs = await getCollection('designs');

const recentOffers = [...offers].reverse();
const recentServices = [...services].reverse().slice(0, 5);
const recentWorks = [...works].reverse().slice(0, 5);
const recentDesigns = [...designs].reverse().slice(0, 5);

// Get distinct category highlights for products
const seenCategories = new Set();
const highlightedProducts = [];
for (const p of [...products].reverse()) {
  const cat = (p.data.category || '').toLowerCase();
  if (cat && !seenCategories.has(cat)) {
    seenCategories.add(cat);
    highlightedProducts.push(p);
  }
}

// Curated trending items with animations from ELEMENTS/trending items card
const trendingItems = [
  {
    title: "Designer Blouse",
    subtitle: "Custom Fit • From ₹120",
    tag: "TRENDING",
    image: "/uploads/services/blouse.webp",
    link: "/services/blouse/",
  },
  {
    title: "Bridal Lehenga",
    subtitle: "Royal Flare • From ₹350",
    tag: "POPULAR",
    image: "/uploads/services/lehenga.webp",
    link: "/services/lehenga/",
  },
  {
    title: "Salwar Suit",
    subtitle: "Precision Cut • From ₹150",
    tag: "DAILY WEAR",
    image: "/uploads/services/salwar-suit.webp",
    link: "/services/salwar-suit/",
  },
  {
    title: "Bespoke Gown",
    subtitle: "Red Carpet Drapes",
    tag: "EXCLUSIVE",
    image: "/uploads/services/gown.webp",
    link: "/services/gown/",
  },
  {
    title: "Trims & Latkans",
    subtitle: "Designer Laces • From ₹10",
    tag: "ACCESSORIES",
    image: "/uploads/1763903012350-1000023649.webp",
    link: "/products/",
  },
];
---

<BaseLayout title="Home" description="Custom bridal blouses, lehengas, gowns — premium ladies tailoring in Sahibganj.">
    <!-- Top Offers Banner -->
    <div id="top-banner">
        <div class="swapper-container banner-swapper">
            {recentOffers.map((item, index) => (
                <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                    <img src={item.data.image} alt={item.data.title || 'Advertisement'} />
                </div>
            ))}
            {recentOffers.length === 0 && (
                <p class="empty-gallery-message">Welcome to ALiF Ladies Tailor.</p>
            )}
        </div>
    </div>

    <!-- Trending Items Animated Showcase (Inspired by ELEMENTS/trending items card) -->
    <section class="trending-section" aria-label="Trending Collections">
        <div class="trending-header">
            <div class="trending-header-text">
                <span class="trending-eyebrow">CURATED ATELIER PICKS</span>
                <h2 class="trending-title">Trending Now</h2>
            </div>
            <div class="trending-swipe-hint" aria-hidden="true">
                <span>SWIPE</span>
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
            </div>
        </div>

        <div class="trending-rail">
            {trendingItems.map((item) => (
                <article class="trending-card">
                    <a class="card__link" href={item.link}>
                        <div class="card__icon">
                            <span class="card__tag">{item.tag}</span>
                        </div>
                        <div class="card__media">
                            <img src={item.image} alt={item.title} class="card__media-img" loading="lazy" />
                            <svg class="card__media-svg" viewBox="0 0 1129 994" aria-hidden="true">
                                <g stroke-width="32" stroke="rgba(255, 255, 255, 0.45)" fill-rule="nonzero" fill="none">
                                    <path d="M564.5 212.437L95.67 873.5h937.66L564.5 212.437z" />
                                    <path d="M564.5 407.47L163.638 973.5h801.724L564.5 407.47z" />
                                    <path d="M564.5 35.409L39.699 774.5H1089.3L564.5 35.409z" />
                                </g>
                            </svg>
                        </div>
                        <div class="card__header">
                            <p class="card__header-title">{item.title}</p>
                            <p class="card__header-meta">{item.subtitle}</p>
                            <div class="card__header-icon" aria-hidden="true">
                                <svg viewBox="0 0 28 25">
                                    <path d="M13.145 2.13l1.94-1.867 12.178 12-12.178 12-1.94-1.867 8.931-8.8H.737V10.93h21.339z" fill="#fff" />
                                </svg>
                            </div>
                        </div>
                    </a>
                </article>
            ))}
        </div>
    </section>

    <!-- Products Showcase Panel -->
    <a href="/products/" class="prada-panel">
        <div class="blob blob-products" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Products</div>
            <div class="swapper-container products-panel-gallery">
                {highlightedProducts.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image} alt={item.data.title} />
                    </div>
                ))}
                {highlightedProducts.length === 0 && (
                    <p class="empty-gallery-message">Products coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Products">
                <span class="hover-underline-animation">Shop Now</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Tailoring Services Showcase Panel -->
    <a href="/services/" class="prada-panel">
        <div class="blob blob-services" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Services</div>
            <div class="swapper-container services-panel-gallery">
                {recentServices.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title} />
                    </div>
                ))}
                {recentServices.length === 0 && (
                    <p class="empty-gallery-message">Services coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Services">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Our Works Showcase Panel -->
    <a href="/works/" class="prada-panel">
        <div class="blob blob-works" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Works</div>
            <div class="swapper-container works-panel-gallery">
                {recentWorks.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title || 'Our Work'} />
                    </div>
                ))}
                {recentWorks.length === 0 && (
                    <p class="empty-gallery-message">Our work coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Works">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Designs Showcase Panel -->
    <a href="/designs/" class="prada-panel">
        <div class="blob blob-designs" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Designs</div>
            <div class="swapper-container designs-panel-gallery">
                {recentDesigns.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title || 'Design'} />
                    </div>
                ))}
                {recentDesigns.length === 0 && (
                    <p class="empty-gallery-message">Designs coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Designs">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <script is:inline>
        // Swapper slideshow logic synchronized with 5s blob-bounce orbit
        function initSwappers() {
            if (window._swappersInitialized) return;
            window._swappersInitialized = true;

            const containers = document.querySelectorAll('.swapper-container');
            containers.forEach(container => {
                const items = container.querySelectorAll('.swapper-item');
                if (items.length <= 1) return;
                let current = 0;
                setInterval(() => {
                    items[current].classList.remove('active');
                    current = (current + 1) % items.length;
                    items[current].classList.add('active');
                }, 5000); // Exactly 5000ms = 1 full round of blob orbit (5s)
            });
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initSwappers);
        } else {
            initSwappers();
        }
    </script>

    <style>
      /* --- TRENDING ITEMS SECTION (INSPIRED BY ELEMENTS/trending items card) --- */
      .trending-section {
        position: relative;
        margin: 28px 0 20px 0;
        width: 100%;
        overflow: hidden;
      }

      .trending-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding: 0 16px;
        margin-bottom: 12px;
      }

      .trending-eyebrow {
        display: block;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #777777;
        margin-bottom: 4px;
      }

      .trending-title {
        font-family: var(--font-heading, 'Playfair Display', serif);
        font-size: 1.6rem;
        font-weight: 400;
        color: #111111;
        margin: 0;
        line-height: 1.15;
        letter-spacing: 0.5px;
      }

      .trending-swipe-hint {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        color: #888888;
        text-transform: uppercase;
        padding-bottom: 2px;
      }

      .trending-swipe-hint svg {
        animation: swipeBounce 1.5s infinite ease-in-out;
      }

      @keyframes swipeBounce {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(4px); }
      }

      /* Horizontal Smooth Swipe Track */
      .trending-rail {
        display: flex;
        gap: 16px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        padding: 6px 16px 20px 16px;
        scrollbar-width: none;
        -webkit-overflow-scrolling: touch;
      }

      .trending-rail::-webkit-scrollbar {
        display: none;
      }

      /* --- ANIMATED CARD (ELEMENTS/trending items card) --- */
      @keyframes fadeInScale {
        0% {
          opacity: 0;
          transform: scale(0.6) translateY(20%);
        }
        90% {
          transform: scale(1.04);
        }
        100% {
          opacity: 1;
          transform: scale(1) translateY(0);
        }
      }

      .trending-card {
        position: relative;
        width: 230px;
        flex-shrink: 0;
        scroll-snap-align: start;
        background-color: #1a1a1a;
        border-radius: 14px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        -webkit-tap-highlight-color: transparent;
      }

      .trending-card:hover,
      .trending-card:active {
        transform: translateY(-4px);
        box-shadow: 0 14px 28px rgba(0, 0, 0, 0.3);
        border-color: rgba(255, 255, 255, 0.2);
      }

      .trending-card .card__link {
        display: flex;
        flex-direction: column;
        padding: 14px;
        text-decoration: none;
        color: inherit;
        height: 100%;
        box-sizing: border-box;
        position: relative;
      }

      /* Top Icon / Badge */
      .trending-card .card__icon {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 4;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.3s ease-in-out;
      }

      .trending-card .card__tag {
        font-size: 0.58rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #f5f5f5;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(8px);
        padding: 3px 9px;
        border-radius: 100px;
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      .trending-card:hover .card__icon,
      .trending-card:active .card__icon {
        opacity: 0;
        transform: scale(0);
      }

      /* Media Section with Product Garment */
      .trending-card .card__media {
        position: relative;
        width: 100%;
        height: 195px;
        border-radius: 10px;
        overflow: hidden;
        background: #0f0f0f;
        margin: 18px 0 14px 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .trending-card .card__media-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        border-radius: 10px;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), filter 0.4s ease;
        z-index: 1;
      }

      .trending-card:hover .card__media-img,
      .trending-card:active .card__media-img {
        transform: scale(1.08);
        filter: brightness(1.08);
      }

      /* Animated Geometric SVG overlay from snippet */
      .trending-card .card__media-svg {
        position: absolute;
        inset: 12px;
        width: calc(100% - 24px);
        height: calc(100% - 24px);
        z-index: 2;
        pointer-events: none;
      }

      .trending-card .card__media-svg path {
        opacity: 0;
        transition: all 0.3s ease-in-out;
        transform-origin: center center;
      }

      .trending-card:hover .card__media-svg path,
      .trending-card:active .card__media-svg path {
        animation: fadeInScale 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .trending-card:hover .card__media-svg path:nth-child(2),
      .trending-card:active .card__media-svg path:nth-child(2) {
        animation-delay: 0.08s;
      }

      .trending-card:hover .card__media-svg path:nth-child(3),
      .trending-card:active .card__media-svg path:nth-child(3) {
        animation-delay: 0.16s;
      }

      /* Card Header / Details */
      .trending-card .card__header {
        position: relative;
        padding-right: 28px;
        margin-top: auto;
      }

      .trending-card .card__header-title {
        font-family: var(--font-heading, 'Playfair Display', serif);
        font-size: 1.15rem;
        font-weight: 400;
        letter-spacing: 0.5px;
        color: #ffffff;
        margin: 0 0 3px 0;
        line-height: 1.2;
        transition: color 0.2s ease;
      }

      .trending-card:hover .card__header-title,
      .trending-card:active .card__header-title {
        color: #f5f5f5;
      }

      .trending-card .card__header-meta {
        font-size: 0.72rem;
        color: #999999;
        margin: 0;
        line-height: 1.35;
        letter-spacing: 0.3px;
        font-weight: 300;
      }

      /* Header Arrow Icon (from snippet) */
      .trending-card .card__header-icon {
        opacity: 0;
        position: absolute;
        right: 0;
        top: 50%;
        margin-top: -10px;
        transform: translateX(-12px);
        width: 20px;
        height: 20px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .trending-card .card__header-icon svg {
        width: 18px;
        height: 18px;
      }

      .trending-card:hover .card__header-icon,
      .trending-card:active .card__header-icon {
        opacity: 1;
        transform: translateX(0);
      }

      @media (min-width: 860px) {
        .trending-section {
          max-width: 1140px;
          margin: 44px auto 32px auto;
          padding: 0 24px;
        }

        .trending-header {
          padding: 0;
        }

        .trending-rail {
          padding: 8px 0 24px 0;
          gap: 20px;
        }

        .trending-card {
          width: 250px;
        }
      }
    </style>
</BaseLayout>
