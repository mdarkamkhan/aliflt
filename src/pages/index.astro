---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const offers = await getCollection('offers');
const products = await getCollection('products');
const services = await getCollection('services');
const works = await getCollection('works');
const designs = await getCollection('designs');

const recentOffers = [...offers].reverse();
const recentServices = [...services].reverse().slice(0, 5);
const recentWorks = [...works].reverse().slice(0, 5);
const recentDesigns = [...designs].reverse().slice(0, 5);

// Get distinct category highlights for products
const seenCategories = new Set();
const highlightedProducts = [];
for (const p of [...products].reverse()) {
  const cat = (p.data.category || '').toLowerCase();
  if (cat && !seenCategories.has(cat)) {
    seenCategories.add(cat);
    highlightedProducts.push(p);
  }
}
---

<BaseLayout title="Home" description="Custom bridal blouses, lehengas, gowns — premium ladies tailoring in Sahibganj.">
    <!-- Top Offers Banner -->
    <div id="top-banner">
        <div class="swapper-container banner-swapper">
            {recentOffers.map((item, index) => (
                <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                    <img src={item.data.image} alt={item.data.title || 'Advertisement'} />
                </div>
            ))}
            {recentOffers.length === 0 && (
                <p class="empty-gallery-message">Welcome to ALiF Ladies Tailor.</p>
            )}
        </div>
    </div>

    <!-- Scroll-Driven 3D Laptop Welcome Showcase (from ELEMENTS/welcome) -->
    <div class="laptop-scroll-track" id="welcomeScrollTrack">
        <div class="laptop-sticky-stage" id="welcomeStickyStage">
            <div class="laptop-stage-header">
                <span class="laptop-eyebrow">ALIF ATELIER EXPERIENCE</span>
                <span class="laptop-status-hint" id="laptopStatusHint">SCROLL TO OPEN</span>
            </div>

            <div class="laptop-viewport-wrap">
                <div class="laptop" id="laptopBody">
                    <div class="screen" id="laptopScreen">
                        <div class="header"></div>
                        <div class="screen-content">
                            <span class="screen-brand">ALiF</span>
                            <div class="text">Welcome to ALiF</div>
                            <span class="screen-sub">Bespoke Ladies Tailor • Sahibganj</span>
                        </div>
                    </div>
                    <div class="keyboard"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Showcase Panel -->
    <a href="/products/" class="prada-panel">
        <div class="blob blob-products" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Products</div>
            <div class="swapper-container products-panel-gallery">
                {highlightedProducts.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image} alt={item.data.title} />
                    </div>
                ))}
                {highlightedProducts.length === 0 && (
                    <p class="empty-gallery-message">Products coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Products">
                <span class="hover-underline-animation">Shop Now</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Tailoring Services Showcase Panel -->
    <a href="/services/" class="prada-panel">
        <div class="blob blob-services" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Services</div>
            <div class="swapper-container services-panel-gallery">
                {recentServices.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title} />
                    </div>
                ))}
                {recentServices.length === 0 && (
                    <p class="empty-gallery-message">Services coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Services">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Our Works Showcase Panel -->
    <a href="/works/" class="prada-panel">
        <div class="blob blob-works" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Works</div>
            <div class="swapper-container works-panel-gallery">
                {recentWorks.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title || 'Our Work'} />
                    </div>
                ))}
                {recentWorks.length === 0 && (
                    <p class="empty-gallery-message">Our work coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Works">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <!-- Designs Showcase Panel -->
    <a href="/designs/" class="prada-panel">
        <div class="blob blob-designs" aria-hidden="true"></div>
        <div class="panel-inner-bg">
            <div class="prada-panel-label">ALiF Designs</div>
            <div class="swapper-container designs-panel-gallery">
                {recentDesigns.map((item, index) => (
                    <div class={`swapper-item ${index === 0 ? 'active' : ''}`}>
                        <img src={item.data.image || '/icons/icon-512x512.png'} alt={item.data.title || 'Design'} />
                    </div>
                ))}
                {recentDesigns.length === 0 && (
                    <p class="empty-gallery-message">Designs coming soon.</p>
                )}
            </div>
            <div class="panel-explore-btn cta" aria-label="Explore Designs">
                <span class="hover-underline-animation">Explore</span>
                <svg id="arrow-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 46 16">
                    <path id="Path_10" data-name="Path 10" d="M8,0,6.545,1.455l5.506,5.506H-30V9.039H12.052L6.545,14.545,8,16l8-8Z" transform="translate(30)" />
                </svg>
            </div>
        </div>
    </a>

    <script is:inline>
        // Swapper slideshow logic synchronized with 5s blob-bounce orbit
        function initSwappers() {
            if (window._swappersInitialized) return;
            window._swappersInitialized = true;

            const containers = document.querySelectorAll('.swapper-container');
            containers.forEach(container => {
                const items = container.querySelectorAll('.swapper-item');
                if (items.length <= 1) return;
                let current = 0;
                setInterval(() => {
                    items[current].classList.remove('active');
                    current = (current + 1) % items.length;
                    items[current].classList.add('active');
                }, 5000); // Exactly 5000ms = 1 full round of blob orbit (5s)
            });
        }
        // Scroll-driven 3D laptop opening with screen-locking
        function initLaptopScroll() {
            const track = document.getElementById('welcomeScrollTrack');
            const screen = document.getElementById('laptopScreen');
            const statusHint = document.getElementById('laptopStatusHint');
            if (!track || !screen) return;

            let ticking = false;

            function updateLaptop() {
                const rect = track.getBoundingClientRect();
                const windowH = window.innerHeight;
                const totalScrollable = track.offsetHeight - windowH;

                if (totalScrollable <= 0) {
                    ticking = false;
                    return;
                }

                // Calculate progress from 0 (when track top reaches 60px sticky top) to 1 (when track ends)
                const stickyTop = 60;
                const scrolledPast = -(rect.top - stickyTop);
                const progress = Math.min(Math.max(scrolledPast / (totalScrollable - stickyTop), 0), 1);

                // Smooth angle from -88.5deg (closed) to 0deg (open)
                const angle = -88.5 * (1 - progress);
                const perspective = 1900 - 900 * progress;

                screen.style.transform = `perspective(${perspective}px) rotateX(${angle}deg)`;

                // Screen backlight illumination
                const backlight = Math.min(Math.max((progress - 0.05) / 0.4, 0), 1);
                screen.style.filter = `brightness(${0.25 + 0.75 * backlight})`;

                if (statusHint) {
                    if (progress <= 0.02) {
                        statusHint.textContent = "SCROLL TO OPEN";
                        statusHint.style.color = "#888888";
                    } else if (progress < 0.95) {
                        statusHint.textContent = `OPENING • ${Math.round(progress * 100)}%`;
                        statusHint.style.color = "#111111";
                    } else {
                        statusHint.textContent = "WELCOME TO ALIF ATELIER";
                        statusHint.style.color = "#111111";
                    }
                }

                ticking = false;
            }

            function onScroll() {
                if (!ticking) {
                    requestAnimationFrame(updateLaptop);
                    ticking = true;
                }
            }

            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
            updateLaptop();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initSwappers();
                initLaptopScroll();
            });
        } else {
            initSwappers();
            initLaptopScroll();
        }
    </script>

    <style>
      /* --- SCROLL-DRIVEN 3D LAPTOP SHOWCASE (from ELEMENTS/welcome) --- */
      .laptop-scroll-track {
        position: relative;
        width: 100%;
        height: 190vh; /* Smooth virtual scroll distance */
        margin: 10px 0 20px 0;
      }

      .laptop-sticky-stage {
        position: -webkit-sticky;
        position: sticky;
        top: 60px;
        height: calc(100dvh - 75px);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        box-sizing: border-box;
        padding: 16px;
        z-index: 10;
      }

      .laptop-stage-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        margin-bottom: 24px;
        text-align: center;
      }

      .laptop-eyebrow {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 2.5px;
        text-transform: uppercase;
        color: #888888;
      }

      .laptop-status-hint {
        font-family: var(--font-body, 'Poppins', sans-serif);
        font-size: 0.72rem;
        font-weight: 500;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: #111111;
        background: rgba(0, 0, 0, 0.05);
        border: 1px solid rgba(0, 0, 0, 0.08);
        padding: 4px 14px;
        border-radius: 100px;
        transition: all 0.25s ease;
      }

      .laptop-viewport-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        perspective: 2000px;
        padding: 10px 0;
      }

      /* Mobile First Responsive Scaling */
      .laptop {
        position: relative;
        width: 620px;
        display: flex;
        flex-direction: column;
        align-items: center;
        transform-origin: center center;
        transform: scale(var(--laptop-scale, 0.52));
        transition: transform 0.2s ease;
      }

      @media (max-width: 374px) {
        .laptop {
          --laptop-scale: 0.46;
        }
      }

      @media (min-width: 375px) and (max-width: 440px) {
        .laptop {
          --laptop-scale: 0.54;
        }
      }

      @media (min-width: 441px) and (max-width: 650px) {
        .laptop {
          --laptop-scale: 0.62;
        }
      }

      @media (min-width: 651px) and (max-width: 859px) {
        .laptop {
          --laptop-scale: 0.74;
        }
      }

      @media (min-width: 860px) {
        .laptop-scroll-track {
          height: 220vh;
        }

        .laptop {
          --laptop-scale: 0.85;
        }
      }

      /* --- SCREEN (from ELEMENTS/welcome) --- */
      .screen {
        border-radius: 20px;
        box-shadow: inset 0 0 0 2px #c8cacb, inset 0 0 0 10px #000;
        height: 318px;
        width: 518px;
        margin: 0 auto;
        padding: 9px 9px 23px 9px;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background-image: linear-gradient(15deg,
                #3f51b1 0%,
                #5a55ae 13%,
                #7b5fac 25%,
                #8f6aae 38%,
                #a86aa4 50%,
                #cc6b8e 62%,
                #f18271 75%,
                #f3a469 87%,
                #f7c978 100%);
        transform-style: preserve-3d;
        transform: perspective(1900px) rotateX(-88.5deg);
        transform-origin: 50% 100%;
        box-sizing: border-box;
        overflow: hidden;
        will-change: transform, filter;
      }

      .screen::before {
        content: "";
        width: 518px;
        height: 12px;
        position: absolute;
        background: linear-gradient(#979899, transparent);
        top: -3px;
        transform: rotateX(90deg);
        border-radius: 5px 5px;
      }

      .screen::after {
        background: linear-gradient(to bottom, #272727, #0d0d0d);
        border-radius: 0 0 20px 20px;
        bottom: 2px;
        content: "";
        height: 24px;
        left: 2px;
        position: absolute;
        width: 514px;
      }

      .header {
        width: 100px;
        height: 12px;
        position: absolute;
        background-color: #000;
        top: 10px;
        left: 50%;
        transform: translate(-50%, 0);
        border-radius: 0 0 6px 6px;
        z-index: 5;
      }

      .screen-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        z-index: 4;
        padding: 0 20px;
      }

      .screen-brand {
        font-family: var(--font-heading, 'Playfair Display', serif);
        font-size: 2.2rem;
        font-weight: 400;
        letter-spacing: 5px;
        color: #ffffff;
        text-shadow: 0 2px 14px rgba(0, 0, 0, 0.4);
        margin-bottom: 6px;
        line-height: 1;
      }

      .text {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
            Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
        color: #fff;
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: 1.5px;
        text-shadow: 0 0 8px rgba(255, 255, 255, 0.7);
        margin-bottom: 6px;
      }

      .screen-sub {
        font-size: 0.72rem;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
      }

      /* --- KEYBOARD (from ELEMENTS/welcome) --- */
      .keyboard {
        background: radial-gradient(circle at center, #e2e3e4 85%, #a9abac 100%);
        border: solid #a0a3a7;
        border-radius: 2px 2px 12px 12px;
        border-width: 1px 2px 0 2px;
        box-shadow: inset 0 -2px 8px 0 #6c7074;
        height: 24px;
        margin-top: -10px;
        position: relative;
        width: 620px;
        z-index: 9;
      }

      .keyboard::after {
        background: #e2e3e4;
        border-radius: 0 0 10px 10px;
        box-shadow: inset 0 0 4px 2px #babdbf;
        content: "";
        height: 10px;
        left: 50%;
        margin-left: -60px;
        position: absolute;
        top: 0;
        width: 120px;
      }

      .keyboard::before {
        background: 0 0;
        border-radius: 0 0 3px 3px;
        bottom: -2px;
        box-shadow: -270px 0 #272727, 250px 0 #272727;
        content: "";
        height: 2px;
        left: 50%;
        margin-left: -10px;
        position: absolute;
        width: 40px;
      }
    </style>
</BaseLayout>
