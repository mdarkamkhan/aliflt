---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import reelsData from '../data/reels.json';

const products = await getCollection('products');
const services = await getCollection('services');
const works = await getCollection('works');
const designs = await getCollection('designs');

// Top Editorial Banners from banner folder
const topBanners = [
  {
    image: '/banner/banner-1.webp',
    title: 'Contemporary Fashion Promotion'
  },
  {
    image: '/banner/banner-2.webp',
    title: 'Winter Atelier Fashion Collection'
  },
  {
    image: '/banner/banner-3.webp',
    title: 'Modern Fashion Coming Soon'
  },
  {
    image: '/banner/banner-4.webp',
    title: 'Modern Fashion Sale'
  }
];
const recentServices = [...services].reverse().slice(0, 5);
const recentWorks = [...works].reverse().slice(0, 5);
const recentDesigns = [...designs].reverse().slice(0, 5);

// Strict date sorting: newest/latest uploaded products first
const sortedProductsByDate = [...products].sort((a, b) => {
  const dA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dB - dA;
});

// Get distinct category highlights for products (newest first)
const seenCategories = new Set();
const highlightedProducts = [];
for (const p of sortedProductsByDate) {
  const cat = (p.data.category || '').toLowerCase();
  if (cat && !seenCategories.has(cat)) {
    seenCategories.add(cat);
    highlightedProducts.push(p);
  }
}

// Latest products for swipe showcase (10 latest uploads)
const latestProducts = sortedProductsByDate.slice(0, 10);

// 9 preview images for the 9-frame collection end card (from latest products)
const collectionPreviewImages = sortedProductsByDate
  .map((p) => p.data.image)
  .filter(Boolean)
  .slice(0, 9);
while (collectionPreviewImages.length < 9 && collectionPreviewImages.length > 0) {
  collectionPreviewImages.push(collectionPreviewImages[collectionPreviewImages.length % collectionPreviewImages.length]);
}
if (collectionPreviewImages.length === 0) {
  for (let i = 0; i < 9; i++) {
    collectionPreviewImages.push('/icons/icon-512x512.png');
  }
}

// 4 Store Routes Guide (Images & Videos support)
const storeRoutes = [
  {
    id: 'railway-station',
    title: 'Railway Station to alif.',
    type: 'image', // 'video' or 'image'
    video: null,
    image: '/uploads/categories/dress-set.jpg',
  },
  {
    id: 'sahibganj-college',
    title: 'Sahibganj College to alif.',
    type: 'image', // 'video' or 'image'
    video: null,
    image: '/uploads/services/lehenga.webp',
  },
  {
    id: 'daal-kuan',
    title: 'Daal Kuan to alif.',
    type: 'image', // 'video' or 'image'
    video: null,
    image: '/uploads/services/anarkali.webp',
  },
  {
    id: 'ghaat-road',
    title: 'Ghaat Road to alif.',
    type: 'image', // 'video' or 'image'
    video: null,
    image: '/uploads/services/sharara.webp',
  },
];

// 6 Atelier Directory Cards (Products, Services, Reels, Contact, Works, Dress Set)
const atelierDirectoryCards = [
  { title: 'Products', url: '/products/', image: '/uploads/categories/plain-fabrics.jpg' },
  { title: 'Services', url: '/services/', image: '/uploads/services/lehenga.webp' },
  { title: 'Reels', url: '/reels/', id: 'dirCardReels', image: '/uploads/services/anarkali.webp' },
  { title: 'Contact', url: '/contact-us/', image: '/uploads/alif-poster.webp' },
  { title: 'Works', url: '/works/', image: '/uploads/1000019607.webp' },
  { title: 'Curated Sets', url: '/products/?category=curated-sets', image: '/uploads/categories/dress-set.jpg' },
];

// Curated editorial services for the showcase (Hero poster + 2 sub cards)
const lehengaService = services.find((s) => s.id === 'lehenga') || services[0];
const anarkaliService = services.find((s) => s.id === 'anarkali') || services[1];
const shararaService = services.find((s) => s.id === 'sharara') || services[2];

// Curated trending reels: Mix of featured product sets (Curated Sets) & bespoke tailoring services
const trendingProductReels = sortedProductsByDate
  .filter((p) => {
    const cat = (p.data.category || '').toLowerCase();
    const hasCombo = p.data.combo_items && p.data.combo_items.length > 0;
    return cat === 'curated sets' || cat === 'curated set' || cat === 'dress set' || hasCombo || p.data.reel_video;
  })
  .slice(0, 4)
  .map((p) => {
    const finalPrice = p.data.offer_price || p.data.price;
    const comboPieces = p.data.combo_items || [];

    // Pure product images for the left side (NO info/details)
    let productImages = [];
    if (comboPieces.length > 0) {
      if (p.data.image) {
        productImages.push({ image: p.data.image, name: p.data.title });
      }
      comboPieces.forEach((piece) => {
        if (piece.image && (!p.data.image || piece.image !== p.data.image)) {
          productImages.push({ image: piece.image, name: piece.name });
        }
      });
    } else {
      productImages.push({
        image: p.data.image || '/icons/icon-512x512.png',
        name: p.data.title
      });
    }

    return {
      id: p.id,
      type: 'product',
      title: p.data.title,
      category: p.data.category || 'Curated Sets',
      image: p.data.image,
      video: p.data.reel_video || null,
      priceText: `₹${finalPrice}`,
      url: `/products/${p.id}/`,
      badge: 'PRODUCT',
      cta: 'Shop Now',
      productImages: productImages
    };
  });

const trendingServiceReels = services
  .filter((s) => s.data.reel_video)
  .slice(0, 4)
  .map((s) => ({
    id: s.id,
    type: 'service',
    title: s.data.title,
    category: s.data.category || 'Tailoring',
    image: s.data.image,
    video: s.data.reel_video,
    priceText: s.data.price ? `From ₹${s.data.price}` : 'Custom Fit',
    url: `/services/${s.id}/`,
    badge: 'STITCHING',
    cta: 'Book Stitching',
    taggedProduct: null
  }));

// Build product maps and curated sets index
const productsMap = new Map(products.map((p) => [p.id, p]));
const productsByCode = new Map(products.map((p) => [p.data.product_code, p]));

const curatedSetsByReelId = new Map();
products.forEach((p) => {
  const cat = (p.data.category || '').toLowerCase();
  if (cat === 'curated sets' || cat === 'curated set' || cat === 'dress set') {
    if (p.data.linked_reel_id) {
      curatedSetsByReelId.set(p.data.linked_reel_id, p);
    }
  }
});

function resolveCuratedSetForReel(reelId, slug, code) {
  const setProduct = (slug && productsMap.get(slug))
    || (reelId && curatedSetsByReelId.get(reelId))
    || (code && productsByCode.get(code));

  if (!setProduct) return null;

  const rawCombo = setProduct.data.combo_products || setProduct.data.combo_items || [];
  const items = rawCombo.map((item) => {
    const itemId = typeof item === 'string' ? item : (item.id || item.slug);
    const prod = productsMap.get(itemId) 
      || productsByCode.get(itemId)
      || products.find(p => p.id === itemId || p.id.includes(itemId) || (p.data.product_code && p.data.product_code.toLowerCase() === itemId.toLowerCase()));

    if (prod) {
      return {
        id: prod.id,
        title: prod.data.title,
        category: (prod.data.category || 'Piece').toUpperCase(),
        image: prod.data.image,
      };
    }

    let cleanCategory = 'PIECE';
    const low = itemId.toLowerCase();
    if (low.includes('fabric') || low.includes('crape') || low.includes('silk')) cleanCategory = 'FABRIC';
    else if (low.includes('latkan') || low.includes('tassel')) cleanCategory = 'LATKAN';
    else if (low.includes('lace') || low.includes('border')) cleanCategory = 'LACE';
    else if (low.includes('dupatta')) cleanCategory = 'DUPATTA';

    return {
      id: itemId,
      title: itemId,
      category: cleanCategory,
      image: null,
    };
  }).filter(Boolean);

  return {
    slug: setProduct.id,
    title: setProduct.data.title,
    price: setProduct.data.offer_price || setProduct.data.price,
    origPrice: setProduct.data.price,
    category: 'DRESS SET',
    url: `/products/${setProduct.id}/`,
    items: items.slice(0, 4) // Show up to 4 portrait mini cards
  };
}

// Cloudinary / Uploaded Reels Priority for Homepage with Curated Set Linking
const uploadedReelsList = (reelsData || []).map((r, idx) => {
  const reelId = r.id || `reel-${idx + 1}`;
  const curatedSet = resolveCuratedSetForReel(reelId, r.curated_set_slug, r.curated_set_code);

  return {
    id: reelId,
    reelNumber: idx + 1,
    type: 'reel',
    title: `Reel #${idx + 1}`,
    internalTitle: r.title || `Reel #${idx + 1}`,
    category: 'Atelier Reel',
    image: r.poster || r.image || '/icons/icon-512x512.png',
    video: r.video,
    priceText: curatedSet ? `₹${curatedSet.price}` : null,
    url: curatedSet ? curatedSet.url : `/reels/#reel-${reelId}`,
    badge: 'REEL',
    cta: curatedSet ? 'SHOW PRODUCT' : 'Watch Reel',
    curatedSet: curatedSet
  };
});

const fallbackReels = [];
const homeMax = Math.max(trendingProductReels.length, trendingServiceReels.length);
for (let i = 0; i < homeMax; i++) {
  if (i < trendingProductReels.length) fallbackReels.push(trendingProductReels[i]);
  if (i < trendingServiceReels.length) fallbackReels.push(trendingServiceReels[i]);
}

const homepageReelItems = uploadedReelsList.length > 0 ? uploadedReelsList.slice(0, 8) : fallbackReels;


---

<BaseLayout title="Home" description="Custom bridal blouses, lehengas, gowns — premium ladies tailoring in Sahibganj.">
    <!-- Top Editorial Banners with Thin Navigation (< >) & No Auto Slide -->
    <div id="top-banner" class="top-banner-wrapper">
        <div class="banner-carousel" id="mainBannerCarousel">
            {topBanners.map((item, index) => (
                <div class={`banner-slide-item ${index === 0 ? 'active' : ''}`} data-index={index}>
                    <picture>
                      <source srcset={item.image} type="image/webp" />
                      <img 
                        src={item.image} 
                        alt={item.title} 
                        width="1400"
                        height="1980"
                        decoding="async"
                        loading={index === 0 ? "eager" : "lazy"} 
                        fetchpriority={index === 0 ? "high" : "auto"}
                      />
                    </picture>
                </div>
            ))}
        </div>

        <!-- Thin Slide Navigation Buttons (< >) -->
        <button 
          type="button" 
          class="banner-thin-nav-btn banner-btn-prev" 
          id="bannerSlidePrev" 
          aria-label="Previous Banner"
          title="Previous Banner"
        >
          <svg viewBox="0 0 24 24" width="26" height="26" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <button 
          type="button" 
          class="banner-thin-nav-btn banner-btn-next" 
          id="bannerSlideNext" 
          aria-label="Next Banner"
          title="Next Banner"
        >
          <svg viewBox="0 0 24 24" width="26" height="26" stroke="currentColor" stroke-width="1.2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <!-- Minimalist Slide Counter (e.g. 01 / 04) -->
        <div class="banner-slide-indicator" id="bannerSlideIndicator">
          <span class="indicator-current" id="bannerCurrentIdx">01</span>
          <span class="indicator-sep">/</span>
          <span class="indicator-total">0{topBanners.length}</span>
        </div>
    </div>


    <!-- Trending Reels Section (Native Horizontal Swipe Showcase) -->
    <section class="trending-reels-section" id="reelsSection" aria-label="Trending Reels">
        <div class="reels-header">
            <div class="reels-title-row">
                <h2 class="reels-title">TRENDING REELS</h2>
                <a href="/reels/" data-astro-prefetch="viewport" class="reels-view-all">View&nbsp;All&nbsp;<span class="view-all-arrow">→</span></a>
            </div>
        </div>

        <div class="reels-cards-viewport" id="reelsCardsViewport">
            <div class="reels-cards-track" id="reelsCardsTrack">
                {homepageReelItems.map((item) => (
                    <div class="reel-card" data-reel-id={item.id} data-reel-type={item.type}>
                        <div class="reel-media-inner">
                            <video 
                                data-src={item.video} 
                                poster={item.image}
                                loop 
                                muted 
                                playsinline 
                                webkit-playsinline
                                preload="none"
                                class="reel-video"
                            ></video>

                            <!-- Top Header: Title on Left, Persistent Audio Pill on Right -->
                            <div class="reel-top-bar">
                                <div class="reel-top-row">
                                    <h3 class="reel-top-title">{item.title}</h3>
                                    <button type="button" class="reel-audio-pill sound-muted" aria-label="Toggle Sound" onclick="event.stopPropagation();" title="Toggle Sound">
                                        <!-- Sound ON Icon -->
                                        <svg class="audio-icon icon-vol-on" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                            <path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                                        </svg>
                                        <!-- Sound OFF (Muted) Icon -->
                                        <svg class="audio-icon icon-vol-mute" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                            <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                                        </svg>
                                    </button>
                                </div>
                                <div class="reel-title-divider" aria-hidden="true"></div>
                            </div>

                            <!-- Center Audio & Play/Pause Controller (Ultra-thin Frosted Glass Ring) -->
                            <button type="button" class="reel-center-ctrl state-mute" aria-label="Audio and Playback Control">
                                <svg class="center-icon icon-mute" viewBox="0 0 24 24" width="26" height="26" fill="currentColor">
                                    <path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>
                                </svg>
                                <svg class="center-icon icon-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor">
                                    <rect x="7" y="5" width="2.5" height="14" rx="1.2" />
                                    <rect x="14.5" y="5" width="2.5" height="14" rx="1.2" />
                                </svg>
                                <svg class="center-icon icon-play" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
                                    <path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l11-6.86a1 1 0 0 0 0-1.72l-11-6.86a1 1 0 0 0-1.5.86z"/>
                                </svg>
                            </button>

                            {item.curatedSet ? (
                                <a 
                                    href={item.curatedSet.url}
                                    data-astro-prefetch="viewport"
                                    class="reel-curated-strip" 
                                    onclick="event.stopPropagation();"
                                    aria-label={`View Curated Set - ${item.curatedSet.title}`}
                                >
                                    {/* Left: 3:4 Tall Portrait Mini Cards */}
                                    <div class="rc-items-row">
                                        {item.curatedSet.items.map((piece) => (
                                            <div class="rc-mini-card" title={piece.title}>
                                                {piece.image ? (
                                                    <img src={piece.image} alt={piece.title} loading="lazy" />
                                                ) : (
                                                    <div class="rc-mini-fallback">
                                                        <span>{piece.category}</span>
                                                    </div>
                                                )}
                                            </div>
                                        ))}
                                    </div>

                                    {/* Vertical Divider */}
                                    <div class="rc-strip-divider" aria-hidden="true"></div>

                                    {/* Right: Set Tag & Sharp Editorial Action Button */}
                                    <div class="rc-action-col">
                                        <span class="rc-set-tag">DRESS SET</span>
                                        <span class="rc-action-btn">
                                            <span>SHOW PRODUCT</span>
                                            <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                                <polyline points="12 5 19 12 12 19"></polyline>
                                            </svg>
                                        </span>
                                    </div>
                                </a>
                            ) : (
                                <div class="reel-bottom-bar">
                                    <a 
                                        href={`/reels/#reel-${item.id}`} 
                                        data-astro-prefetch="viewport"
                                        class="reel-minimal-cta" 
                                        onclick="event.stopPropagation();"
                                        aria-label={`Watch All Reels - ${item.internalTitle || item.title}`}
                                    >
                                        <span>WATCH ALL</span>
                                        <svg class="reel-minimal-arrow" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                            <polyline points="12 5 19 12 12 19"></polyline>
                                        </svg>
                                    </a>
                                </div>
                            )}
                        </div>
                    </div>
                ))}

                <!-- 9-Grid Blurred Reel Watch All Card -->
                <a href="/reels/" data-astro-prefetch="viewport" class="reel-card reel-watch-all-card" aria-label="Watch All Reels">
                    <div class="reel-media-inner">
                        <div class="reel-grid-9">
                            {[1, 2, 3, 4, 5, 6, 7, 8, 9].map((n, i) => {
                                const gridReel = reelsData && reelsData[i];
                                return (
                                    <div class="mini-reel-cell">
                                        {gridReel ? (
                                            <img 
                                                src={gridReel.poster || gridReel.image || '/icons/icon-512x512.png'} 
                                                alt="" 
                                                loading="lazy" 
                                                class="mini-reel-img" 
                                                style="width: 100%; height: 100%; object-fit: cover; display: block;"
                                            />
                                        ) : (
                                            <div class="mini-reel-placeholder"></div>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                        <div class="watch-all-overlay">
                            <div class="watch-all-btn-content">
                                <div class="watch-all-icon-circle">
                                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                                        <polygon points="6 4 20 12 6 20 6 4"></polygon>
                                    </svg>
                                </div>
                                <span class="watch-all-title">Watch All</span>
                                <span class="watch-all-sub">
                                    EXPLORE REELS
                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                        <polyline points="12 5 19 12 12 19"></polyline>
                                    </svg>
                                </span>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════
         FEATURED CATEGORIES — 3×2 Product Categories Grid
    ═══════════════════════════════════════════════════════ -->
    <section class="featured-categories-section" id="featuredCategories" aria-label="Featured Categories">
        <div class="fc-header">
            <div class="fc-title-row">
                <h2 class="fc-title">FEATURED CATEGORIES</h2>
                <a href="/products/" class="fc-view-all">View&nbsp;All&nbsp;<span class="view-all-arrow">→</span></a>
            </div>
        </div>

        <div class="fc-grid">
            <a href="/products/?category=curated-sets" class="fc-card" aria-label="Curated Sets">
                <div class="fc-img-wrap">
                    <img src="/uploads/categories/dress-set.jpg" alt="Curated Sets" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Curated Sets</span>
                </div>
            </a>

            <a href="/products/?category=lace" class="fc-card" aria-label="Lace">
                <div class="fc-img-wrap">
                    <img src="/uploads/1763829381470-1000026101.webp" alt="Lace" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Lace</span>
                </div>
            </a>

            <a href="/products/?category=latkan" class="fc-card" aria-label="Latkan">
                <div class="fc-img-wrap">
                    <img src="/uploads/1764952750414-0-1000026916.webp" alt="Latkan" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Latkan</span>
                </div>
            </a>

            <a href="/products/?category=fabrics" class="fc-card" aria-label="Fabrics">
                <div class="fc-img-wrap">
                    <img src="/uploads/1765191764673-gal-1-1000027645.webp" alt="Fabrics" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Fabrics</span>
                </div>
            </a>

            <a href="/products/?category=plain-fabrics" class="fc-card" aria-label="Plain Fabrics">
                <div class="fc-img-wrap">
                    <img src="/uploads/categories/plain-fabrics.jpg" alt="Plain Fabrics" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Plain Fabrics</span>
                </div>
            </a>

            <a href="/products/?category=tailoring-material" class="fc-card" aria-label="Tailoring Material">
                <div class="fc-img-wrap">
                    <img src="/uploads/categories/tailoring-material.jpg" alt="Tailoring Material" loading="lazy" />
                </div>
                <div class="fc-label">
                    <span>Tailoring Material</span>
                </div>
            </a>
        </div>
    </section>

    <!-- Latest Collection Horizontal Swipe Showcase (Standardized Product Cards) -->
    <section class="latest-collection-section" id="collectionSection" aria-label="Latest Collection">
        <div class="collection-header">
            <div class="collection-title-row">
                <h2 class="collection-title">LATEST COLLECTION</h2>
