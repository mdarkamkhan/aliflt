      letter-spacing: 2px;
      font-family: var(--font-body, 'Ubuntu', sans-serif);
      font-size: 0.88rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s ease;
      box-sizing: border-box;
      border-radius: 4px;
