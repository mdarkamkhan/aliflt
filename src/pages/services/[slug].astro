    /* Haute Couture 2-column Atelier Specifications */
    .spec-row-wrapper {
      display: grid !important;
      grid-template-columns: 1fr !important;
      gap: 0 !important;
      width: 100% !important;
    }

    @media (min-width: 768px) {
