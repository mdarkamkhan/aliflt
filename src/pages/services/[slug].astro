---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { service: entry },
  }));
}

const { service } = Astro.props;
const { title, price, category, image, description, service_information } = service.data;

const allServices = await getCollection('services');
const similarServices = allServices.filter((s) => s.id !== service.id && s.data.category === category);
const otherServices = allServices.filter((s) => s.id !== service.id).slice(0, 8);

const displaySimilar = similarServices.length > 0 ? similarServices : otherServices;

const wappText = `Hello ALiF, I would like to book the '${title}' service.`;
const wappLink = `https://wa.me/7250470009?text=${encodeURIComponent(wappText)}`;
---

<BaseLayout 
  title={`${title} Custom Stitching`} 
  description={description || `Book custom boutique tailoring for ${title} at ALiF Ladies Tailor, Sahibganj.`}
  image={image}
>
  <div class="container section">
    <div class="product-detail-grid">

      <div class="product-detail-image">
        {image ? (
          <div style="aspect-ratio: 9 / 16; overflow: hidden; border: 1px solid #e8e8e8; background: #e9eaec;">
            <img src={image} alt={title} style="width:100%; height:100%; object-fit:cover; object-position: center top; display:block;" />
          </div>
        ) : (
          <div style="width: 100%; aspect-ratio: 9 / 16; background: radial-gradient(circle at center, #1f1f1f 0%, #0a0a0a 100%); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; text-align: center; position: relative; border: 1px solid #222;">
            <div style="position: absolute; inset: 16px; border: 1px solid rgba(255,255,255,0.08); pointer-events: none;"></div>
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.85; margin-bottom: 14px; color: #fff;">
              <circle cx="6" cy="6" r="3"></circle>
              <circle cx="6" cy="18" r="3"></circle>
              <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
              <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
              <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
            </svg>
            <span style="font-family: var(--font-heading); font-size: 1.6rem; letter-spacing: 3px; text-transform: uppercase; color: #fff; font-weight: 500;">ALiF</span>
            <span style="display: block; width: 30px; height: 1px; background: rgba(255,255,255,0.25); margin: 10px 0;"></span>
            <span style="font-family: var(--font-body); font-size: 0.75rem; letter-spacing: 2px; color: #aaa; text-transform: uppercase;">BOUTIQUE &amp; TAILORING</span>
          </div>
        )}
      </div>

      <div class="product-detail-info" style="display: flex; flex-direction: column; justify-content: center;">
        <h1 class="product-detail-title">{title}</h1>

        {price && (
          <p class="product-detail-price">
            Starting from ₹{price}
          </p>
        )}

        {category && (
          <p class="product-detail-category" style="color:#888; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; margin-top: 0;">
            {category}
          </p>
        )}

        <div class="product-detail-actions" style="display: flex; flex-direction: column; gap: 15px; margin-top: 30px;">
          <a 
            href={wappLink}
            target="_blank" 
            rel="noopener noreferrer"
            style="display: block; width: 100%; background-color: #000; color: #fff; text-align: center; padding: 18px 0; text-decoration: none; text-transform: uppercase; letter-spacing: 2px; font-size: 0.9rem; font-weight: 500; border: 1px solid #000; transition: all 0.3s ease; cursor: pointer;"
            onmouseover="this.style.backgroundColor='#fff'; this.style.color='#000';"
            onmouseout="this.style.backgroundColor='#000'; this.style.color='#fff';"
          >
            BOOK SERVICE VIA WHATSAPP
          </a>
          
          <p style="text-align: center; font-size: 0.75rem; color: #777; margin-top: 10px; font-style: italic;">
            * Measurements &amp; custom detailing discussed directly with master tailor
          </p>
        </div>
      </div>

    </div>
  </div>

  <div class="product-accordion-container" style="margin-top: 40px;">
    {service_information && (
      <details class="accordion-item" open>
        <summary class="accordion-summary">
          <h3 class="accordion-heading">Service Details &amp; Customization</h3>
          <span class="accordion-caret">^</span>
        </summary>
        <div class="accordion-content">
          <pre style="font-family: var(--font-body); font-size: 0.88rem; line-height: 1.8; color: #444; white-space: pre-wrap; margin: 0; padding: 15px 0;">{service_information}</pre>
        </div>
      </details>
    )}

    {description && (
      <details class="accordion-item">
        <summary class="accordion-summary">
          <h3 class="accordion-heading">Overview</h3>
          <span class="accordion-caret">^</span>
        </summary>
        <div class="accordion-content">
          <p class="accordion-description-text" style="padding: 15px 0; font-size: 0.9rem; line-height: 1.6; color: #555;">
            {description}
          </p>
        </div>
      </details>
    )}
  </div>

  <!-- Related Tailoring Services Carousel -->
  <div class="section" style="padding: 40px 20px; background: #fcfcfc; border-top: 1px solid #eee; margin-top: 40px;">
    <h3 style="text-align: center; margin-bottom: 25px; font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 2px;">Other Tailoring Services</h3>
    
    <div style="display: flex; overflow-x: auto; gap: 15px; padding-bottom: 15px; -webkit-overflow-scrolling: touch; scrollbar-width: none;">
      {displaySimilar.map((item) => (
        <a href={`/services/${item.id}/`} style="text-decoration: none; color: #000; min-width: 170px; flex-shrink: 0;">
          <div style="aspect-ratio: 9 / 16; overflow: hidden; margin-bottom: 10px; background: #e9eaec; border: 1px solid #eee;">
            {item.data.image ? (
              <img src={item.data.image} alt={item.data.title} style="width: 100%; height: 100%; object-fit: cover; object-position: center top;" loading="lazy" />
            ) : (
              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #111; color: #fff; font-family: var(--font-heading); letter-spacing: 2px; font-size: 0.85rem;">ALiF</div>
            )}
          </div>
          <p style="margin: 0; font-size: 0.9rem; text-align: center; font-weight: 500;">{item.data.title}</p>
          <p style="margin: 4px 0 0 0; font-size: 0.82rem; text-align: center; color: #666;">Starting ₹{item.data.price}</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
