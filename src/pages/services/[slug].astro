---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import {
  getDetailImageAttrs,
  getCardImageAttrs,
  getThumbUrl,
} from '../../utils/imagePerf';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { service: entry },
  }));
}

const { service } = Astro.props;
const { title, price, category, image, description, service_information } = service.data;

const allServices = await getCollection('services');

// Similar services in the same category or relevant
let similar = allServices.filter((s) => s.id !== service.id && s.data.category === category);
if (similar.length === 0) {
  similar = allServices.filter((s) => s.id !== service.id).slice(0, 8);
} else if (similar.length < 4) {
  const fillers = allServices.filter((s) => s.id !== service.id && s.data.category !== category);
  similar = [...similar, ...fillers].slice(0, 8);
}

// You may also like: other services
const ymal = allServices.filter((s) => s.id !== service.id && !similar.some((sim) => sim.id === s.id)).slice(0, 8);

const wappText = `Hello alif., I want to book custom tailoring for '${title}' (Starting Price: ₹${price || 'Inquire'}).`;
const wappLink = `https://wa.me/7250470009?text=${encodeURIComponent(wappText)}`;

// Parse service_information into clean structured sections without emojis
interface ServiceSection {
  heading: string;
  items: string[];
}

function parseServiceInfo(infoText?: string): ServiceSection[] {
  if (!infoText) return [];
  const lines = infoText.split('\n');
  const sections: ServiceSection[] = [];
  let currentSection: ServiceSection | null = null;

  for (const rawLine of lines) {
    const line = rawLine.trim();
    if (!line) continue;

    // Check if line is a section heading
    if (line.startsWith('✔') || line.startsWith('✓') || line.startsWith('#') || (!line.startsWith('-') && !line.startsWith('•') && line.length < 35 && !line.includes(':'))) {
      const heading = line.replace(/^[✔✓#\s*]+/, '').trim();
      if (heading) {
        currentSection = { heading, items: [] };
        sections.push(currentSection);
      }
    } else if (currentSection) {
      const item = line.replace(/^[-•*]\s*/, '').replace(/^[✔✓]\s*/, '').trim();
      if (item) {
        currentSection.items.push(item);
      }
    } else {
      const item = line.replace(/^[-•*]\s*/, '').replace(/^[✔✓]\s*/, '').trim();
      if (item) {
        currentSection = { heading: 'Service Details', items: [item] };
        sections.push(currentSection);
      }
    }
  }
  return sections;
}

const serviceSections = parseServiceInfo(service_information);
const mainImgAttrs = image ? getDetailImageAttrs(image) : null;
---

<BaseLayout 
  title={`${title} Custom Stitching`} 
  description={description || `Book custom boutique tailoring for ${title} at alif. ladies tailor, Sahibganj.`}
  image={image}
  preloadImage={mainImgAttrs?.src}
  preloadImageSrcset={mainImgAttrs?.srcset}
  preloadImageSizes={mainImgAttrs?.sizes}
>
  <div class="container section">
    <div class="product-detail-grid">

      <!-- Left Column: Main Image Card (Haute Couture Editorial) -->
      <div class="product-detail-image">
        <div class="swapper-container product-swapper" id="mainMediaContainer">
          {image ? (
            <img class="active" {...getDetailImageAttrs(image)} width="768" height="960" fetchpriority="high" decoding="async" alt={title} />
          ) : (
            <div class="luxury-fallback-media">
              <span class="luxury-fallback-brand">alif.</span>
              <span class="luxury-fallback-line"></span>
              <span class="luxury-fallback-tag">ATELIER &amp; BESPOKE TAILORING</span>
            </div>
          )}
        </div>
      </div>

      <!-- Right Column: Service Details & Clean Action Buttons -->
      <div class="product-detail-info">
        <div class="product-header-block">
          {category && (
            <span class="preview-mode-pill">
              {category}
            </span>
          )}
          <h1 class="product-detail-title" id="displayTitle">{title}</h1>
        </div>

        <!-- Dynamic Price Display -->
        <div id="priceSectionWrapper" class="price-section-wrapper">
          <div class="product-detail-price" id="displayStandardPrice">
            <span class="price-prefix">Starting from</span>
            <span class="standard-price">₹{price || '150'}</span>
          </div>
        </div>

        <div class="product-delivery-promo">
          Doorstep measurement &amp; custom fitting consult available in Sahibganj
        </div>

        <!-- Clean Main Action Buttons matching Product Page -->
        <div class="product-detail-actions" id="productDetailActions">
          <a 
            href={wappLink}
            target="_blank" 
            rel="noopener noreferrer"
            class="btn-cart" 
            id="bookServiceBtn"
          >
            Book Service via WhatsApp
          </a>

          <a 
            href="tel:7250470009"
            class="btn-buy"
            id="callMasterTailorBtn"
          >
            Call Atelier (+91 72504 70009)
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Accordions: Description & Specifications (Same design as Product Page) -->
  <div class="product-accordion-container">
    {description && (
      <details class="accordion-item" open>
        <summary class="accordion-summary">
          <h3 class="accordion-heading">Description &amp; Atelier Notes</h3>
          <span class="accordion-toggle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="accordion-content">
          <p class="accordion-description-text" id="displayDescriptionText">{description}</p>
        </div>
      </details>
    )}

    <!-- Composition & Specifications (Standardized Key-Value Table) -->
    <details class="accordion-item" open>
      <summary class="accordion-summary">
        <h3 class="accordion-heading">Composition &amp; Specifications</h3>
        <span class="accordion-toggle-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </span>
      </summary>
      <div class="accordion-content">
        <div class="spec-row-wrapper" id="displaySpecsWrapper">
          <div class="spec-row"><span class="spec-label">Service Type</span><span class="spec-value">{category || 'Bespoke Tailoring'}</span></div>
          <div class="spec-row"><span class="spec-label">Starting Price</span><span class="spec-value">₹{price || '150'}</span></div>
          <div class="spec-row"><span class="spec-label">Craft &amp; Finish</span><span class="spec-value">Precision Boutique Stitching</span></div>
          <div class="spec-row"><span class="spec-label">Timeline</span><span class="spec-value">3–7 Days (Urgent: 24h)</span></div>
          <div class="spec-row"><span class="spec-label">Measurement</span><span class="spec-value">Doorstep / Atelier Visit</span></div>
          <div class="spec-row"><span class="spec-label">Fitting Consultation</span><span class="spec-value">Direct Master Tailor</span></div>
          <div class="spec-row"><span class="spec-label">Alterations</span><span class="spec-value">Complimentary First Adjustment</span></div>
          <div class="spec-row"><span class="spec-label">Atelier Location</span><span class="spec-value">Sahibganj, Jharkhand</span></div>
        </div>
      </div>
    </details>

    <!-- Customization Details (Organized grid cards) -->
    {serviceSections && serviceSections.length > 0 && (
      <details class="accordion-item">
        <summary class="accordion-summary">
          <h3 class="accordion-heading">Customization &amp; Tailoring Details</h3>
          <span class="accordion-toggle-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </span>
        </summary>
        <div class="accordion-content">
          <div class="service-details-grid">
            {serviceSections.map((sec) => (
              <div class="service-sec-card">
                <h4 class="service-sec-heading">{sec.heading}</h4>
                <ul class="service-sec-list">
                  {sec.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </details>
    )}
  </div>

  <!-- Recommendations Section 1: Similar Services -->
  {similar && similar.length > 0 && (
    <section class="luxury-recommendations-section" id="similar-items-section">
      <div class="luxury-section-header">
        <h3 class="luxury-section-title">Similar Tailoring Services</h3>
        <span class="luxury-section-divider"></span>
      </div>

      <div class="luxury-carousel-track" id="similar-items-container">
        {similar.map((item) => (
          <a href={`/services/${item.id}/`} class="luxury-product-card">
            <div class="luxury-card-media">
              {item.data.image ? (
                <img {...getCardImageAttrs(item.data.image, '(max-width: 600px) 160px, 190px')} alt={item.data.title} width="320" height="400" loading="lazy" decoding="async" />
              ) : (
                <div class="luxury-card-fallback">
                  <span class="fallback-logo">alif.</span>
                  <span class="fallback-sub">Atelier</span>
                </div>
              )}
            </div>
            <div class="luxury-card-body">
              <span class="luxury-card-category">{item.data.category || 'Tailoring'}</span>
              <h4 class="luxury-card-title" title={item.data.title}>{item.data.title}</h4>
              <div class="luxury-card-pricing">
                <span class="luxury-price-current">From ₹{item.data.price}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Recommendations Section 2: You May Also Like -->
  {ymal && ymal.length > 0 && (
    <section class="luxury-recommendations-section ymal-variant" id="ymal-section">
      <div class="luxury-section-header">
        <h3 class="luxury-section-title">You May Also Like</h3>
        <span class="luxury-section-divider"></span>
      </div>

      <div class="luxury-carousel-track" id="ymal-container">
        {ymal.map((item) => (
          <a href={`/services/${item.id}/`} class="luxury-product-card">
            <div class="luxury-card-media">
              {item.data.image ? (
                <img {...getCardImageAttrs(item.data.image, '(max-width: 600px) 160px, 190px')} alt={item.data.title} width="320" height="400" loading="lazy" decoding="async" />
              ) : (
                <div class="luxury-card-fallback">
                  <span class="fallback-logo">alif.</span>
                  <span class="fallback-sub">Atelier</span>
                </div>
              )}
            </div>
            <div class="luxury-card-body">
              <span class="luxury-card-category">{item.data.category || 'Tailoring'}</span>
              <h4 class="luxury-card-title" title={item.data.title}>{item.data.title}</h4>
              <div class="luxury-card-pricing">
                <span class="luxury-price-current">From ₹{item.data.price}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Sticky Mobile Quick-Buy Bar (Matching Product Page Standard) -->
  <aside class="sticky-mobile-buy-bar visible" id="stickyMobileBuyBar" aria-label="Quick Booking Bar">
    <div class="sticky-bar-inner">
      <div class="sticky-bar-product">
        {image ? (
          <img 
            id="stickyThumb" 
            src={getThumbUrl(image)} 
            alt={title} 
            width="44"
            height="44"
            loading="lazy"
            decoding="async"
            class="sticky-thumb-img" 
          />
        ) : (
          <div class="sticky-thumb-fallback">alif.</div>
        )}
        <div class="sticky-product-meta">
          <span class="sticky-product-title" id="stickyTitle">{title}</span>
          <span class="sticky-product-price" id="stickyPrice">From ₹{price || '150'}</span>
        </div>
      </div>

      <div class="sticky-bar-actions">
        <a 
          href={wappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="sticky-btn-buy" 
          id="stickyBuyNowBtn"
          aria-label="Book Now"
        >
          Book Now
        </a>
      </div>
    </div>
  </aside>

  <script is:inline>
    // Sticky Quick-Buy Bar Scroll Sync (Exact match to product page)
    function initStickyBuyBar() {
      const stickyBar = document.getElementById('stickyMobileBuyBar');
      if (!stickyBar || stickyBar._scrollBound) return;
      stickyBar._scrollBound = true;

      let lastScrollY = window.scrollY;
      let ticking = false;

      function onScroll() {
        const currentScrollY = window.scrollY;

        // At the very top, keep it visible
        if (currentScrollY <= 20) {
          stickyBar.classList.add('visible');
          lastScrollY = currentScrollY;
          ticking = false;
          return;
        }

        const diff = currentScrollY - lastScrollY;
        if (Math.abs(diff) > 5) {
          if (diff > 0) {
            stickyBar.classList.add('visible');
          } else {
            stickyBar.classList.remove('visible');
          }
          lastScrollY = currentScrollY;
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(onScroll);
          ticking = true;
        }
      }, { passive: true });
    }

    document.addEventListener('astro:page-load', initStickyBuyBar);
  </script>

  <style>
    /* =========================================================
       CRITICAL LAYOUT RESET (Identical to Product Page)
       ========================================================= */
    .container.section {
      width: 100% !important;
      max-width: 1000px !important;
      margin: 0 auto !important;
      padding: 12px 14px 40px 14px !important;
      box-sizing: border-box !important;
      overflow-x: hidden !important;
    }

    @media (min-width: 768px) {
      .container.section {
        padding: 30px 20px 50px 20px !important;
      }
    }

    .product-detail-grid {
      display: grid !important;
      grid-template-columns: 100% !important;
      gap: 20px !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin: 0 !important;
      box-sizing: border-box !important;
    }

    @media (min-width: 768px) {
      .product-detail-grid {
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr) !important;
        gap: 40px !important;
      }
    }

    .product-detail-image {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
    }

    .product-detail-info {
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      margin: 0 !important;
      padding: 0 !important;
      box-sizing: border-box !important;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* Main Media Container: perfectly aligned and centered */
    #mainMediaContainer.product-swapper {
      width: 100% !important;
      max-width: 480px !important;
      margin: 0 auto !important;
      aspect-ratio: 4 / 5 !important;
      min-height: unset !important;
      border-radius: 12px !important;
      overflow: hidden !important;
      background: #f7f7f7 !important;
      position: relative !important;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08) !important;
      box-sizing: border-box !important;
    }

    #mainMediaContainer img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      object-position: top center !important;
      display: block !important;
    }

    .luxury-fallback-media {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
