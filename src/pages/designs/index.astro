---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCardImageAttrs } from '../../utils/imagePerf';

const allDesigns = await getCollection('designs');
const designs = [...allDesigns].reverse();
---

<BaseLayout title="Our Designs" description="Unique blouse, suit, and lehenga designs crafted by alif. ladies tailor.">
  <div class="container section fade-in-section">
    <div style="text-align: center; margin-bottom: 30px;">
      <h1 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 2px;">Our Designs</h1>
      <p style="color: #666; font-size: 0.9rem; margin: 0;">Our portfolio of unique blouse, suit, and lehenga cuts &amp; necklines.</p>
    </div>

    <div class="product-grid">
      {designs.map((item, index) => (
        <div class="product-card" style="content-visibility: auto; contain-intrinsic-size: auto 260px;">
          <div class="product-card-image-wrapper" style="aspect-ratio: 4 / 5; overflow: hidden; position: relative; border-top-left-radius: 10px; border-top-right-radius: 10px;">
            <img
              {...getCardImageAttrs(item.data.image, '(max-width: 600px) 46vw, (max-width: 1024px) 30vw, 220px')}
              alt={item.data.title || 'alif. Design'}
              width="384"
              height="480"
              style="width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block;"
              loading={index < 4 ? "eager" : "lazy"}
              fetchpriority={index < 2 ? "high" : "auto"}
              decoding="async"
            />
          </div>

          <div class="product-card-name">
            <div class="product-card-title">{item.data.title || 'Design'}</div>
            {item.data.price && (
              <div class="product-card-price">₹{item.data.price}</div>
            )}
            {item.data.category && (
              <div class="product-card-category">{item.data.category}</div>
            )}
          </div>
        </div>
      ))}

      {designs.length === 0 && (
        <p class="empty-gallery-message" style="position:static; transform:none; color:#333; text-align:center; width:100%;">
          No designs found. Please check back soon.
        </p>
      )}
    </div>
  </div>
</BaseLayout>
