---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Shopping Bag" 
  description="Review your bespoke ensemble and order directly on WhatsApp with alif. atelier, Sahibganj."
>
  <div class="cart-page-wrapper">
    <!-- Luxury Atelier Header -->
    <header class="cart-header">
      <div class="cart-brand-tag">ATELIER ORDER DESK</div>
      <h1 class="cart-title">YOUR SHOPPING BAG</h1>
      <p class="cart-subtitle">Review items & finalize direct booking via WhatsApp</p>
    </header>

    <div class="cart-content-container">
      <!-- Left Column: Cart Items & Free Delivery Bar -->
      <div class="cart-main-col">
        <!-- Delivery Progress Tier Card -->
        <div id="delivery-progress-container" class="cart-delivery-card" style="display: none;">
          <div class="delivery-card-top">
            <span class="delivery-icon-box">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
                <rect x="1" y="3" width="15" height="13" rx="1"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
            </span>
            <span id="delivery-progress-text" class="delivery-status-text">Free Delivery in Sahibganj</span>
          </div>
          <div class="delivery-progress-track">
            <div id="deliveryProgressBar" class="delivery-progress-fill" style="width: 0%;"></div>
          </div>
        </div>

        <!-- Cart Items List Container -->
        <div id="cart-items-container" class="cart-items-list"></div>

        <!-- Add More Items CTA -->
        <div id="cart-actions" class="cart-continue-wrapper" style="display: none;">
          <a href="/products/" class="cart-continue-btn">
            <span>+ ADD MORE FABRICS & PIECES</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Order Form, Pricing Breakdown & Checkout -->
      <aside class="cart-sidebar-col">
        <!-- Delivery Information Card (Friction-Free WhatsApp Pre-Fill) -->
        <div id="cart-delivery-form" class="cart-form-card" style="display: none;">
          <div class="form-card-header">
            <span class="form-header-title">CLIENT & DELIVERY DETAILS</span>
            <span class="form-header-badge">OPTIONAL</span>
          </div>
          <p class="form-card-desc">Fill in details so your WhatsApp order message is pre-formatted with your shipping address.</p>

          <div class="form-fields-group">
            <div class="form-field">
              <label for="clientNameInput">YOUR NAME</label>
              <input type="text" id="clientNameInput" placeholder="e.g. Suman Sharma" autocomplete="name" />
            </div>

            <div class="form-field">
              <label for="clientPhoneInput">PHONE NUMBER</label>
              <input type="tel" id="clientPhoneInput" placeholder="e.g. 98765 43210" autocomplete="tel" />
            </div>

            <div class="form-field">
              <label for="clientAddressInput">DELIVERY ADDRESS / LOCATION</label>
              <textarea id="clientAddressInput" rows="2" placeholder="e.g. Near Railway Station, Sahibganj, Jharkhand" autocomplete="street-address"></textarea>
            </div>

            <div class="form-field">
              <label for="clientNotesInput">CUSTOM STITCHING / SPECIAL REQUEST</label>
              <input type="text" id="clientNotesInput" placeholder="e.g. Need matching lining or urgent delivery" />
            </div>
          </div>
        </div>

        <!-- Summary & WhatsApp CTA Card -->
        <div id="cart-summary" class="cart-summary-card" style="display: none;">
          <h2 class="summary-title">ORDER SUMMARY</h2>

          <div class="summary-breakdown">
            <div class="summary-row">
              <span>Items Total</span>
              <span id="summary-subtotal" class="summary-val">₹0</span>
            </div>
            <div class="summary-row">
              <span>Estimated Delivery</span>
              <span id="summary-shipping" class="summary-val free-highlight">FREE</span>
            </div>
            <div class="summary-divider"></div>
            <div class="summary-row summary-grand-total">
              <span>TOTAL PAYABLE</span>
              <span id="cart-total" class="summary-val total-price">₹0</span>
            </div>
          </div>

          <button type="button" class="cart-order-btn" id="proceedToOrderBtn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
            </svg>
            <span>ORDER DIRECTLY ON WHATSAPP</span>
          </button>

          <div class="cart-guarantee-strip">
            <div class="guarantee-item">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>Authentic Handloom & Tailoring</span>
            </div>
            <div class="guarantee-item">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <span>Instant WhatsApp Confirmation</span>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <!-- Empty Cart Luxury State -->
    <div id="cart-empty-message" class="cart-empty-wrapper" style="display: none;">
      <div class="empty-icon-box">
        <svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.2">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
      </div>
      <h2 class="empty-heading">YOUR BAG IS CURRENTLY EMPTY</h2>
      <p class="empty-sub">Explore bespoke fabrics, curated dress sets, and handcrafted accessories.</p>
      <div class="empty-actions">
        <a href="/products/" class="empty-primary-btn">EXPLORE ALL PRODUCTS</a>
        <a href="/products/?category=curated-sets" class="empty-secondary-btn">VIEW CURATED SETS</a>
      </div>
    </div>

    <!-- Sticky Mobile Checkout Bar -->
    <div id="cartMobileStickyBar" class="cart-mobile-sticky" style="display: none;">
      <div class="sticky-info-col">
        <span class="sticky-label">TOTAL AMOUNT</span>
        <span id="mobileStickyTotal" class="sticky-total">₹0</span>
      </div>
      <button type="button" id="mobileStickyOrderBtn" class="sticky-cta-btn">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        </svg>
        <span>ORDER ON WHATSAPP</span>
      </button>
    </div>
  </div>

  <script is:inline>
    // LocalStorage Helper for Client Info
    const CLIENT_INFO_KEY = 'alif_client_checkout_info';

    function getSavedClientInfo() {
      try {
        return JSON.parse(localStorage.getItem(CLIENT_INFO_KEY) || '{}');
      } catch (e) {
        return {};
      }
    }

    function saveClientInfo() {
      const name = document.getElementById('clientNameInput')?.value || '';
      const phone = document.getElementById('clientPhoneInput')?.value || '';
      const address = document.getElementById('clientAddressInput')?.value || '';
      const notes = document.getElementById('clientNotesInput')?.value || '';
      localStorage.setItem(CLIENT_INFO_KEY, JSON.stringify({ name, phone, address, notes }));
    }

    function populateClientInfo() {
      const info = getSavedClientInfo();
      if (document.getElementById('clientNameInput') && info.name) {
        document.getElementById('clientNameInput').value = info.name;
      }
      if (document.getElementById('clientPhoneInput') && info.phone) {
        document.getElementById('clientPhoneInput').value = info.phone;
      }
      if (document.getElementById('clientAddressInput') && info.address) {
        document.getElementById('clientAddressInput').value = info.address;
      }
      if (document.getElementById('clientNotesInput') && info.notes) {
        document.getElementById('clientNotesInput').value = info.notes;
      }
    }

    function renderCart() {
      const container = document.getElementById('cart-items-container');
      const actions = document.getElementById('cart-actions');
      const delivery = document.getElementById('delivery-progress-container');
      const deliveryText = document.getElementById('delivery-progress-text');
      const deliveryBar = document.getElementById('deliveryProgressBar');
      const summary = document.getElementById('cart-summary');
      const deliveryForm = document.getElementById('cart-delivery-form');
      const totalEl = document.getElementById('cart-total');
      const subtotalEl = document.getElementById('summary-subtotal');
      const emptyMsg = document.getElementById('cart-empty-message');
      const mobileSticky = document.getElementById('cartMobileStickyBar');
      const mobileStickyTotal = document.getElementById('mobileStickyTotal');

      const cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');

      if (cart.length === 0) {
        if (container) container.innerHTML = '';
        if (actions) actions.style.display = 'none';
        if (delivery) delivery.style.display = 'none';
        if (summary) summary.style.display = 'none';
        if (deliveryForm) deliveryForm.style.display = 'none';
        if (mobileSticky) mobileSticky.style.display = 'none';
        if (emptyMsg) emptyMsg.style.display = 'block';
        return;
      }

      if (emptyMsg) emptyMsg.style.display = 'none';
      if (actions) actions.style.display = 'block';
      if (summary) summary.style.display = 'block';
      if (deliveryForm) deliveryForm.style.display = 'block';
      if (mobileSticky) mobileSticky.style.display = 'flex';

      let total = 0;
      let html = '';

      cart.forEach((item, index) => {
        const itemPrice = Number(item.price) || 0;
        const itemQty = Math.max(1, item.quantity || 1);
        const itemTotal = itemPrice * itemQty;
        total += itemTotal;

        const refCode = item.code ? `<span class="item-ref-tag">REF: ${item.code}</span>` : '';

        html += `
          <div class="cart-item-row" data-index="${index}">
            <div class="cart-item-media">
              <img src="${item.image || '/icons/icon-512x512.png'}" alt="${item.title}" loading="lazy" />
            </div>

            <div class="cart-item-details">
              <div class="cart-item-meta">
                ${refCode}
                <h3 class="cart-item-title">${item.title}</h3>
                <div class="cart-item-price-unit">₹${itemPrice} each</div>
              </div>

              <div class="cart-item-controls">
                <div class="qty-stepper">
                  <button type="button" class="qty-btn btn-minus" onclick="updateQty(${index}, -1)" aria-label="Decrease quantity">−</button>
                  <span class="qty-number">${itemQty}</span>
                  <button type="button" class="qty-btn btn-plus" onclick="updateQty(${index}, 1)" aria-label="Increase quantity">+</button>
                </div>

                <div class="cart-item-subtotal">₹${itemTotal}</div>

                <button type="button" class="remove-item-btn" onclick="removeItem(${index})" aria-label="Remove ${item.title}">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `;
      });

      if (container) container.innerHTML = html;
      if (totalEl) totalEl.innerText = '₹' + total;
      if (subtotalEl) subtotalEl.innerText = '₹' + total;
      if (mobileStickyTotal) mobileStickyTotal.innerText = '₹' + total;

      // Delivery progress indicator (Threshold: ₹199)
      if (delivery && deliveryText && deliveryBar) {
        delivery.style.display = 'block';
        const freeDeliveryThreshold = 199;
        if (total >= freeDeliveryThreshold) {
          deliveryText.innerHTML = '<strong>Unlocked!</strong> Free Delivery in Sahibganj Area';
          deliveryBar.style.width = '100%';
          deliveryBar.classList.add('is-unlocked');
        } else {
          const diff = freeDeliveryThreshold - total;
          const percent = Math.min(Math.round((total / freeDeliveryThreshold) * 100), 100);
          deliveryText.innerHTML = `Add <strong>₹${diff}</strong> more for Free Delivery in Sahibganj`;
          deliveryBar.style.width = percent + '%';
          deliveryBar.classList.remove('is-unlocked');
        }
      }
    }

    window.updateQty = function(index, delta) {
      let cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
      if (cart[index]) {
        cart[index].quantity = (cart[index].quantity || 1) + delta;
        if (cart[index].quantity <= 0) {
          cart.splice(index, 1);
        }
      }
      localStorage.setItem('alif_cart', JSON.stringify(cart));
      renderCart();
      updateBadge();
    };

    window.removeItem = function(index) {
      let cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
      cart.splice(index, 1);
      localStorage.setItem('alif_cart', JSON.stringify(cart));
      renderCart();
      updateBadge();
    };

    function updateBadge() {
      const cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
      const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
      const b1 = document.getElementById('cartCount');
      const b2 = document.getElementById('cartCountMobile');
      if (b1) b1.innerText = count;
      if (b2) b2.innerText = count;
    }

    function triggerWhatsAppOrder() {
      const cart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
      if (cart.length === 0) return;

      saveClientInfo();
      const info = getSavedClientInfo();

      let msg = '*NEW ORDER INQUIRY — alif. ladies tailor*\n';
      msg += '═══════════════════════════\n\n';

      let total = 0;
      cart.forEach((item, idx) => {
        const itemPrice = Number(item.price) || 0;
        const itemQty = item.quantity || 1;
        const itemTotal = itemPrice * itemQty;
        total += itemTotal;
        const codeTag = item.code ? ` [Code: ${item.code}]` : '';
        msg += `• *${item.title}*${codeTag}\n   Qty: ${itemQty} × ₹${itemPrice} = ₹${itemTotal}\n\n`;
      });

      msg += '───────────────────────────\n';
      msg += `*ESTIMATED TOTAL:* ₹${total}\n`;
      msg += '───────────────────────────\n\n';

      if (info.name || info.phone || info.address) {
        msg += '*CLIENT DETAILS:*\n';
        if (info.name) msg += `• Name: ${info.name}\n`;
        if (info.phone) msg += `• Phone: ${info.phone}\n`;
        if (info.address) msg += `• Address: ${info.address}\n`;
        if (info.notes) msg += `• Notes: ${info.notes}\n`;
        msg += '\n';
      }

      msg += 'Please confirm order availability and delivery timeline.';

      window.open(`https://wa.me/7250470009?text=${encodeURIComponent(msg)}`, '_blank');
    }

    function initCartPage() {
      renderCart();
      populateClientInfo();

      // Listen to inputs for auto-saving
      ['clientNameInput', 'clientPhoneInput', 'clientAddressInput', 'clientNotesInput'].forEach(id => {
        const el = document.getElementById(id);
        if (el && !el._savedBound) {
          el._savedBound = true;
          el.addEventListener('input', saveClientInfo);
        }
      });

      const orderBtn = document.getElementById('proceedToOrderBtn');
      if (orderBtn && !orderBtn._bound) {
        orderBtn._bound = true;
        orderBtn.addEventListener('click', triggerWhatsAppOrder);
      }

      const mobileStickyBtn = document.getElementById('mobileStickyOrderBtn');
      if (mobileStickyBtn && !mobileStickyBtn._bound) {
        mobileStickyBtn._bound = true;
        mobileStickyBtn.addEventListener('click', triggerWhatsAppOrder);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCartPage);
    } else {
      initCartPage();
    }
    document.addEventListener('astro:page-load', initCartPage);
  </script>

  <style>
    /* Luxury Atelier Cart Design */
    .cart-page-wrapper {
      max-width: 1100px;
      margin: 0 auto;
      padding: 1.5rem 1rem calc(90px + env(safe-area-inset-bottom, 0px)) 1rem;
    }

    .cart-header {
      text-align: center;
      margin-bottom: 2.2rem;
    }

    .cart-brand-tag {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 3px;
      color: #888888;
      text-transform: uppercase;
      margin-bottom: 6px;
    }

    .cart-title {
      font-family: var(--font-heading, 'Playfair Display', serif);
      font-size: 2rem;
      font-weight: 400;
      letter-spacing: 2.5px;
      margin: 0 0 8px 0;
      color: #111111;
      text-transform: uppercase;
    }

    .cart-subtitle {
      font-size: 0.85rem;
      color: #666666;
      margin: 0;
      letter-spacing: 0.5px;
    }

    /* Grid Layout: Left Items + Right Summary */
    .cart-content-container {
      display: grid;
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    @media (min-width: 860px) {
      .cart-content-container {
        grid-template-columns: 1.35fr 1fr;
        gap: 2.5rem;
        align-items: flex-start;
      }
    }

    /* Delivery Progress Card */
    .cart-delivery-card {
      background: #fbf9f6;
      border: 1px solid #eee8df;
      border-radius: 10px;
      padding: 14px 18px;
      margin-bottom: 1.25rem;
    }

    .delivery-card-top {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 10px;
    }

    .delivery-icon-box {
      color: #111111;
      display: flex;
      align-items: center;
    }

    .delivery-status-text {
      font-size: 0.82rem;
      color: #222222;
      letter-spacing: 0.3px;
    }

    .delivery-progress-track {
      width: 100%;
      height: 4px;
      background: #e9e4db;
      border-radius: 4px;
      overflow: hidden;
    }

    .delivery-progress-fill {
      height: 100%;
      background: #111111;
      transition: width 0.35s ease, background 0.3s ease;
    }

    .delivery-progress-fill.is-unlocked {
      background: #2e7d32;
    }

    /* Items List */
    .cart-items-list {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .cart-item-row {
      display: flex;
      align-items: center;
      gap: 16px;
      background: #ffffff;
      border: 1px solid #ebe8e2;
      border-radius: 10px;
      padding: 14px 16px;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .cart-item-row:hover {
      border-color: #111111;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
    }

    .cart-item-media {
      width: 68px;
      height: 90px;
      flex-shrink: 0;
      border-radius: 6px;
      overflow: hidden;
      background: #f5f3ef;
      border: 1px solid #f0ece3;
    }

    .cart-item-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .cart-item-details {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 8px;
      min-width: 0;
    }

    @media (min-width: 600px) {
      .cart-item-details {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }
    }

    .cart-item-meta {
      min-width: 0;
      flex: 1;
    }

    .item-ref-tag {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 1px;
      color: #888888;
      text-transform: uppercase;
      display: block;
      margin-bottom: 2px;
    }

    .cart-item-title {
      font-family: var(--font-body, 'Ubuntu', sans-serif);
      font-size: 0.95rem;
      font-weight: 500;
      color: #111111;
      margin: 0 0 3px 0;
      line-height: 1.35;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .cart-item-price-unit {
      font-size: 0.8rem;
      color: #777777;
    }

    .cart-item-controls {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    .qty-stepper {
      display: flex;
      align-items: center;
      border: 1px solid #dcd7ce;
      border-radius: 6px;
      overflow: hidden;
      background: #ffffff;
    }

    .qty-btn {
      width: 28px;
      height: 28px;
      background: transparent;
      border: none;
      cursor: pointer;
      font-size: 14px;
      font-weight: 500;
      color: #111111;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease;
      touch-action: manipulation;
    }

    .qty-btn:hover,
    .qty-btn:active {
      background: #f0ece3;
    }

    .qty-number {
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0 8px;
      color: #111111;
      min-width: 16px;
      text-align: center;
    }

    .cart-item-subtotal {
      font-family: var(--font-body, 'Ubuntu', sans-serif);
      font-size: 0.95rem;
      font-weight: 600;
      color: #111111;
      min-width: 65px;
      text-align: right;
    }

    .remove-item-btn {
      background: none;
      border: none;
      padding: 6px;
      color: #999999;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 4px;
      transition: color 0.15s ease, background 0.15s ease;
      touch-action: manipulation;
    }

    .remove-item-btn:hover,
    .remove-item-btn:active {
      color: #d32f2f;
      background: #fde8e8;
    }

    /* Continue Shopping CTA */
    .cart-continue-wrapper {
      margin-top: 1.25rem;
      text-align: left;
    }

    .cart-continue-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border: 1px solid #111111;
      border-radius: 6px;
      color: #111111;
      text-decoration: none;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transition: all 0.2s ease;
      touch-action: manipulation;
    }

    .cart-continue-btn:hover {
      background: #111111;
      color: #ffffff;
    }

    /* Sidebar Right Column */
    .cart-sidebar-col {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .cart-form-card,
    .cart-summary-card {
      background: #ffffff;
      border: 1px solid #ebe8e2;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
    }

    .form-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 6px;
    }

    .form-header-title {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 1.8px;
      color: #111111;
      text-transform: uppercase;
    }

    .form-header-badge {
      font-size: 0.62rem;
      font-weight: 600;
      letter-spacing: 1px;
      padding: 2px 7px;
      background: #f0ece3;
      border-radius: 4px;
      color: #666666;
