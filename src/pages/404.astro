---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 Page Not Found" description="The page you are looking for does not exist.">
  <div class="container section" style="text-align: center; padding: 100px 20px;">
    <h1 style="font-family: var(--font-heading); font-size: 4rem; margin: 0 0 10px 0;">404</h1>
    <h2 style="font-family: var(--font-heading); font-size: 1.5rem; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px;">Page Not Found</h2>
    <p style="color: #666; max-width: 500px; margin: 0 auto 30px auto; font-size: 0.95rem;">The link you followed may be broken, or the page may have been moved.</p>
    <a href="/" style="display: inline-block; padding: 14px 35px; background: #000; color: #fff; text-decoration: none; text-transform: uppercase; letter-spacing: 2px; font-size: 0.85rem;">Return to Homepage</a>
  </div>
</BaseLayout>
