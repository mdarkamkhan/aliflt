---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact & Atelier Visit | ALIF Ladies Tailor Sahibganj" 
  description="Visit the ALIF flagship tailoring atelier at Daal Kuan, College Road, Sahibganj. Book bespoke consultations, connect via WhatsApp, call Master Tailor, or get turn-by-turn directions."
>
  <div class="contact-page-wrapper">
    <div class="contact-container">
      
      <!-- Editorial Header -->
      <header class="contact-header">
        <span class="contact-eyebrow">HAUTE COUTURE &amp; BESPOKE TAILORING • SAHIBGANJ</span>
        <h1 class="contact-title">ATELIER &amp; INQUIRIES</h1>
        <p class="contact-subtitle">
          From bridal lehengas and designer blouses to timeless custom silhouettes, experience master craftsmanship tailored to your exact drape.
        </p>
      </header>

      <!-- Mobile-First 1-Tap Quick Action Bar -->
      <section class="quick-actions-grid" aria-label="Quick Contact Actions">
        <!-- WhatsApp -->
        <a 
          href="https://wa.me/7250470009?text=Hello%20ALIF,%20I%20have%20an%20inquiry%20regarding%20custom%20stitching%20and%20designs." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-whatsapp"
          id="actionWhatsApp"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">DIRECT CONCIERGE</span>
            <h2 class="quick-card-title">WhatsApp Atelier</h2>
            <span class="quick-card-value">+91 72504 70009</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>

        <!-- Call -->
        <a 
          href="tel:7250470009" 
          class="quick-card card-call"
          id="actionCall"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">STUDIO DESK</span>
            <h2 class="quick-card-title">Call Master Tailor</h2>
            <span class="quick-card-value">+91 72504 70009</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>

        <!-- Directions (Opens turn-by-turn navigation directly) -->
        <a 
          href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-maps"
          id="actionMaps"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">NAVIGATION</span>
            <h2 class="quick-card-title">Get Directions</h2>
            <span class="quick-card-value">Daal Kuan, College Road</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>

        <!-- Ask ALIF AI Assistant -->
        <button 
          type="button" 
          class="quick-card card-ai"
          id="actionAI"
          aria-label="Open ALIF AI Assistant"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
              <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag quick-tag-ai">✨ 24/7 AI STYLIST</span>
            <h2 class="quick-card-title">Ask ALIF AI</h2>
            <span class="quick-card-value">Rates, Fabrics &amp; Timings</span>
          </div>
          <div class="quick-card-arrow">✨</div>
        </button>
      </section>

      <!-- Main Two-Column Atelier Showcase -->
      <div class="atelier-main-grid">

        <!-- Column 1: Boutique Location & Schedule Details -->
        <div class="atelier-details-column">
          
          <!-- Live Boutique Status Card -->
          <div class="atelier-card boutique-info-card">
            <div class="card-status-bar">
              <div class="status-indicator-badge" id="liveStatusBadge">
                <span class="status-dot"></span>
                <span class="status-text" id="liveStatusText">Verifying Studio Hours...</span>
              </div>
              <span class="status-timing-note">Open 7 Days • Walk-ins Welcome</span>
            </div>

            <div class="card-header-group">
              <span class="card-eyebrow">FLAGSHIP ATELIER</span>
              <h2 class="card-title">ALIF Ladies Tailor</h2>
            </div>

            <div class="address-content">
              <p class="address-line">
                <strong>Daal Kuan, College Road</strong><br />
                Opposite Joy Fast Food<br />
                Sahibganj, Jharkhand — 816109
              </p>
            </div>

            <!-- Action buttons inside card -->
            <div class="address-actions">
              <button 
                type="button" 
                class="btn-ask-ai" 
                id="btnAskAIAddress"
                title="Ask AI Assistant for exact shop directions"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
                </svg>
                <span>Ask ALIF AI ✨</span>
              </button>
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-maps-link"
              >
                Get Directions ↗
              </a>
            </div>
          </div>

          <!-- Schedule & Hours Card -->
          <div class="atelier-card timings-card">
            <div class="card-header-group">
              <span class="card-eyebrow">BOUTIQUE SCHEDULE</span>
              <h2 class="card-title">Atelier Hours</h2>
            </div>

            <ul class="timings-list">
              <li class="timings-row">
                <span class="timing-days">Saturday – Thursday</span>
                <span class="timing-hours">10:00 AM — 9:00 PM</span>
              </li>
              <li class="timings-row timing-friday">
                <span class="timing-days">Friday (Post Jummah)</span>
                <span class="timing-hours">02:00 PM — 9:00 PM</span>
              </li>
              <li class="timings-row timing-highlight">
                <span class="timing-days">Weekly Schedule</span>
                <span class="timing-badge">Open All 7 Days</span>
              </li>
            </ul>

            <div class="timings-footer-note">
              <span>Bridal fittings &amp; bespoke consultations welcome anytime during studio hours.</span>
            </div>
          </div>

          <!-- Interactive Responsive Map Frame -->
          <div class="atelier-card map-card">
            <div class="map-container">
              <iframe 
                src="https://maps.google.com/maps?q=6JRP%2BRQ%20Sahibganj%2C%20Jharkhand&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                class="embedded-map-iframe" 
                title="ALIF Ladies Tailor Map Location" 
                loading="lazy" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

        </div>

        <!-- Column 2: Mobile-First Bespoke Consultation Form -->
        <div class="atelier-form-column">
          <div class="atelier-card form-card">
            
            <div class="card-header-group">
              <span class="card-eyebrow">BESPOKE INQUIRY</span>
              <h2 class="card-title">Plan Your Custom Silhouette</h2>
              <p class="form-desc">
                Share your outfit requirements, fabric ideas, or event timeline. Connect directly with our master tailor for personalized guidance.
              </p>
            </div>

            <form id="tailorInquiryForm" class="inquiry-form" novalidate>
              
              <!-- Floating Label: Full Name -->
              <div class="form-input-group">
                <input 
                  type="text" 
                  id="inqName" 
                  class="floating-input" 
                  placeholder=" " 
                  required 
                  autocomplete="name"
                />
                <label for="inqName" class="floating-label">YOUR FULL NAME *</label>
              </div>

              <!-- Floating Label: Phone / WhatsApp -->
              <div class="form-input-group">
                <input 
                  type="tel" 
                  id="inqPhone" 
                  class="floating-input" 
                  placeholder=" " 
                  required 
                  autocomplete="tel"
                />
                <label for="inqPhone" class="floating-label">PHONE / WHATSAPP NUMBER *</label>
              </div>

              <!-- Service Chips Selector (Mobile 1-Tap) -->
              <div class="service-selector-group">
                <span class="selector-heading">SELECT GARMENT OR SERVICE:</span>
                <div class="service-chips-grid" id="serviceChipsGrid">
                  <button type="button" class="service-chip is-selected" data-service="Designer Blouse">Designer Blouse</button>
                  <button type="button" class="service-chip" data-service="Bridal Lehenga">Bridal Lehenga</button>
                  <button type="button" class="service-chip" data-service="Salwar Suit / Kurti">Salwar Suit</button>
                  <button type="button" class="service-chip" data-service="Anarkali / Sharara">Anarkali &amp; Sharara</button>
                  <button type="button" class="service-chip" data-service="Gown / Indo-Western">Gown &amp; Western</button>
                  <button type="button" class="service-chip" data-service="Saree Fall &amp; Pico">Saree Fall &amp; Pico</button>
                  <button type="button" class="service-chip" data-service="Laces &amp; Latkans Matching">Laces &amp; Latkans</button>
                  <button type="button" class="service-chip" data-service="Custom Outfit">Custom Silhouette</button>
                </div>
              </div>

              <!-- Floating Label: Message / Requirements -->
              <div class="form-input-group">
                <textarea 
                  id="inqMessage" 
                  class="floating-input floating-textarea" 
                  rows="3" 
                  placeholder=" "
                ></textarea>
                <label for="inqMessage" class="floating-label">DESIGN NOTES, OCCASION OR FABRIC DETAILS (OPTIONAL)</label>
              </div>

              <!-- Submit Button (Direct WhatsApp Formatter) -->
              <div class="form-action-group">
                <button type="submit" class="btn-whatsapp-submit" id="btnSubmitInquiry">
                  <span class="btn-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-2.18-.553-1.614-.668-2.671-2.278-2.752-2.387-.082-.108-.66-1.879-.66-1.688 0-.81.424-1.207.574-1.37.151-.162.33-.203.441-.203.11 0 .221.002.317.006.101.005.237-.038.371.284.144.346.494 1.203.538 1.291.044.088.073.191.015.306-.059.117-.088.191-.176.294-.088.103-.186.23-.265.31-.089.088-.182.183-.078.361.103.177.46 1.761 1.09 1.32.812.723 1.498.946 1.71.105.213.117.336.059.462-.059.125-.494-.573-.624-.725-.13-.153-.258-.13-.357-.088-.101.042-1.291.538-1.291.538z"/>
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.436 5.179L2 22l4.981-1.309A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.167-.442-4.489-1.218l-.322-.19-2.964.778.791-2.89-.208-.33A8.204 8.204 0 0 1 3.75 12c0-4.549 3.701-8.25 8.25-8.25 4.549 0 8.25 3.701 8.25 8.25 0 4.549-3.701 8.25-8.25 8.25z"/>
                    </svg>
                  </span>
                  <span>CONNECT ON WHATSAPP ↗</span>
                </button>
              </div>

              <!-- Form Guarantee Note -->
              <p class="form-privacy-note">
                🔒 Direct consultation with Master Tailor Arkam. Your details remain strictly private.
              </p>

            </form>

          </div>
        </div>

      </div>

      <!-- Atelier Trust & Perfection Pillars Grid -->
      <section class="trust-pillars-section" aria-label="Atelier Guarantees">
        <div class="trust-header">
          <span class="trust-eyebrow">THE ATELIER STANDARD</span>
          <h2 class="trust-section-title">Why Sahibganj Chooses ALIF</h2>
        </div>
        <div class="trust-grid">
          
          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">17+ Years of Heritage</h3>
              <p class="trust-desc">Crafting bespoke women's silhouettes in Sahibganj with artisanal precision since 2008.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.3 8.7 8.7 21.3c-.4.4-1 .4-1.4 0l-4.6-4.6c-.4-.4-.4-1 0-1.4L15.3 2.7c.4-.4 1-.4 1.4 0l4.6 4.6c.4.4.4 1 0 1.4Z"></path>
                <path d="m14 4 2 2"></path>
                <path d="m11 7 2 2"></path>
                <path d="m8 10 2 2"></path>
                <path d="m5 13 2 2"></path>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Flawless Fit Guarantee</h3>
              <p class="trust-desc">Every cut is tailored to your unique measurements, with complimentary fit adjustments.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Express Atelier Delivery</h3>
              <p class="trust-desc">Prioritized turnaround available for urgent bridal events, festive deadlines, and family occasions.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Curated Laces &amp; Latkans</h3>
              <p class="trust-desc">Sahibganj's premier collection of designer borders, zari trims, and handcrafted latkans in-store.</p>
            </div>
          </div>

        </div>
      </section>

    </div>
  </div>

  <!-- Interactive JavaScript Logic -->
  <script is:inline>
    // Live Timing Calculator based on Indian Standard Time
    function updateLiveBoutiqueStatus() {
      const now = new Date();
      // Current day in IST (0 = Sun, 1 = Mon, ..., 5 = Fri, 6 = Sat)
      const day = now.getDay();
      const hours = now.getHours();
      const minutes = now.getMinutes();
      const timeInMinutes = hours * 60 + minutes;

      const badge = document.getElementById('liveStatusBadge');
      const text = document.getElementById('liveStatusText');
      if (!badge || !text) return;

      let isOpen = false;
      let closeTimeText = "9:00 PM";
      let nextOpenText = "10:00 AM";

      if (day === 5) {
        // Friday: 2:00 PM (14:00 = 840 mins) to 9:00 PM (21:00 = 1260 mins)
        if (timeInMinutes >= 14 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 14 * 60 ? "2:00 PM today" : "10:00 AM tomorrow";
        }
      } else {
        // Sat - Thu: 10:00 AM (600 mins) to 9:00 PM (1260 mins)
        if (timeInMinutes >= 10 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 10 * 60 ? "10:00 AM today" : (day === 4 ? "2:00 PM tomorrow (Fri)" : "10:00 AM tomorrow");
        }
      }

      if (isOpen) {
        badge.classList.remove('is-closed');
        badge.classList.add('is-open');
        text.innerText = `● OPEN NOW — Until ${closeTimeText}`;
      } else {
        badge.classList.remove('is-open');
        badge.classList.add('is-closed');
        text.innerText = `● CURRENTLY CLOSED — Opens ${nextOpenText}`;
      }
    }

    // Trigger AI Chatbot with Pretyped Question for Address/Directions
    function initAddressAIChat() {
      const btn = document.getElementById('btnAskAIAddress');
      if (!btn) return;

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const addressQuery = "Muje address samajh nahi aaya, aapka dukan daal kuan college road me kahan pr h?";
        
        if (typeof window.openALiFChat === 'function') {
          window.openALiFChat(addressQuery, true);
        } else {
          window.dispatchEvent(new CustomEvent('open-alif-chat', {
            detail: { message: addressQuery, autoSend: true }
          }));
          const chatBtn = document.getElementById('chat-button');
          if (chatBtn) chatBtn.click();
        }
      });
    }

    // Service Chips Selector Logic
    function initServiceChips() {
      const chips = document.querySelectorAll('.service-chip');
      chips.forEach(chip => {
        chip.addEventListener('click', function(e) {
          e.preventDefault();
          chips.forEach(c => c.classList.remove('is-selected'));
          this.classList.add('is-selected');
        });
      });
    }

    // WhatsApp Form Submission
    function initInquiryForm() {
      const form = document.getElementById('tailorInquiryForm');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        const nameInput = document.getElementById('inqName');
        const phoneInput = document.getElementById('inqPhone');
        const messageInput = document.getElementById('inqMessage');
        const selectedChip = document.querySelector('.service-chip.is-selected');

        const name = (nameInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();
        const service = selectedChip ? selectedChip.getAttribute('data-service') : 'Bespoke Tailoring';
        const notes = (messageInput?.value || '').trim();

        if (!name) {
          alert('Please share your name so we may assist you personally.');
          nameInput?.focus();
          return;
        }

        if (!phone) {
          alert('Please provide a valid phone or WhatsApp number so our master tailor can connect with you.');
          phoneInput?.focus();
          return;
        }

        // Format professional WhatsApp message
        let waText = `✨ *Bespoke Tailoring Inquiry — ALIF Atelier*\n\n`;
        waText += `👤 *Client Name:* ${name}\n`;
        waText += `📞 *Phone/WhatsApp:* ${phone}\n`;
        waText += `👗 *Silhouette / Service:* ${service}\n`;
        if (notes) {
          waText += `📝 *Client Notes:* ${notes}\n`;
        }
        waText += `\n—\n_Sent via aliflt.com/contact-us_`;

        const waUrl = `https://wa.me/7250470009?text=${encodeURIComponent(waText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // 1-Tap Trigger for ALIF AI Assistant
    function initAICardTrigger() {
      const aiBtn = document.getElementById('actionAI');
      if (!aiBtn) return;
      aiBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openALiFChat === 'function') {
          window.openALiFChat();
        } else {
          const chatBtn = document.getElementById('chat-button');
          if (chatBtn) {
            chatBtn.click();
          }
        }
      });
    }

    // Page Load Handler
    function initContactPage() {
      updateLiveBoutiqueStatus();
      initServiceChips();
      initInquiryForm();
      initAICardTrigger();
      initAddressAIChat();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactPage);
    } else {
      initContactPage();
    }
    document.addEventListener('astro:page-load', initContactPage);
  </script>

</BaseLayout>

<style>
  /* =========================================
     MOBILE-FIRST LUXURY CONTACT SECTION
     ========================================= */
  
  .contact-page-wrapper {
    background-color: transparent;
    padding: 30px 16px 60px 16px;
    font-family: var(--font-body, 'Poppins', sans-serif);
    color: #111111;
  }

  .contact-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  /* --- EDITORIAL HEADER --- */
  .contact-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .contact-eyebrow {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #777777;
    margin-bottom: 8px;
  }

  .contact-title {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2.2rem;
    font-weight: 500;
