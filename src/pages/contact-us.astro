---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact & Visit Us | ALIF Ladies Tailor Sahibganj" 
  description="Visit ALIF Ladies Tailor at Daal Kuan, College Road, Sahibganj. Get store timings, call +91 72504 70009, chat on WhatsApp, or get directions."
>
  <div class="contact-page-wrapper">
    <div class="contact-container">
      
      <!-- Editorial Luxury Header -->
      <header class="contact-header">
        <span class="contact-eyebrow">LADIES TAILORING, FABRICS &amp; TRIMS • SAHIBGANJ</span>
        <h1 class="contact-title">CONTACT &amp; VISIT US</h1>
        <p class="contact-subtitle">
          For custom stitching, designer fabrics, laces, latkans, or order inquiries — connect directly with our store team or visit our flagship atelier in Sahibganj.
        </p>
      </header>

      <!-- Mobile-First 2x2 Quick Action Bar (4-col on desktop) -->
      <section class="quick-actions-grid" aria-label="Quick Contact Actions">
        
        <!-- WhatsApp Action -->
        <a 
          href="https://wa.me/7250470009?text=Hello%20ALIF,%20I%20have%20an%20inquiry%20regarding%20stitching%20or%20products." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-whatsapp"
          id="actionWhatsApp"
        >
          <div class="quick-card-top">
            <div class="quick-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
              </svg>
            </div>
            <span class="quick-card-arrow">↗</span>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">FASTEST REPLY</span>
            <h2 class="quick-card-title">Chat on WhatsApp</h2>
            <span class="quick-card-value">+91 72504 70009</span>
          </div>
        </a>

        <!-- Call Action -->
        <a 
          href="tel:7250470009" 
          class="quick-card card-call"
          id="actionCall"
        >
          <div class="quick-card-top">
            <div class="quick-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <span class="quick-card-arrow">↗</span>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">PHONE SUPPORT</span>
            <h2 class="quick-card-title">Call ALIF Store</h2>
            <span class="quick-card-value">+91 72504 70009</span>
          </div>
        </a>

        <!-- Directions Action (Opens turn-by-turn navigation directly) -->
        <a 
          href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-maps"
          id="actionMaps"
        >
          <div class="quick-card-top">
            <div class="quick-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <span class="quick-card-arrow">↗</span>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">NAVIGATION</span>
            <h2 class="quick-card-title">Get Directions</h2>
            <span class="quick-card-value">Daal Kuan, College Rd</span>
          </div>
        </a>

        <!-- Ask ALIF AI Assistant -->
        <button 
          type="button" 
          class="quick-card card-ai"
          id="actionAI"
          aria-label="Open ALIF AI Assistant"
        >
          <div class="quick-card-top">
            <div class="quick-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
              </svg>
            </div>
            <span class="quick-card-arrow ai-sparkle">✨</span>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag quick-tag-ai">24/7 INSTANT AI</span>
            <h2 class="quick-card-title">Ask ALIF AI</h2>
            <span class="quick-card-value">Rates, Styles &amp; Timings</span>
          </div>
        </button>

      </section>

      <!-- Main Two-Column Showcase (Unified Master Store Card + Inquiry Form) -->
      <div class="atelier-main-grid">

        <!-- Column 1: Unified Master Flagship Store Atelier Card -->
        <div class="atelier-details-column">
          
          <div class="atelier-card master-store-card">
            
            <!-- Real-Time Live Status Bar -->
            <div class="card-status-bar">
              <div class="status-indicator-badge" id="liveStatusBadge">
                <span class="status-dot"></span>
                <span class="status-text" id="liveStatusText">Verifying Store Timings...</span>
              </div>
              <span class="status-timing-note">Open 7 Days • Walk-ins Welcome</span>
            </div>

            <!-- Store Brand & Address -->
            <div class="store-identity-group">
              <span class="card-eyebrow">FLAGSHIP STORE &amp; ATELIER</span>
              <h2 class="card-title">ALIF Ladies Tailor</h2>
              
              <div class="store-address-box">
                <div class="address-icon-wrap" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="address-text-wrap">
                  <p class="address-primary">Daal Kuan, College Road</p>
                  <p class="address-landmark">Opposite Joy Fast Food</p>
                  <p class="address-city">Sahibganj, Jharkhand — 816109</p>
                </div>
              </div>
            </div>

            <!-- Primary Store Actions: Directions & Ask AI -->
            <div class="store-actions-duo">
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-maps-primary"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                </svg>
                <span>Get Directions ↗</span>
              </a>

              <button 
                type="button" 
                class="btn-ask-ai-secondary" 
                id="btnAskAIAddress"
                title="Ask AI Assistant for exact shop directions"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
                </svg>
                <span>Ask ALIF AI ✨</span>
              </button>
            </div>

            <!-- Subtle Elegant Divider -->
            <hr class="card-divider" />

            <!-- Integrated Schedule Strip -->
            <div class="store-schedule-section">
              <div class="schedule-head">
                <span class="schedule-eyebrow">STORE TIMINGS</span>
                <span class="schedule-badge">All 7 Days Open</span>
              </div>

              <div class="schedule-table">
                <div class="schedule-row">
                  <span class="sched-day">Saturday – Thursday</span>
                  <span class="sched-time">10:00 AM — 9:00 PM</span>
                </div>
                <div class="schedule-row row-friday">
                  <span class="sched-day">Friday (Post Jummah)</span>
                  <span class="sched-time">02:00 PM — 9:00 PM</span>
                </div>
              </div>

              <p class="schedule-hint">
                ✨ Custom stitching, measurements &amp; fabric selection welcome anytime during open hours.
              </p>
            </div>

            <!-- Integrated Seamless Interactive Map Container -->
            <div class="store-map-wrapper">
              <iframe 
                src="https://maps.google.com/maps?q=6JRP%2BRQ%20Sahibganj%2C%20Jharkhand&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                class="embedded-map-iframe" 
                title="ALIF Ladies Tailor Map Location" 
                loading="lazy" 
                allowfullscreen>
              </iframe>
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="map-float-btn"
                aria-label="Open full map in Google Maps"
              >
                <span>Open in Maps</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            </div>

          </div>

        </div>

        <!-- Column 2: Modern Luxury Bespoke Consultation Form -->
        <div class="atelier-form-column">
          <div class="atelier-card form-master-card">
            
            <div class="card-header-group">
              <span class="card-eyebrow">DIRECT INQUIRY</span>
              <h2 class="card-title">Send Us a Message</h2>
              <p class="form-desc">
                Inquire about bridal stitching, designer blouses, suit cuts, or fabric collections. Submit below to connect directly with the ALIF team on WhatsApp.
              </p>
            </div>

            <form id="tailorInquiryForm" class="inquiry-form" novalidate>
              
              <!-- Clean Luxury Input: Full Name -->
              <div class="form-field-group">
                <label for="inqName" class="form-field-label">
                  YOUR FULL NAME <span class="req-star">*</span>
                </label>
                <div class="input-container">
                  <input 
                    type="text" 
                    id="inqName" 
                    class="luxury-input" 
                    placeholder="e.g. Fatima Khan" 
                    required 
                    autocomplete="name"
                  />
                </div>
              </div>

              <!-- Clean Luxury Input: Phone / WhatsApp -->
              <div class="form-field-group">
                <label for="inqPhone" class="form-field-label">
                  PHONE / WHATSAPP NUMBER <span class="req-star">*</span>
                </label>
                <div class="input-container">
                  <input 
                    type="tel" 
                    id="inqPhone" 
                    class="luxury-input" 
                    placeholder="e.g. 72504 70009" 
                    required 
                    autocomplete="tel"
                  />
                </div>
              </div>

              <!-- Service Category Selector (Pill Selector) -->
              <div class="form-field-group">
                <label class="form-field-label">
                  SELECT SERVICE / CATEGORY <span class="req-star">*</span>
                </label>
                <div class="service-chips-grid" id="serviceChipsGrid">
                  <button type="button" class="service-chip is-selected" data-service="Designer Blouse">Designer Blouse</button>
                  <button type="button" class="service-chip" data-service="Bridal Lehenga">Bridal Lehenga</button>
                  <button type="button" class="service-chip" data-service="Salwar Suit">Salwar Suit</button>
                  <button type="button" class="service-chip" data-service="Fabrics &amp; Material">Fabrics &amp; Material</button>
                  <button type="button" class="service-chip" data-service="Laces &amp; Latkans">Laces &amp; Latkans</button>
                  <button type="button" class="service-chip" data-service="Saree Fall &amp; Pico">Saree Fall &amp; Pico</button>
                  <button type="button" class="service-chip" data-service="Gown / Western Dress">Gown &amp; Western</button>
                  <button type="button" class="service-chip" data-service="Other Inquiry">Other Inquiry</button>
                </div>
              </div>

              <!-- Requirements / Design Notes -->
              <div class="form-field-group">
                <label for="inqMessage" class="form-field-label">
                  REQUIREMENTS OR DESIGN NOTES <span class="opt-label">(OPTIONAL)</span>
                </label>
                <div class="input-container">
                  <textarea 
                    id="inqMessage" 
                    class="luxury-input luxury-textarea" 
                    rows="3" 
                    placeholder="Mention any specific neck design, sleeve style, fabric details, or target event date..."
                  ></textarea>
                </div>
              </div>

              <!-- Submit Button (Direct WhatsApp Formatter) -->
              <div class="form-action-group">
                <button type="submit" class="btn-whatsapp-submit" id="btnSubmitInquiry">
                  <span class="btn-icon-wa">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-2.18-.553-1.614-.668-2.671-2.278-2.752-2.387-.082-.108-.66-1.879-.66-1.688 0-.81.424-1.207.574-1.37.151-.162.33-.203.441-.203.11 0 .221.002.317.006.101.005.237-.038.371.284.144.346.494 1.203.538 1.291.044.088.073.191.015.306-.059.117-.088.191-.176.294-.088.103-.186.23-.265.31-.089.088-.182.183-.078.361.103.177.46 1.761 1.09 1.32.812.723 1.498.946 1.71.105.213.117.336.059.462-.059.125-.494-.573-.624-.725-.13-.153-.258-.13-.357-.088-.101.042-1.291.538-1.291.538z"/>
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.436 5.179L2 22l4.981-1.309A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.167-.442-4.489-1.218l-.322-.19-2.964.778.791-2.89-.208-.33A8.204 8.204 0 0 1 3.75 12c0-4.549 3.701-8.25 8.25-8.25 4.549 0 8.25 3.701 8.25 8.25 0 4.549-3.701 8.25-8.25 8.25z"/>
                    </svg>
                  </span>
                  <span>Start WhatsApp Inquiry ↗</span>
                </button>
              </div>

              <!-- Trust & Confidentiality Note -->
              <div class="form-trust-strip">
                <span class="trust-pill-tag">⚡ Fast Response</span>
                <span class="trust-pill-tag">🔒 100% Private</span>
                <span class="trust-pill-tag">📍 Sahibganj Store</span>
              </div>

            </form>

          </div>
        </div>

      </div>

      <!-- Store Trust & Perfection Pillars Grid (2x2 on Mobile, 4-col on Desktop) -->
      <section class="trust-pillars-section" aria-label="ALIF Guarantees">
        <div class="trust-header">
          <span class="trust-eyebrow">THE ALIF COMMITMENT</span>
          <h2 class="trust-section-title">Why Sahibganj Chooses ALIF</h2>
        </div>
        
        <div class="trust-grid">
          
          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">17+ Years Legacy</h3>
              <p class="trust-desc">Specialized in women's bespoke tailoring &amp; fabrics since 2008.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.3 8.7 8.7 21.3c-.4.4-1 .4-1.4 0l-4.6-4.6c-.4-.4-.4-1 0-1.4L15.3 2.7c.4-.4 1-.4 1.4 0l4.6 4.6c.4.4.4 1 0 1.4Z"></path>
                <path d="m14 4 2 2"></path>
                <path d="m11 7 2 2"></path>
                <path d="m8 10 2 2"></path>
                <path d="m5 13 2 2"></path>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Perfect Fit Guarantee</h3>
              <p class="trust-desc">Complimentary fitting adjustments until you are completely delighted.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Express Processing</h3>
              <p class="trust-desc">Urgent wedding, festive &amp; emergency stitching prioritized.</p>
            </div>
          </div>

          <div class="trust-item">
            <div class="trust-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                <path d="M5 3v4M3 5h4M19 17v4M17 19h4"/>
              </svg>
            </div>
            <div class="trust-content">
              <h3 class="trust-title">Matching Trims &amp; Laces</h3>
              <p class="trust-desc">Exclusive designer borders, zari trims, and matching latkans in-store.</p>
            </div>
          </div>

        </div>
      </section>

    </div>
  </div>

  <!-- Interactive JavaScript Logic -->
  <script is:inline>
    // Live Timing Calculator based on Indian Standard Time
    function updateLiveStoreStatus() {
      const now = new Date();
      // Current day in IST (0 = Sun, 1 = Mon, ..., 5 = Fri, 6 = Sat)
      const day = now.getDay();
      const hours = now.getHours();
      const minutes = now.getMinutes();
      const timeInMinutes = hours * 60 + minutes;

      const badge = document.getElementById('liveStatusBadge');
      const text = document.getElementById('liveStatusText');
      if (!badge || !text) return;

      let isOpen = false;
      let closeTimeText = "9:00 PM";
      let nextOpenText = "10:00 AM";

      if (day === 5) {
        // Friday: 2:00 PM (14:00 = 840 mins) to 9:00 PM (21:00 = 1260 mins)
        if (timeInMinutes >= 14 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 14 * 60 ? "2:00 PM today" : "10:00 AM tomorrow";
        }
      } else {
        // Sat - Thu: 10:00 AM (600 mins) to 9:00 PM (1260 mins)
        if (timeInMinutes >= 10 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 10 * 60 ? "10:00 AM today" : (day === 4 ? "2:00 PM tomorrow (Fri)" : "10:00 AM tomorrow");
        }
      }

      if (isOpen) {
        badge.classList.remove('is-closed');
        badge.classList.add('is-open');
        text.innerText = `● OPEN NOW — Until ${closeTimeText}`;
      } else {
        badge.classList.remove('is-open');
        badge.classList.add('is-closed');
        text.innerText = `● CLOSED NOW — Opens ${nextOpenText}`;
      }
    }

    // Trigger AI Chatbot with Pretyped Question for Address/Directions
    function initAddressAIChat() {
      const btn = document.getElementById('btnAskAIAddress');
      if (!btn) return;

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const addressQuery = "Muje address samajh nahi aaya, aapka dukan daal kuan college road me kahan pr h?";
        
        if (typeof window.openALiFChat === 'function') {
          window.openALiFChat(addressQuery, true);
        } else {
          window.dispatchEvent(new CustomEvent('open-alif-chat', {
            detail: { message: addressQuery, autoSend: true }
          }));
          const chatBtn = document.getElementById('chat-button');
          if (chatBtn) chatBtn.click();
        }
      });
    }

    // Service Chips Selector Logic
    function initServiceChips() {
      const chips = document.querySelectorAll('.service-chip');
      chips.forEach(chip => {
        chip.addEventListener('click', function(e) {
          e.preventDefault();
          chips.forEach(c => c.classList.remove('is-selected'));
          this.classList.add('is-selected');
        });
      });
    }

    // WhatsApp Form Submission
    function initInquiryForm() {
      const form = document.getElementById('tailorInquiryForm');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        const nameInput = document.getElementById('inqName');
        const phoneInput = document.getElementById('inqPhone');
        const messageInput = document.getElementById('inqMessage');
        const selectedChip = document.querySelector('.service-chip.is-selected');

        const name = (nameInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();
        const service = selectedChip ? selectedChip.getAttribute('data-service') : 'General Inquiry';
        const notes = (messageInput?.value || '').trim();

        if (!name) {
          alert('Please enter your name.');
          nameInput?.focus();
          return;
        }

        if (!phone) {
          alert('Please enter your phone or WhatsApp number.');
          phoneInput?.focus();
          return;
        }

        // Format professional WhatsApp message
        let waText = `✨ *New Inquiry — ALIF Sahibganj*\n\n`;
        waText += `👤 *Client Name:* ${name}\n`;
        waText += `📞 *Phone/WhatsApp:* ${phone}\n`;
        waText += `🛍️ *Category / Service:* ${service}\n`;
        if (notes) {
          waText += `📝 *Notes/Requirements:* ${notes}\n`;
        }
        waText += `\n—\n_Sent via aliflt.com/contact-us_`;

        const waUrl = `https://wa.me/7250470009?text=${encodeURIComponent(waText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // 1-Tap Trigger for ALIF AI Assistant
    function initAICardTrigger() {
      const aiBtn = document.getElementById('actionAI');
      if (!aiBtn) return;
      aiBtn.addEventListener('click', function(e) {
        e.preventDefault();
        if (typeof window.openALiFChat === 'function') {
          window.openALiFChat();
        } else {
          const chatBtn = document.getElementById('chat-button');
          if (chatBtn) {
            chatBtn.click();
          }
        }
      });
    }

    // Page Load Handler
    function initContactPage() {
      updateLiveStoreStatus();
      initServiceChips();
      initInquiryForm();
      initAICardTrigger();
      initAddressAIChat();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactPage);
    } else {
      initContactPage();
    }
    document.addEventListener('astro:page-load', initContactPage);
  </script>

</BaseLayout>

