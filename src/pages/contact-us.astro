---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact & Visit Us | ALIF Ladies Tailor Sahibganj" 
  description="Visit ALIF Ladies Tailor at Daal Kuan, College Road, Sahibganj. Direct WhatsApp consultation, call 7250470009, Google Maps turn-by-turn directions, and shop timings."
>
  <div class="contact-page-wrapper">
    <div class="contact-container">
      
      <!-- Editorial Header -->
      <header class="contact-header">
        <span class="contact-eyebrow">EST. 2008 • BESPOKE COUTURE ATELIER</span>
        <h1 class="contact-title">CONTACT &amp; VISIT</h1>
        <p class="contact-subtitle">
          Experience personalized tailoring and bespoke craftsmanship. Connect directly with our master tailor or visit us in Sahibganj.
        </p>
      </header>

      <!-- Mobile-First 1-Tap Quick Action Bar -->
      <section class="quick-actions-grid" aria-label="Quick Contact Actions">
        <!-- WhatsApp -->
        <a 
          href="https://wa.me/7250470009?text=Hello%20ALIF,%20I%20have%20an%20inquiry%20regarding%20custom%20stitching%20and%20designs." 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-whatsapp"
          id="actionWhatsApp"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">FASTEST RESPONSE</span>
            <h2 class="quick-card-title">Chat on WhatsApp</h2>
            <span class="quick-card-value">+91 72504 70009</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>

        <!-- Call -->
        <a 
          href="tel:7250470009" 
          class="quick-card card-call"
          id="actionCall"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">INSTANT CALL</span>
            <h2 class="quick-card-title">Call Master Tailor</h2>
            <span class="quick-card-value">072504 70009</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>

        <!-- Directions (Opens turn-by-turn navigation directly) -->
        <a 
          href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="quick-card card-maps"
          id="actionMaps"
        >
          <div class="quick-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="quick-card-body">
            <span class="quick-card-tag">NAVIGATION</span>
            <h2 class="quick-card-title">Get Directions</h2>
            <span class="quick-card-value">6JRP+RQ Sahibganj</span>
          </div>
          <div class="quick-card-arrow">↗</div>
        </a>
      </section>

      <!-- Main Two-Column Atelier Showcase -->
      <div class="atelier-main-grid">

        <!-- Column 1: Boutique Location & Schedule Details -->
        <div class="atelier-details-column">
          
          <!-- Live Boutique Status Card -->
          <div class="atelier-card boutique-info-card">
            <div class="card-status-bar">
              <div class="status-indicator-badge" id="liveStatusBadge">
                <span class="status-dot"></span>
                <span class="status-text" id="liveStatusText">Checking Timings...</span>
              </div>
              <span class="status-timing-note">Open 7 Days a Week</span>
            </div>

            <div class="card-header-group">
              <span class="card-eyebrow">FLAGSHIP STORE</span>
              <h2 class="card-title">ALIF Ladies Tailor</h2>
            </div>

            <div class="address-content">
              <p class="address-line">
                <strong>Daal Kuan, College Road</strong><br />
                Opposite Joy Fast Food<br />
                Sahibganj, Jharkhand — 816109
              </p>
              <p class="landmark-hint">
                <span class="landmark-pin">📍</span> <strong>Easy Landmark:</strong> Enter the lane directly opposite Daal Kuan / Lakshmi Bag House.
              </p>
            </div>

            <!-- Action buttons inside card -->
            <div class="address-actions">
              <button type="button" class="btn-copy-address" id="btnCopyAddress">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <span id="copyBtnText">Copy Address</span>
              </button>
              <a 
                href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="btn-maps-link"
              >
                Get Directions ↗
              </a>
            </div>
          </div>

          <!-- Schedule & Hours Card -->
          <div class="atelier-card timings-card">
            <div class="card-header-group">
              <span class="card-eyebrow">BOUTIQUE TIMINGS</span>
              <h2 class="card-title">Working Hours</h2>
            </div>

            <ul class="timings-list">
              <li class="timings-row">
                <span class="timing-days">Saturday – Thursday</span>
                <span class="timing-hours">10:00 AM — 9:00 PM</span>
              </li>
              <li class="timings-row timing-friday">
                <span class="timing-days">Friday (After Jummah)</span>
                <span class="timing-hours">02:00 PM — 9:00 PM</span>
              </li>
              <li class="timings-row timing-highlight">
                <span class="timing-days">Weekly Off</span>
                <span class="timing-badge">None • Open 7 Days</span>
              </li>
            </ul>

            <div class="timings-footer-note">
              <span>Home measurements &amp; bridal consultations available by prior appointment.</span>
            </div>
          </div>

          <!-- Interactive Responsive Map Frame -->
          <div class="atelier-card map-card">
            <div class="map-container">
              <iframe 
                src="https://maps.google.com/maps?q=6JRP%2BRQ%20Sahibganj%2C%20Jharkhand&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                class="embedded-map-iframe" 
                title="ALIF Ladies Tailor Map Location" 
                loading="lazy" 
                allowfullscreen>
              </iframe>
            </div>
          </div>

        </div>

        <!-- Column 2: Mobile-First Bespoke Consultation Form -->
        <div class="atelier-form-column">
          <div class="atelier-card form-card">
            
            <div class="card-header-group">
              <span class="card-eyebrow">BESPOKE CONSULTATION</span>
              <h2 class="card-title">Book an Appointment or Inquiry</h2>
              <p class="form-desc">
                Tell us about your outfit requirements. Submit below to connect directly with our master tailor on WhatsApp.
              </p>
            </div>

            <form id="tailorInquiryForm" class="inquiry-form" novalidate>
              
              <!-- Floating Label: Full Name -->
              <div class="form-input-group">
                <input 
                  type="text" 
                  id="inqName" 
                  class="floating-input" 
                  placeholder=" " 
                  required 
                  autocomplete="name"
                />
                <label for="inqName" class="floating-label">YOUR FULL NAME *</label>
              </div>

              <!-- Floating Label: Phone / WhatsApp -->
              <div class="form-input-group">
                <input 
                  type="tel" 
                  id="inqPhone" 
                  class="floating-input" 
                  placeholder=" " 
                  required 
                  autocomplete="tel"
                />
                <label for="inqPhone" class="floating-label">PHONE / WHATSAPP NUMBER *</label>
              </div>

              <!-- Service Chips Selector (Mobile 1-Tap) -->
              <div class="service-selector-group">
                <span class="selector-heading">SELECT OUTFIT / SERVICE:</span>
                <div class="service-chips-grid" id="serviceChipsGrid">
                  <button type="button" class="service-chip is-selected" data-service="Designer Blouse">Designer Blouse</button>
                  <button type="button" class="service-chip" data-service="Bridal Lehenga">Bridal Lehenga</button>
                  <button type="button" class="service-chip" data-service="Salwar Suit / Kurti">Salwar Suit</button>
                  <button type="button" class="service-chip" data-service="Gown / Western Dress">Gown / Western</button>
                  <button type="button" class="service-chip" data-service="Saree Fall &amp; Pico">Saree Fall &amp; Pico</button>
                  <button type="button" class="service-chip" data-service="Laces &amp; Latkans Matching">Lace Matching</button>
                  <button type="button" class="service-chip" data-service="Other Custom Outfit">Custom Other</button>
                </div>
              </div>

              <!-- Floating Label: Message / Requirements -->
              <div class="form-input-group">
                <textarea 
                  id="inqMessage" 
                  class="floating-input floating-textarea" 
                  rows="3" 
                  placeholder=" "
                ></textarea>
                <label for="inqMessage" class="floating-label">YOUR DESIGN REQUIREMENTS / NOTES</label>
              </div>

              <!-- Submit Button (Direct WhatsApp Formatter) -->
              <div class="form-action-group">
                <button type="submit" class="btn-whatsapp-submit" id="btnSubmitInquiry">
                  <span class="btn-icon">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-2.18-.553-1.614-.668-2.671-2.278-2.752-2.387-.082-.108-.66-1.879-.66-1.688 0-.81.424-1.207.574-1.37.151-.162.33-.203.441-.203.11 0 .221.002.317.006.101.005.237-.038.371.284.144.346.494 1.203.538 1.291.044.088.073.191.015.306-.059.117-.088.191-.176.294-.088.103-.186.23-.265.31-.089.088-.182.183-.078.361.103.177.46 1.761 1.09 1.32.812.723 1.498.946 1.71.105.213.117.336.059.462-.059.125-.494-.573-.624-.725-.13-.153-.258-.13-.357-.088-.101.042-1.291.538-1.291.538z"/>
                      <path d="M12 2C6.477 2 2 6.477 2 12c0 1.891.524 3.662 1.436 5.179L2 22l4.981-1.309A9.957 9.957 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18.25c-1.637 0-3.167-.442-4.489-1.218l-.322-.19-2.964.778.791-2.89-.208-.33A8.204 8.204 0 0 1 3.75 12c0-4.549 3.701-8.25 8.25-8.25 4.549 0 8.25 3.701 8.25 8.25 0 4.549-3.701 8.25-8.25 8.25z"/>
                    </svg>
                  </span>
                  <span>SEND INQUIRY VIA WHATSAPP</span>
                </button>
              </div>

              <!-- Form Guarantee Note -->
              <p class="form-privacy-note">
                🔒 Your number is never shared. Direct communication with Master Tailor Arkam.
              </p>

            </form>

          </div>
        </div>

      </div>

      <!-- Atelier Trust & Perfection Pillars Grid -->
      <section class="trust-pillars-section" aria-label="Atelier Guarantees">
        <div class="trust-grid">
          
          <div class="trust-item">
            <span class="trust-icon">✂️</span>
            <div class="trust-content">
              <h3 class="trust-title">17+ Years Experience</h3>
              <p class="trust-desc">Serving Sahibganj with specialized women's couture tailoring since 2008.</p>
            </div>
          </div>

          <div class="trust-item">
            <span class="trust-icon">📏</span>
            <div class="trust-content">
              <h3 class="trust-title">Perfect Fit Guarantee</h3>
              <p class="trust-desc">Complimentary fitting adjustments until your garment sits flawlessly.</p>
            </div>
          </div>

          <div class="trust-item">
            <span class="trust-icon">⚡</span>
            <div class="trust-content">
              <h3 class="trust-title">Express Stitching</h3>
              <p class="trust-desc">Urgent bridal, festive &amp; emergency stitching available on request.</p>
            </div>
          </div>

          <div class="trust-item">
            <span class="trust-icon">🧵</span>
            <div class="trust-content">
              <h3 class="trust-title">Matching Laces &amp; Latkans</h3>
              <p class="trust-desc">Huge in-boutique inventory of premium designer trims &amp; hangings.</p>
            </div>
          </div>

        </div>
      </section>

    </div>
  </div>

  <!-- Interactive JavaScript Logic -->
  <script is:inline>
    // Live Timing Calculator based on Indian Standard Time
    function updateLiveBoutiqueStatus() {
      const now = new Date();
      // Current day in IST (0 = Sun, 1 = Mon, ..., 5 = Fri, 6 = Sat)
      const day = now.getDay();
      const hours = now.getHours();
      const minutes = now.getMinutes();
      const timeInMinutes = hours * 60 + minutes;

      const badge = document.getElementById('liveStatusBadge');
      const text = document.getElementById('liveStatusText');
      if (!badge || !text) return;

      let isOpen = false;
      let closeTimeText = "9:00 PM";
      let nextOpenText = "10:00 AM";

      if (day === 5) {
        // Friday: 2:00 PM (14:00 = 840 mins) to 9:00 PM (21:00 = 1260 mins)
        if (timeInMinutes >= 14 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 14 * 60 ? "2:00 PM today" : "10:00 AM tomorrow";
        }
      } else {
        // Sat - Thu: 10:00 AM (600 mins) to 9:00 PM (1260 mins)
        if (timeInMinutes >= 10 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 10 * 60 ? "10:00 AM today" : (day === 4 ? "2:00 PM tomorrow (Fri)" : "10:00 AM tomorrow");
        }
      }

      if (isOpen) {
        badge.classList.remove('is-closed');
        badge.classList.add('is-open');
        text.innerText = `● OPEN NOW — Closes ${closeTimeText}`;
      } else {
        badge.classList.remove('is-open');
        badge.classList.add('is-closed');
        text.innerText = `● CLOSED NOW — Opens ${nextOpenText}`;
      }
    }

    // 1-Tap Copy Address to Clipboard
    function initAddressCopy() {
      const btn = document.getElementById('btnCopyAddress');
      const textSpan = document.getElementById('copyBtnText');
      if (!btn || !textSpan) return;

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const address = "alif ladies tailor, daal kuan, college road, sahibganj. near joy fastfood";
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(address).then(() => {
            textSpan.innerText = "✓ Copied to Clipboard!";
            btn.classList.add('is-copied');
            setTimeout(() => {
              textSpan.innerText = "Copy Address";
              btn.classList.remove('is-copied');
            }, 2500);
          }).catch(() => fallbackCopy(address));
        } else {
          fallbackCopy(address);
        }

        function fallbackCopy(str) {
          const el = document.createElement('textarea');
          el.value = str;
          document.body.appendChild(el);
          el.select();
          document.execCommand('copy');
          document.body.removeChild(el);
          textSpan.innerText = "✓ Copied!";
          setTimeout(() => { textSpan.innerText = "Copy Address"; }, 2500);
        }
      });
    }

    // Service Chips Selector Logic
    function initServiceChips() {
      const chips = document.querySelectorAll('.service-chip');
      chips.forEach(chip => {
        chip.addEventListener('click', function(e) {
          e.preventDefault();
          chips.forEach(c => c.classList.remove('is-selected'));
          this.classList.add('is-selected');
        });
      });
    }

    // WhatsApp Form Submission
    function initInquiryForm() {
      const form = document.getElementById('tailorInquiryForm');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        const nameInput = document.getElementById('inqName');
        const phoneInput = document.getElementById('inqPhone');
        const messageInput = document.getElementById('inqMessage');
        const selectedChip = document.querySelector('.service-chip.is-selected');

        const name = (nameInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();
        const service = selectedChip ? selectedChip.getAttribute('data-service') : 'Bespoke Tailoring';
        const notes = (messageInput?.value || '').trim();

        if (!name) {
          alert('Please enter your name.');
          nameInput?.focus();
          return;
        }

        if (!phone) {
          alert('Please enter your phone or WhatsApp number.');
          phoneInput?.focus();
          return;
        }

        // Format professional WhatsApp message
        let waText = `✨ *New Tailoring Inquiry - ALIF Ladies Tailor*\n\n`;
        waText += `👤 *Client Name:* ${name}\n`;
        waText += `📞 *Phone/WhatsApp:* ${phone}\n`;
        waText += `👗 *Service Needed:* ${service}\n`;
        if (notes) {
          waText += `📝 *Notes/Requirements:* ${notes}\n`;
        }
        waText += `\n📍 *Sent from:* aliflt.com/contact-us/`;

        const waUrl = `https://wa.me/7250470009?text=${encodeURIComponent(waText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // Page Load Handler
    function initContactPage() {
      updateLiveBoutiqueStatus();
      initAddressCopy();
      initServiceChips();
      initInquiryForm();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactPage);
    } else {
      initContactPage();
    }
    document.addEventListener('astro:page-load', initContactPage);
  </script>

</BaseLayout>

<style>
  /* =========================================
     MOBILE-FIRST LUXURY CONTACT SECTION
     ========================================= */
  
  .contact-page-wrapper {
    background-color: transparent;
    padding: 30px 16px 60px 16px;
    font-family: var(--font-body, 'Poppins', sans-serif);
    color: #111111;
  }

  .contact-container {
    max-width: 1120px;
    margin: 0 auto;
  }

  /* --- EDITORIAL HEADER --- */
  .contact-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .contact-eyebrow {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #777777;
    margin-bottom: 8px;
  }

  .contact-title {
    font-family: var(--font-heading, 'Playfair Display', serif);
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #111111;
    margin: 0 0 12px 0;
    line-height: 1.15;
  }

  .contact-subtitle {
    font-size: 0.88rem;
    line-height: 1.6;
    color: #666666;
    max-width: 620px;
    margin: 0 auto;
    font-weight: 300;
  }

  /* --- MOBILE-FIRST QUICK ACTION BAR --- */
  .quick-actions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 36px;
  }

  .quick-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: #ffffff;
    border: 1px solid #111111;
    border-radius: 12px;
    text-decoration: none;
    color: #111111;
    box-shadow: 3px 3px 0px #111111;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    -webkit-tap-highlight-color: transparent;
  }

  .quick-card:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0px #111111;
  }

  .quick-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: #f4f4f4;
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .quick-card-icon svg {
    width: 22px;
    height: 22px;
    color: #111111;
  }

  .card-whatsapp .quick-card-icon {
    background: #e7f9ee;
    color: #25D366;
    border-color: #c0edd0;
  }

  .card-whatsapp .quick-card-icon svg {
    color: #25D366;
  }

  .card-maps .quick-card-icon {
    background: #eef5ff;
    color: #1877f2;
    border-color: #cbe0fe;
  }

  .card-maps .quick-card-icon svg {
    color: #1877f2;
  }

  .quick-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .quick-card-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #888888;
  }

  .quick-card-title {
    font-size: 0.98rem;
    font-weight: 600;
    margin: 0;
    color: #111111;
    letter-spacing: 0.3px;
  }

  .quick-card-value {
    font-size: 0.8rem;
    color: #555555;
    font-weight: 400;
  }

  .quick-card-arrow {
    font-size: 1.1rem;
    font-weight: 700;
    color: #888888;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .quick-card:hover .quick-card-arrow {
    color: #000000;
    transform: translate(3px, -3px);
  }

  /* --- MAIN TWO-COLUMN LAYOUT --- */
  .atelier-main-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 40px;
  }

  /* Shared Card Styles */
  .atelier-card {
    background: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 14px;
    padding: 24px 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .card-header-group {
    margin-bottom: 20px;
  }

  .card-eyebrow {
    display: block;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: #888888;
    margin-bottom: 6px;
