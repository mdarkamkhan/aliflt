---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Contact & Visit Us | ALIF Ladies Tailor Sahibganj" 
  description="Visit ALIF Ladies Tailor at Daal Kuan, College Road, Sahibganj. Store timings, call +91 72504 70009, WhatsApp chat, or get directions."
>
  <div class="zara-contact-page">
    <div class="zara-container">
      
      <!-- High-Fashion Editorial Header -->
      <header class="zara-header">
        <span class="zara-eyebrow">ATELIER &amp; STORE • SAHIBGANJ</span>
        <h1 class="zara-title">CONTACT &amp; VISIT</h1>
        <p class="zara-subtitle">
          Bespoke ladies tailoring, bridal embroidery, and designer fabric collection in Sahibganj.
        </p>
      </header>

      <!-- Store Trust & Perfection Pillars (Sticky Scroll-Driven Showcase) -->
      <div class="zara-trust-scroll-track" id="pillarScrollTrack">
        <section class="zara-trust-section" id="pillarStickySection" aria-label="ALIF Guarantees">
          
          <!-- Section Header (Fitted on the locked screen) -->
          <div class="zara-trust-head">
            <h2 class="zara-trust-title">
              <span>WHY SAHIBGANJ CHOOSES</span>
              <span class="zara-trust-brand">ALIF</span>
            </h2>
          </div>

          <!-- Interactive 2-Column Layout -->
          <div class="pillar-system-grid">
            
            <!-- Column 1: Interactive Capsule Ticker (Slim 52px Pills) -->
            <div class="pillar-ticker-col">
              <div 
                class="pillar-ticker-box" 
                id="pillarTickerBox" 
                tabindex="0" 
                role="region" 
                aria-label="The ALIF Standard Interactive Pillars"
              >
                <!-- Top and bottom gradient fades for vertical ticker effect -->
                <div class="pillar-gradient-top"></div>
                <div class="pillar-gradient-bottom"></div>

                <!-- Sliding Track -->
                <div class="pillar-track" id="pillarTrack">
                  <!-- Pillar 01 -->
                  <button 
                    type="button" 
                    class="pillar-pill is-active" 
                    data-index="0" 
                    aria-selected="true" 
                    role="tab"
                  >
                    <span class="pillar-pill-title">17+ Years Legacy</span>
                    <span class="pillar-pill-num">01</span>
                  </button>

                  <!-- Pillar 02 -->
                  <button 
                    type="button" 
                    class="pillar-pill is-near" 
                    data-index="1" 
                    aria-selected="false" 
                    role="tab"
                  >
                    <span class="pillar-pill-title">Perfect Fit Guarantee</span>
                    <span class="pillar-pill-num">02</span>
                  </button>

                  <!-- Pillar 03 -->
                  <button 
                    type="button" 
                    class="pillar-pill is-far" 
                    data-index="2" 
                    aria-selected="false" 
                    role="tab"
                  >
                    <span class="pillar-pill-title">Express Processing</span>
                    <span class="pillar-pill-num">03</span>
                  </button>

                  <!-- Pillar 04 -->
                  <button 
                    type="button" 
                    class="pillar-pill is-far" 
                    data-index="3" 
                    aria-selected="false" 
                    role="tab"
                  >
                    <span class="pillar-pill-title">Matching Trims &amp; Laces</span>
                    <span class="pillar-pill-num">04</span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Column 2: Active Detail Card (Crisp & High-Fashion) -->
            <div class="pillar-detail-col">
              <div class="pillar-detail-box" id="pillarDetailBox" aria-live="polite">
                <div class="pillar-detail-inner" id="pillarDetailInner">
                  <h3 class="pillar-detail-title" id="activePillarTitle">17+ Years Legacy</h3>
                  <p class="pillar-detail-desc" id="activePillarDesc">
                    Specialized in women's bespoke tailoring, bridal craft, and fine fabrics in Sahibganj since 2008. Handcrafted by master artisans with generational cutting expertise.
                  </p>
                </div>
              </div>
            </div>

          </div>
        </section>
      </div>

      <!-- Main Open Editorial Layout (No Box Containers) -->
      <div class="zara-main-grid">

        <!-- Column 1: The Store & Visit (Ultra-Clean Editorial Layout) -->
        <div class="zara-col-store">
          
          <div class="zara-atelier-card">
            <div class="zara-atelier-header">
              <span class="zara-col-eyebrow">SAHIBGANJ</span>
              <h2 class="zara-col-title">Our Store</h2>
            </div>

            <!-- Minimalist Pure Typography Switcher -->
            <div class="atelier-tabs-row" role="tablist" aria-label="Store Details">
              <button 
                type="button" 
                class="atelier-tab-btn is-active" 
                id="tabBtnLocation" 
                role="tab" 
                aria-selected="true" 
                aria-controls="panelLocation"
              >
                <span>LOCATION</span>
              </button>
              <button 
                type="button" 
                class="atelier-tab-btn" 
                id="tabBtnTimings" 
                role="tab" 
                aria-selected="false" 
                aria-controls="panelTimings"
              >
                <span>TIMINGS</span>
              </button>
            </div>

            <!-- Tab 1: Location Panel -->
            <div class="atelier-tab-panel is-active" id="panelLocation" role="tabpanel" aria-labelledby="tabBtnLocation">
              <div class="zara-atelier-meta">
                <p class="zara-atelier-address">
                  Daal Kuan, College Road<br />
                  <span class="zara-atelier-landmark">Opposite Joy Fast Food · 816109</span>
                </p>
              </div>

              <!-- Action Duo: Minimalist Editorial Action Chips -->
              <div class="zara-actions-row">
                <a 
                  href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="zara-action-chip"
                >
                  <span>GET DIRECTIONS</span>
                </a>

                <button 
                  type="button" 
                  class="zara-ai-sparkle-btn" 
                  id="btnAskAIAddress"
                  title="Ask AI Assistant for exact shop directions"
                >
                  <span class="dots_border" aria-hidden="true"></span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="sparkle" aria-hidden="true">
                    <path class="path" strokeLinejoin="round" strokeLinecap="round" stroke="currentColor" fill="currentColor" d="M14.187 8.096L15 5.25L15.813 8.096C16.0231 8.83114 16.4171 9.50062 16.9577 10.0413C17.4984 10.5819 18.1679 10.9759 18.903 11.186L21.75 12L18.904 12.813C18.1689 13.0231 17.4994 13.4171 16.9587 13.9577C16.4181 14.4984 16.0241 15.1679 15.814 15.903L15 18.75L14.187 15.904C13.9769 15.1689 13.5829 14.4994 13.0423 13.9587C12.5016 13.4181 11.8321 13.0241 11.097 12.814L8.25 12L11.096 11.187C11.8311 10.9769 12.5006 10.5829 13.0413 10.0423C13.5819 9.50162 13.9759 8.83214 14.186 8.097L14.187 8.096Z" />
                    <path class="path" strokeLinejoin="round" strokeLinecap="round" stroke="currentColor" fill="currentColor" d="M6 14.25L5.741 15.285C5.59267 15.8785 5.28579 16.4206 4.85319 16.8532C4.42059 17.2858 3.87853 17.5927 3.285 17.741L2.25 18L3.285 18.259C3.87853 18.4073 4.42059 18.7142 4.85319 19.1468C5.28579 19.5794 5.59267 20.1215 5.741 20.715L6 21.75L6.259 20.715C6.40725 20.1216 6.71398 19.5796 7.14639 19.147C7.5788 18.7144 8.12065 18.4075 8.714 18.259L9.75 18L8.714 17.741C8.12065 17.5925 7.5788 17.2856 7.14639 16.853C6.71398 16.4204 6.40725 15.8784 6.259 15.285L6 14.25Z" />
                    <path class="path" strokeLinejoin="round" strokeLinecap="round" stroke="currentColor" fill="currentColor" d="M6.5 4L6.303 4.5915C6.24777 4.75718 6.15472 4.90774 6.03123 5.03123C5.90774 5.15472 5.75718 5.24777 5.5915 5.303L5 5.5L5.5915 5.697C5.75718 5.75223 5.90774 5.84528 6.03123 5.96877C6.15472 6.09226 6.24777 6.24282 6.303 6.4085L6.5 7L6.697 6.4085C6.75223 6.24282 6.84528 6.09226 6.96877 5.96877C7.09226 5.84528 7.24282 5.75223 7.4085 5.697L8 5.5L7.4085 5.303C7.24282 5.24777 7.09226 5.15472 6.96877 5.03123C6.84528 4.90774 6.75223 4.75718 6.697 4.5915L6.5 4Z" />
                  </svg>
                  <span class="text_button">ASK ALIF AI</span>
                </button>
              </div>
            </div>

            <!-- Tab 2: Timings Panel -->
            <div class="atelier-tab-panel" id="panelTimings" role="tabpanel" aria-labelledby="tabBtnTimings" hidden>
              <div class="zara-atelier-timings-block">
                <div class="zara-status-line" id="liveStatusBadge">
                  <span class="zara-status-dot"></span>
                  <span class="zara-status-text" id="liveStatusText">Verifying Store Timings...</span>
                </div>

                <div class="zara-hours-clean">
                  <div class="hours-row">
                    <span class="hours-day">Saturday — Thursday</span>
                    <span class="hours-time">10:00 AM — 9:00 PM</span>
                  </div>
                  <div class="hours-row">
                    <span class="hours-day">Friday</span>
                    <span class="hours-time">2:00 PM — 9:00 PM</span>
                  </div>
                </div>
              </div>

              <!-- Timing Action Duo: Direct Call / WhatsApp Chips -->
              <div class="zara-actions-row">
                <a 
                  href="https://wa.me/917250470009?text=Hi%20ALIF,%20I%20would%20like%20to%20inquire%20about%20visiting%20the%20store." 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="zara-action-chip"
                >
                  <span>CHAT ON WHATSAPP</span>
                </a>

                <a 
                  href="tel:+917250470009" 
                  class="zara-action-chip"
                  title="Call ALIF Ladies Tailor store"
                >
                  <span>CALL STORE</span>
                </a>
              </div>
            </div>

            <!-- Full-Bleed 3:4 Map Frame (No Left/Right Spacing, Pure Monochrome - Stays Visible in Both Tabs) -->
            <div class="zara-map-frame">
              <iframe 
                src="https://maps.google.com/maps?q=6JRP%2BRQ%20Sahibganj%2C%20Jharkhand&t=&z=16&ie=UTF8&iwloc=&output=embed" 
                class="zara-map-iframe" 
                title="ALIF Ladies Tailor Map Location" 
                loading="lazy" 
                allowfullscreen>
              </iframe>
              <div class="zara-map-bar">
                <a 
                  href="https://www.google.com/maps/dir/?api=1&destination=6JRP%2BRQ+Sahibganj,+Jharkhand" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="zara-map-link"
                >
                  OPEN IN GOOGLE MAPS ↗
                </a>
              </div>
            </div>
          </div>

        </div>

        <!-- Column 2: Form (Minimalist Luxury Bespoke Inquiry) -->
        <div class="zara-col-form">
          
          <div class="zara-form-header">
            <span class="zara-col-eyebrow">BESPOKE ATELIER</span>
            <h2 class="zara-col-title">Online Inquiry</h2>
          </div>
          <p class="element-form-desc">Inquire about custom tailoring, bridal lehengas, or fine fabric collections.</p>

          <form id="tailorInquiryForm" class="element-form-body" novalidate>
            
            <!-- Full Name Input from ELEMENTS/form (Refined 1px Architectural Hairline) -->
            <div class="inputBox">
              <input 
                type="text" 
                id="inqName" 
                required="required" 
                autocomplete="name"
              />
              <span class="user">Full Name</span>
            </div>

            <!-- Phone / WhatsApp Input from ELEMENTS/form (Refined 1px Architectural Hairline) -->
            <div class="inputBox">
              <input 
                type="tel" 
                id="inqPhone" 
                required="required" 
                autocomplete="tel"
              />
              <span>Phone / WhatsApp</span>
            </div>

            <!-- Category Chips Selector (Horizontal Smooth Swipe Rail - Option A) -->
            <div class="element-category-group">
              <span class="element-category-title">Select Category</span>
              <div class="element-chips-grid" id="serviceChipsGrid">
                <button type="button" class="service-chip is-selected" data-service="Designer Blouse">Designer Blouse</button>
                <button type="button" class="service-chip" data-service="Bridal Lehenga">Bridal Lehenga</button>
                <button type="button" class="service-chip" data-service="Salwar Suit">Salwar Suit</button>
                <button type="button" class="service-chip" data-service="Fabrics &amp; Material">Fabrics &amp; Material</button>
                <button type="button" class="service-chip" data-service="Laces &amp; Latkans">Laces &amp; Latkans</button>
                <button type="button" class="service-chip" data-service="Saree Fall &amp; Pico">Saree Fall &amp; Pico</button>
                <button type="button" class="service-chip" data-service="Gown / Western Dress">Gown &amp; Western</button>
                <button type="button" class="service-chip" data-service="Other Inquiry">Other Inquiry</button>
              </div>
            </div>

            <!-- Message / Requirements Input (Required - Not Optional) -->
            <div class="inputBox inputBox-textarea">
              <textarea 
                id="inqMessage" 
                required="required"
                placeholder=" " 
                rows="3"
              ></textarea>
              <span>Requirements</span>
            </div>

            <!-- Enter Submit Button (Solid Black Luxury Statement Bar) -->
            <button type="submit" class="enter" id="btnSubmitInquiry">
              <span>SEND VIA WHATSAPP</span>
            </button>

            <!-- Confidential note -->
            <p class="element-privacy-note">
              DIRECT STORE ASSISTANCE • 100% PRIVATE • ZERO SPAM
            </p>

          </form>

        </div>

      </div>

    </div>
  </div>

  <!-- Interactive JavaScript Logic -->
  <script is:inline>
    // Live Timing Calculator based on Indian Standard Time
    function updateLiveStoreStatus() {
      const now = new Date();
      // Current day in IST (0 = Sun, 1 = Mon, ..., 5 = Fri, 6 = Sat)
      const day = now.getDay();
      const hours = now.getHours();
      const minutes = now.getMinutes();
      const timeInMinutes = hours * 60 + minutes;

      const badge = document.getElementById('liveStatusBadge');
      const text = document.getElementById('liveStatusText');
      if (!badge || !text) return;

      let isOpen = false;
      let closeTimeText = "9:00 PM";
      let nextOpenText = "10:00 AM";

      if (day === 5) {
        // Friday: 2:00 PM (14:00 = 840 mins) to 9:00 PM (21:00 = 1260 mins)
        if (timeInMinutes >= 14 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 14 * 60 ? "2:00 PM today" : "10:00 AM tomorrow";
        }
      } else {
        // Sat - Thu: 10:00 AM (600 mins) to 9:00 PM (1260 mins)
        if (timeInMinutes >= 10 * 60 && timeInMinutes < 21 * 60) {
          isOpen = true;
          closeTimeText = "9:00 PM";
        } else {
          nextOpenText = timeInMinutes < 10 * 60 ? "10:00 AM today" : (day === 4 ? "2:00 PM tomorrow (Fri)" : "10:00 AM tomorrow");
        }
      }

      if (isOpen) {
        badge.classList.remove('is-closed');
        badge.classList.add('is-open');
        text.innerText = `OPEN TODAY — UNTIL ${closeTimeText}`;
      } else {
        badge.classList.remove('is-open');
        badge.classList.add('is-closed');
        text.innerText = `CLOSED NOW — OPENS ${nextOpenText}`;
      }
    }

    // Trigger AI Chatbot with Pretyped Question for Address/Directions
    function initAddressAIChat() {
      const btn = document.getElementById('btnAskAIAddress');
      if (!btn) return;

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const addressQuery = "Muje address samajh nahi aaya, aapka dukan daal kuan college road me kahan pr h?";
        
        if (typeof window.openALiFChat === 'function') {
          window.openALiFChat(addressQuery, true);
        } else {
          window.dispatchEvent(new CustomEvent('open-alif-chat', {
            detail: { message: addressQuery, autoSend: true }
          }));
          const chatBtn = document.getElementById('chat-button');
          if (chatBtn) chatBtn.click();
        }
      });
    }

    // Service Chips Selector Logic
    function initServiceChips() {
      const chips = document.querySelectorAll('.service-chip');
      chips.forEach(chip => {
        chip.addEventListener('click', function(e) {
          e.preventDefault();
          chips.forEach(c => c.classList.remove('is-selected'));
          this.classList.add('is-selected');
        });
      });
    }

    // WhatsApp Form Submission
    function initInquiryForm() {
      const form = document.getElementById('tailorInquiryForm');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        const nameInput = document.getElementById('inqName');
        const phoneInput = document.getElementById('inqPhone');
        const messageInput = document.getElementById('inqMessage');
        const selectedChip = document.querySelector('.service-chip.is-selected');

        const name = (nameInput?.value || '').trim();
        const phone = (phoneInput?.value || '').trim();
        const service = selectedChip ? selectedChip.getAttribute('data-service') : 'General Inquiry';
        const notes = (messageInput?.value || '').trim();

        if (!name) {
          alert('Please enter your name.');
          nameInput?.focus();
          return;
        }

        if (!phone) {
          alert('Please enter your phone or WhatsApp number.');
          phoneInput?.focus();
          return;
        }

        if (!notes) {
          alert('Please enter your requirements.');
          messageInput?.focus();
          return;
        }

        // Format professional WhatsApp message
        let waText = `✨ *New Inquiry — ALIF Sahibganj*\n\n`;
        waText += `👤 *Client Name:* ${name}\n`;
        waText += `📞 *Phone/WhatsApp:* ${phone}\n`;
        waText += `🛍️ *Category / Service:* ${service}\n`;
        waText += `📝 *Requirements:* ${notes}\n`;
        waText += `\n—\n_Sent via aliflt.com/contact-us_`;

        const waUrl = `https://wa.me/7250470009?text=${encodeURIComponent(waText)}`;
        window.open(waUrl, '_blank', 'noopener,noreferrer');
      });
    }

    // The System Interactive Pillar Showcase with Sticky Scroll-Driven Pinning
    function initPillarSystem() {
      const pillars = [
        {
          index: "01",
          title: "17+ Years Legacy",
          desc: "Specialized in women's bespoke tailoring, bridal craft, and fine fabrics in Sahibganj since 2008. Handcrafted by master artisans with generational cutting expertise."
        },
        {
          index: "02",
          title: "Perfect Fit Guarantee",
          desc: "Every cut is customized to your exact posture and drape, with complimentary fit adjustments until your silhouette feels flawless."
        },
        {
          index: "03",
          title: "Express Processing",
          desc: "Urgent bridal, festive, and emergency stitching orders expedited upon request without compromising stitch precision or finish quality."
        },
        {
          index: "04",
          title: "Matching Trims & Laces",
          desc: "Sahibganj's premier collection of designer borders, zari trims, and handcrafted latkans in-store, perfectly coordinated to match your custom garment."
        }
      ];

      const scrollTrack = document.getElementById('pillarScrollTrack');
      const stickySection = document.getElementById('pillarStickySection');
      const track = document.getElementById('pillarTrack');
      const pills = document.querySelectorAll('.pillar-pill');
      const detailInner = document.getElementById('pillarDetailInner');
      const activeTitle = document.getElementById('activePillarTitle');
      const activeDesc = document.getElementById('activePillarDesc');

      if (!track || !pills.length || !detailInner || !scrollTrack || !stickySection) return;

      let currentIndex = 0;
      let isProgrammaticScroll = false;

      function getStep() {
        return window.innerWidth < 860 ? 62 : 70;
      }

      function selectPillar(idx, animateDetail = true) {
        if (idx < 0 || idx >= pillars.length) return;
        currentIndex = idx;
        const current = pillars[currentIndex];
        const step = getStep();

        // 1. Update pills classes
        pills.forEach((pill, i) => {
          pill.classList.remove('is-active', 'is-near', 'is-far');
          const dist = Math.abs(i - currentIndex);
          if (dist === 0) {
            pill.classList.add('is-active');
            pill.setAttribute('aria-selected', 'true');
          } else if (dist === 1) {
            pill.classList.add('is-near');
            pill.setAttribute('aria-selected', 'false');
          } else {
            pill.classList.add('is-far');
            pill.setAttribute('aria-selected', 'false');
          }
        });

        // 2. Adjust track position
        track.style.transform = `translateY(${-currentIndex * step}px)`;

        // 3. Update detail card
        if (animateDetail) {
          detailInner.classList.add('is-switching');
          setTimeout(() => {
            if (activeTitle) activeTitle.textContent = current.title;
            if (activeDesc) activeDesc.textContent = current.desc;
            detailInner.classList.remove('is-switching');
          }, 140);
        } else {
          if (activeTitle) activeTitle.textContent = current.title;
          if (activeDesc) activeDesc.textContent = current.desc;
        }
      }

      // Scroll-Driven Progression Engine
      function handleScrollDrivenPillars() {
        if (isProgrammaticScroll) return;

        const isMobile = window.innerWidth < 860;
        const stickyTop = isMobile ? 68 : 80;
        const trackRect = scrollTrack.getBoundingClientRect();
        const sectionHeight = stickySection.offsetHeight;
        const totalScrollDistance = scrollTrack.offsetHeight - sectionHeight;

        if (totalScrollDistance <= 0) return;

        // How much have we scrolled past the point where the section pins?
        const scrolledPast = stickyTop - trackRect.top;
        const progress = Math.max(0, Math.min(1, scrolledPast / totalScrollDistance));

        // Map progress 0.0 – 1.0 smoothly to pillars (0, 1, 2, 3)
        const targetIndex = Math.min(3, Math.floor(progress * 4));

        if (targetIndex !== currentIndex) {
          selectPillar(targetIndex, true);
        }
      }

      // Optimized scroll listener using requestAnimationFrame
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            handleScrollDrivenPillars();
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });

      // Click pill to sync both active pillar & page scroll position
      pills.forEach((pill) => {
        pill.addEventListener('click', () => {
          const idx = parseInt(pill.getAttribute('data-index') || '0', 10);
          selectPillar(idx, true);

          const isMobile = window.innerWidth < 860;
          const stickyTop = isMobile ? 68 : 80;
          const trackTop = scrollTrack.getBoundingClientRect().top + window.scrollY;
          const sectionHeight = stickySection.offsetHeight;
          const totalScrollDistance = scrollTrack.offsetHeight - sectionHeight;

          // Target center of target pillar slot
          const targetProgress = (idx + 0.5) / 4;
          const targetScrollY = trackTop - stickyTop + (targetProgress * totalScrollDistance);

          isProgrammaticScroll = true;
          window.scrollTo({
            top: targetScrollY,
            behavior: 'smooth'
          });
          setTimeout(() => {
            isProgrammaticScroll = false;
          }, 600);
        });
      });

      // Window resize listener
      window.addEventListener('resize', () => {
        const step = getStep();
        track.style.transform = `translateY(${-currentIndex * step}px)`;
      }, { passive: true });

      // Initial check on load
      handleScrollDrivenPillars();
    }

    // Atelier 2-Segment Switcher (Location vs Timings)
    function initAtelierTabs() {
      const tabLoc = document.getElementById('tabBtnLocation');
      const tabTime = document.getElementById('tabBtnTimings');
      const panelLoc = document.getElementById('panelLocation');
      const panelTime = document.getElementById('panelTimings');
      if (!tabLoc || !tabTime || !panelLoc || !panelTime) return;

      function switchTab(target) {
        if (target === 'location') {
          tabLoc.classList.add('is-active');
          tabLoc.setAttribute('aria-selected', 'true');
          tabTime.classList.remove('is-active');
          tabTime.setAttribute('aria-selected', 'false');

          panelLoc.classList.add('is-active');
          panelLoc.hidden = false;
          panelTime.classList.remove('is-active');
          panelTime.hidden = true;
        } else {
          tabTime.classList.add('is-active');
          tabTime.setAttribute('aria-selected', 'true');
          tabLoc.classList.remove('is-active');
          tabLoc.setAttribute('aria-selected', 'false');

          panelTime.classList.add('is-active');
          panelTime.hidden = false;
          panelLoc.classList.remove('is-active');
          panelLoc.hidden = true;
        }
      }

      tabLoc.addEventListener('click', () => switchTab('location'));
      tabTime.addEventListener('click', () => switchTab('timings'));
    }

    // Page Load Handler
    function initContactPage() {
      updateLiveStoreStatus();
      initAtelierTabs();
      initServiceChips();
      initInquiryForm();
      initAddressAIChat();
      initPillarSystem();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initContactPage);
    } else {
      initContactPage();
    }
    document.addEventListener('astro:page-load', initContactPage);
  </script>

</BaseLayout>

