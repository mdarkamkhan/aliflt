                            </svg>
                        </a>
                        <div class="tooltip">Instagram</div>
                    </li>
                    <li class="icon-content">
                        <a href="https://www.snapchat.com/add/alif_lstr" target="_blank" rel="noopener noreferrer" aria-label="Snapchat" data-social="snapchat" class="link">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                <path d="M12.001 2.2c-3.1 0-5.2 2.2-5.2 5 0 .9.3 2 .5 2.6-.3.1-.9.4-1.4.5-.4.1-.7.4-.7.8 0 .5.4.9.9 1 .4.1.8 0 1.2-.1.2.9.8 1.9 1.9 2.4-.2.4-.7.7-1.3.9-.7.2-1.4.5-1.4 1.3 0 .7.6 1.2 1.5 1.2.6 0 1.4-.2 2.1-.6.6.6 1.4.9 2 .9.6 0 1.4-.3 2-.9.7.4 1.5.6 2.1.6.9 0 1.5-.5 1.5-1.2 0-.8-.7-1.1-1.4-1.3-.6-.2-1.1-.5-1.3-.9 1.1-.5 1.7-1.5 1.9-2.4.4.1.8.2 1.2.1.5-.1.9-.5.9-1 0-.4-.3-.7-.7-.8-.5-.1-1.1-.4-1.4-.5.2-.6.5-1.7.5-2.6 0-2.8-2.1-5-5.2-5z"/>
