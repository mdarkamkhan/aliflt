---
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

import AIChatWidget from '../components/AIChatWidget';
import SearchModal from '../components/SearchModal';

const {
  title = "ALiF Ladies Tailor",
  description = "Custom bridal blouses, lehengas, gowns — premium ladies tailoring in Sahibganj.",
  image = "/icons/icon-512x512.png",
} = Astro.props;

const siteUrl = "https://aliflt.netlify.app";
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>{title} | ALiF</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <meta name="theme-color" content="#FBF9F6"/>

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/favicon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Playfair+Display:wght@400;500&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=luxury2025">
</head>

<body>
    <!-- Fixed Background Canvas from ELEMENTS/BG -->
    <div id="fixed-bg-pattern" aria-hidden="true"></div>

    <!-- React Island: Search Overlay with Fuse.js & Typewriter -->
    <SearchModal client:idle />

    <!-- Fixed Top Nav -->
    <nav class="fixed-top-nav">
        <a href="/" class="nav-logo">ALiF</a>

        <div class="nav-actions">
            <button class="nav-search-btn" id="open-search" style="background:none; border:none; padding:5px; cursor:pointer;" aria-label="Search">
                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" style="color:#000;">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>

            <a href="/cart/" class="nav-cart-btn" id="cartIcon" aria-label="View Cart">
                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" style="color:#000;">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="cart-count" id="cartCount">0</span>
            </a>

            <button class="nav-toggle-btn" id="navToggleBtn" style="background:none; border:none; padding:5px; cursor:pointer; display:flex; align-items:center;" aria-label="Open menu">
                <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" style="color:#000;">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Marquee Banner -->
    <div class="marquee-container">
        <div class="marquee-content">
            • ALiF LADIES TAILOR • NEW COLLECTION 2025 • CUSTOM BRIDAL WEAR • BOOK YOUR APPOINTMENT • ALiF LADIES TAILOR • LUXURY STITCHING •
        </div>
    </div>

    <!-- Main Content -->
    <main>
        <slot />
    </main>

    <!-- Bottom Navigation Bar (Mobile) -->
    <nav class="bottom-nav">
        <a href="/" class={`b-nav-item ${currentPath === '/' ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
            Home
        </a>
        <a href="/products/" class={`b-nav-item ${currentPath.startsWith('/products/') ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
            Products
        </a>
        <a href="/services/" class={`b-nav-item ${currentPath.startsWith('/services/') ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24"><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"></path><line x1="16" y1="8" x2="2" y2="22"></line><line x1="17.5" y1="15" x2="9" y2="15"></line></svg>
            Services
        </a>
        <a href="/cart/" class={`b-nav-item ${currentPath.startsWith('/cart/') ? 'active' : ''}`}>
            <div style="position: relative;">
                <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                <span class="mobile-badge" id="cartCountMobile">0</span>
            </div>
            Cart
        </a>
        <a href="/contact-us/" class={`b-nav-item ${currentPath.startsWith('/contact-us/') ? 'active' : ''}`}>
            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            Contact
        </a>
    </nav>

    <!-- Sidebar Menu Drawer -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <div class="sidebar-menu" id="sidebarMenu">
        <div class="sidebar-header">
            <button class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close menu">&times;</button>
        </div>
        <ul class="sidebar-links">
            <li><a href="/">Home</a></li>
            <li><a href="/products/">Products</a></li>
            <li><a href="/services/">Services</a></li>
            <li><a href="/works/">Our Works</a></li>
            <li><a href="/designs/">Designs</a></li>
            <li><a href="/contact-us/">Contact</a></li>
            <li><a href="/#reviews">Reviews</a></li>
        </ul>
        <div class="sidebar-footer-area">
            <h3 class="sidebar-heading">FOLLOW US</h3>
            <div class="sidebar-icons-row">
                <a href="https://instagram.com/alif_lstr" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg></a>
                <a href="https://wa.me/7250470009" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg></a>
            </div>
        </div>
    </div>

    <!-- Editorial Monochrome Luxury Footer (Zara / Celine Style) -->
    <footer class="site-footer prada-mobile-footer" id="reviews">
        <div class="footer-container">
            <!-- Brand Atelier Header -->
            <div class="footer-brand">
                <a href="/" class="footer-logo">ALiF</a>
                <p class="footer-tagline">ATELIER DE COUTURE • BESPOKE TAILORING</p>
            </div>

            <!-- Links Columns Grid -->
            <div class="footer-columns">
                <!-- Column 1: Collections -->
                <div class="footer-col">
                    <h4 class="footer-col-title">COLLECTIONS</h4>
                    <ul class="footer-links-list">
                        <li><a href="/products/">Products</a></li>
                        <li><a href="/services/">Tailoring Services</a></li>
                        <li><a href="/works/">Our Works</a></li>
                        <li><a href="/designs/">Custom Designs</a></li>
                    </ul>
                </div>

                <!-- Column 2: Client Care -->
                <div class="footer-col">
                    <h4 class="footer-col-title">CLIENT CARE</h4>
                    <ul class="footer-links-list">
                        <li><a href="/contact-us/">Contact Atelier</a></li>
                        <li><a href="/privacy-policy/">Privacy Policy</a></li>
                        <li><a href="/terms-of-service/">Terms of Service</a></li>
                        <li><a href="/return-policy/">Return & Exchange</a></li>
                    </ul>
                </div>

                <!-- Column 3: Experience & Reviews -->
                <div class="footer-col">
                    <h4 class="footer-col-title">EXPERIENCE</h4>
                    <ul class="footer-links-list">
                        <li><a href="https://g.page/r/Cf2GRfVJZtFFEAE/review" target="_blank" rel="noopener noreferrer">Google Reviews (4.9 ★) <span class="footer-arrow">↗</span></a></li>
                        <li><a href="https://g.page/r/Cf2GRfVJZtFFEAE/review" target="_blank" rel="noopener noreferrer">Leave an Atelier Review <span class="footer-arrow">↗</span></a></li>
                    </ul>
                </div>
            </div>

            <!-- Doodle Notebook Social Section from ELEMENTS/social icons -->
            <div class="footer-doodle-social-wrapper">
                <span class="footer-col-title doodle-social-heading">CONNECT WITH US</span>
                <svg style="visibility: hidden; position: absolute;" width="0" height="0" xmlns="http://www.w3.org/2000/svg" version="1.1">
                    <defs>
                        <filter id="pencil-texture" x="-30%" y="-200%" width="160%" height="400%">
                            <feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="3" result="noise" />
                            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
                        </filter>
                    </defs>
                </svg>
                <ul class="doodle-container">
                    <!-- Instagram -->
                    <li class="doodle-icon-content">
                        <button type="button" aria-label="Instagram (@alif_lstr)" class="doodle-link link-instagram">
                            <svg class="doodle-svg" version="1.1" viewBox="0 0 100 100">
                                <path class="doodle-path" d="M60 45a15 15 0 1 0 -4.395 10.61A14.4 14.4 0 0 0 60 45.225l-0.004 -0.237zm8.1 0a23.006 23.006 0 1 1 -6.738 -16.347 22.2 22.2 0 0 1 6.742 15.96l-0.004 0.41v-0.02zm6.327 -24.022v0.008a5.4 5.4 0 1 1 -1.582 -3.818 5.177 5.177 0 0 1 1.556 3.705v0.11zm-29.4 -12.9 -4.482 -0.03q-4.072 -0.03 -6.184 0t-5.655 0.176a47.143 47.143 0 0 0 -6.312 0.638l0.273 -0.038a23.571 23.571 0 0 0 -4.362 1.136l0.16 -0.052a15.446 15.446 0 0 0 -8.52 8.452l-0.038 0.102a22.543 22.543 0 0 0 -1.065 4.062l-0.02 0.138a45 45 0 0 0 -0.597 5.96l-0.004 0.08q-0.147 3.548 -0.176 5.655t0 6.184 0.03 4.482 -0.03 4.482 0 6.184 0.176 5.655c0.075 2.193 0.292 4.275 0.638 6.312l-0.038 -0.273a23.571 23.571 0 0 0 1.136 4.362l-0.052 -0.16a15.446 15.446 0 0 0 8.452 8.52l0.102 0.038c1.192 0.446 2.606 0.82 4.062 1.065l0.138 0.02c1.758 0.308 3.84 0.525 5.955 0.597l0.08 0.004q3.548 0.147 5.655 0.176t6.184 0l4.455 -0.09 4.482 0.03q4.072 0.03 6.184 0t5.655 -0.176a47.143 47.143 0 0 0 6.312 -0.638l-0.273 0.038a23.571 23.571 0 0 0 4.362 -1.136l-0.16 0.052a15.446 15.446 0 0 0 8.52 -8.452l0.038 -0.102c0.446 -1.192 0.82 -2.606 1.065 -4.062l0.02 -0.138c0.308 -1.758 0.525 -3.84 0.597 -5.955l0.004 -0.08q0.147 -3.548 0.176 -5.655t0 -6.184 -0.03 -4.482 0.03 -4.482 0 -6.184 -0.176 -5.655a47.143 47.143 0 0 0 -0.638 -6.312l0.038 0.273a23.743 23.743 0 0 0 -1.136 -4.362l0.052 0.16a15.446 15.446 0 0 0 -8.452 -8.52l-0.102 -0.038a22.543 22.543 0 0 0 -4.062 -1.065l-0.138 -0.02a45 45 0 0 0 -5.955 -0.597l-0.08 -0.004q-3.548 -0.147 -5.655 -0.176t-6.184 0zM90 45q0 13.418 -0.3 18.574a24.9 24.9 0 0 1 -26.194 26.13l0.06 0.004q-5.157 0.3 -18.574 0.3t-18.574 -0.3A24.9 24.9 0 0 1 0.286 63.514l-0.004 0.06q-0.3 -5.157 -0.3 -18.574t0.3 -18.574A24.9 24.9 0 0 1 26.478 0.297l-0.058 -0.005q5.157 -0.3 18.574 -0.3t18.574 0.3a24.9 24.9 0 0 1 26.13 26.194l0.004 -0.06Q90 31.578 90 45" />
                            </svg>
                        </button>
                        <a href="https://instagram.com/alif_lstr" target="_blank" rel="noopener noreferrer" class="doodle-tooltip tooltip-instagram" title="Open @alif_lstr on Instagram">
                            @alif_lstr <span class="doodle-tooltip-arrow">↗</span>
                        </a>
                    </li>

                    <!-- Facebook -->
                    <li class="doodle-icon-content">
                        <button type="button" aria-label="Facebook (@alifladiestailor)" class="doodle-link link-facebook">
                            <svg class="doodle-svg doodle-svg-fb" viewBox="0 0 24 24" width="22" height="22" fill="#ffffff">
                                <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.326-.043-1.5-.14-2.75-.14-2.76 0-4.75 1.68-4.75 4.75v2.75H7v4h3v10h4v-10z" />
                            </svg>
                        </button>
                        <a href="https://facebook.com/" target="_blank" rel="noopener noreferrer" class="doodle-tooltip tooltip-facebook" title="Open @alifladiestailor on Facebook">
                            @alifladiestailor <span class="doodle-tooltip-arrow">↗</span>
                        </a>
                    </li>

                    <!-- WhatsApp -->
                    <li class="doodle-icon-content">
                        <button type="button" aria-label="WhatsApp (+91 72504 70009)" class="doodle-link link-whatsapp">
                            <svg class="doodle-svg" viewBox="0 0 24 24" fill="none" stroke="#1e1e24" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                            </svg>
                        </button>
                        <a href="https://wa.me/7250470009" target="_blank" rel="noopener noreferrer" class="doodle-tooltip tooltip-whatsapp" title="Chat on WhatsApp (+91 72504 70009)">
                            +91 72504 70009 <span class="doodle-tooltip-arrow">↗</span>
                        </a>
                    </li>

                    <!-- Email -->
                    <li class="doodle-icon-content">
                        <button type="button" aria-label="Email (alifladiestailor@gmail.com)" class="doodle-link link-mail">
                            <svg class="doodle-svg" version="1.1" viewBox="0 0 100 100">
                                <path class="doodle-path" d="M20 80A12 12 0 0 1 8 68v-40A12 12 0 0 1 20 16h56A12 12 0 0 1 88 28v40A12 12 0 0 1 76 80zm10.5 -47.12a4 4 0 1 0 -5.001 6.24l15.001 12.004a12 12 0 0 0 15.001 0l15.001 -12a4 4 0 1 0 -5.001 -6.247l-15.001 12a4 4 0 0 1 -5.001 0z" />
                            </svg>
                        </button>
                        <a href="mailto:alifladiestailor@gmail.com" target="_blank" rel="noopener noreferrer" class="doodle-tooltip tooltip-mail" title="Send Email to alifladiestailor@gmail.com">
                            alifladiestailor@gmail.com <span class="doodle-tooltip-arrow">↗</span>
                        </a>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Minimal Bottom Bar -->
        <div class="footer-bottom">
            <div class="footer-bottom-inner">
                <p class="footer-copyright">© 2025 ALiF LADIES TAILOR. ALL RIGHTS RESERVED.</p>
                <p class="footer-subtext">HANDCRAFTED IN SAHIBGANJ</p>
            </div>
        </div>
    </footer>

    <!-- React Island: ALiF AI Assistant Widget -->
    <AIChatWidget client:load />

    <script is:inline>
        // Drawer Nav logic
        function initSidebar() {
            const toggleBtn = document.getElementById('navToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const sidebar = document.getElementById('sidebarMenu');
            const overlay = document.getElementById('sidebarOverlay');

            function openSidebar(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                if (sidebar && overlay) {
                    sidebar.classList.add('is-open', 'active');
                    overlay.classList.add('is-open', 'active');
                    document.body.classList.add('sidebar-open');
                    document.body.style.overflow = 'hidden';
                }
            }

            function closeSidebar(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                if (sidebar && overlay) {
                    sidebar.classList.remove('is-open', 'active');
                    overlay.classList.remove('is-open', 'active');
                    document.body.classList.remove('sidebar-open');
                    document.body.style.overflow = '';
                }
            }

            if (toggleBtn) {
                toggleBtn.onclick = openSidebar;
            }
            if (closeBtn) {
                closeBtn.onclick = closeSidebar;
            }
            if (overlay) {
                overlay.onclick = closeSidebar;
            }

            // Close on escape key
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeSidebar();
            });

            // Close when clicking a link inside the sidebar
            if (sidebar) {
                const links = sidebar.querySelectorAll('a');
                links.forEach((link) => {
                    link.addEventListener('click', () => closeSidebar());
                });
            }
        }

        // Interactive Doodle Social Icons: click icon to wiggle, click speech bubble tooltip to open link
        function initDoodleSocial() {
            const doodleButtons = document.querySelectorAll('.doodle-link');
            if (!doodleButtons.length) return;

            doodleButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const isWiggling = this.classList.contains('is-wiggling');
                    const parent = this.closest('.doodle-icon-content');

                    // Reset any other icon
                    doodleButtons.forEach(other => {
                        other.classList.remove('is-wiggling');
                        const otherParent = other.closest('.doodle-icon-content');
                        if (otherParent) otherParent.classList.remove('is-wiggling');
                    });

                    if (!isWiggling) {
                        // Activate wiggle on this icon & display its speech bubble tooltip
                        this.classList.add('is-wiggling');
                        if (parent) parent.classList.add('is-wiggling');
                    } else {
                        // Toggle off if clicked again
                        this.classList.remove('is-wiggling');
                        if (parent) parent.classList.remove('is-wiggling');
                    }
                });
            });

            // Prevent tooltip clicks from bubbling to container or closing early
            const tooltips = document.querySelectorAll('.doodle-tooltip');
            tooltips.forEach(tooltip => {
                tooltip.addEventListener('click', function(e) {
                    e.stopPropagation();
                });
            });

            // Dismiss wiggling when clicking anywhere outside
            document.addEventListener('click', function(e) {
                if (!e.target.closest('.doodle-container')) {
                    doodleButtons.forEach(btn => {
                        btn.classList.remove('is-wiggling');
                        const parent = btn.closest('.doodle-icon-content');
                        if (parent) parent.classList.remove('is-wiggling');
                    });
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                initSidebar();
                initDoodleSocial();
            });
        } else {
            initSidebar();
            initDoodleSocial();
        }
        document.addEventListener('astro:page-load', () => {
            initSidebar();
            initDoodleSocial();
        });

        // Cart Count badge synchronization
        try {
            const savedCart = JSON.parse(localStorage.getItem('alif_cart') || '[]');
            const count = savedCart.reduce((sum, item) => sum + (item.quantity || 1), 0);
            const badge1 = document.getElementById('cartCount');
            const badge2 = document.getElementById('cartCountMobile');
            if (badge1) badge1.innerText = count;
            if (badge2) badge2.innerText = count;
        } catch(e) {}
    </script>
</body>
</html>
