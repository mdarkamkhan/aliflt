                    </li>

                    <!-- Services Group Hierarchy -->
                    <li class="drawer-nav-item drawer-nav-group" id="drawerGroupServices">
                        <button type="button" class="drawer-group-btn" aria-expanded="false" aria-controls="drawerSubmenuServices">
                            <span>SERVICES</span>
                        </button>
                        <ul class="drawer-submenu" id="drawerSubmenuServices">
                            <li><a href="/services/" class="drawer-sub-link">All Services</a></li>
                            <li><a href="/works/" class="drawer-sub-link">Works</a></li>
                            <li><a href="/designs/" class="drawer-sub-link">Designs</a></li>
                        </ul>
                    </li>

                    <!-- Contact (No Hierarchy) -->
                    <li class="drawer-nav-item">
                        <a href="/contact-us/" class="drawer-top-link">Contact</a>
                    </li>

                    <!-- Cart (No Hierarchy) -->
                    <li class="drawer-nav-item">
                        <a href="/cart/" class="drawer-top-link">Cart</a>
                    </li>
                </ul>
            </nav>

            <!-- PWA Install App Button (Prominent & Highlighted) -->
            <div class="drawer-install-wrapper">
                <button type="button" class="drawer-install-btn" id="drawerInstallPwaBtn" aria-label="Install alif. App">
                    <span>INSTALL APP</span>
