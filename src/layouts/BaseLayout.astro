---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  hideFooter?: boolean;
  preloadImage?: string;
  preloadImageSrcset?: string;
  preloadImageSizes?: string;
}

import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

const {
  title = "alif. ladies tailor",
  description = "Custom bridal blouses, lehengas, gowns — premium ladies tailoring in Sahibganj.",
  image = "/icons/icon-512x512.png",
  hideFooter = false,
  preloadImage,
  preloadImageSrcset,
  preloadImageSizes,
} = Astro.props;

const siteUrl = "https://aliflt.netlify.app";
const currentPath = Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteUrl).href;
const ogImageUrl = image.startsWith('http') ? image : new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {import.meta.env.DEV && (
      <script is:inline type="module">
        import RefreshRuntime from '/@react-refresh';
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => () => {};
        window.__vite_plugin_react_preamble_installed__ = true;
      </script>
    )}
    
    <title>{title} | alif.</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <meta name="theme-color" content="#FBF9F6"/>
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="alif.">

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageUrl}>

    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://res.cloudinary.com">
    <!-- Non-blocking font load: preload as style, swap to stylesheet on load -->
    <link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Ubuntu:wght@400;500;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'">
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Ubuntu:wght@400;500;700&display=swap">
    </noscript>
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadImage}
        imagesrcset={preloadImageSrcset}
        imagesizes={preloadImageSizes}
        type="image/webp"
        fetchpriority="high"
      />
    )}
    <ClientRouter />
</head>

<body>
    <!-- Professional PWA App Launch Splash (Standalone Mode Feedback) -->
    <div id="pwaAppLaunchSplash" class="pwa-launch-splash" aria-hidden="true">
        <div class="pwa-splash-content">
            <span class="pwa-splash-logo">alif.</span>
            <span class="pwa-splash-sub">A CUSTOM CLOTHING STORE</span>
            <div class="pwa-splash-bar"><span class="pwa-splash-progress"></span></div>
        </div>
    </div>

    <!-- PWA Install Guide Bottom Sheet Modal (Universal fallback for Chrome & iOS Safari) -->
    <div id="pwaInstallModal" class="pwa-modal-backdrop" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="pwa-modal-card">
            <div class="pwa-modal-drag-pill" aria-hidden="true"></div>
            <div class="pwa-modal-header">
                <div class="pwa-modal-brand-badge">
                    <img src="/android-chrome-192x192.png" alt="alif. icon" class="pwa-modal-icon" width="46" height="46" loading="lazy" decoding="async" />
                    <div>
                        <div class="pwa-modal-title">alif. atelier app</div>
                        <div class="pwa-modal-caption">Fast, offline-ready & standalone</div>
                    </div>
                </div>
                <button type="button" class="pwa-modal-close-btn" id="closePwaModalBtn" aria-label="Close dialog">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
                    </svg>
                </button>
            </div>

            <div id="pwaModalPromptSection" class="pwa-modal-body" style="display:none;">
                <p class="pwa-modal-desc">Install the official <strong>alif.</strong> app to your device for 1-tap booking, instant reel browsing, and full-screen luxury shopping.</p>
                <button type="button" class="pwa-modal-action-btn" id="pwaTriggerNativePromptBtn">
                    INSTALL NOW
                </button>
            </div>

            <div id="pwaModalIosGuide" class="pwa-modal-body" style="display:none;">
                <p class="pwa-modal-desc">Follow 2 quick steps to add <strong>alif.</strong> to your iPhone / iPad Home Screen:</p>
                <ol class="pwa-modal-steps">
                    <li>
                        <span class="step-num">1</span>
                        <span>Tap the <strong>Share</strong> button <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle; display:inline-block;"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg> at the bottom of Safari.</span>
                    </li>
                    <li>
                        <span class="step-num">2</span>
                        <span>Scroll down and select <strong>"Add to Home Screen"</strong> <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:middle; display:inline-block;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>.</span>
                    </li>
                </ol>
                <button type="button" class="pwa-modal-action-btn secondary" id="pwaDismissIosBtn">
                    GOT IT
                </button>
            </div>

            <div id="pwaModalAndroidGuide" class="pwa-modal-body" style="display:none;">
                <p class="pwa-modal-desc">To install <strong>alif.</strong> on Chrome or your mobile browser:</p>
                <ol class="pwa-modal-steps">
                    <li>
                        <span class="step-num">1</span>
                        <span>Tap your browser menu <strong>(⋮)</strong> in the top-right corner.</span>
                    </li>
                    <li>
                        <span class="step-num">2</span>
                        <span>Tap <strong>"Install app"</strong> or <strong>"Add to Home screen"</strong>.</span>
                    </li>
                </ol>
                <button type="button" class="pwa-modal-action-btn secondary" id="pwaDismissAndroidBtn">
                    GOT IT
                </button>
            </div>
        </div>
    </div>

    <!-- Fixed Background Canvas from ELEMENTS/BG -->
    <div id="fixed-bg-pattern" aria-hidden="true" transition:persist></div>

    <!-- React Island Root: Search Overlay (Loaded on-demand on search interaction) -->
    <div id="search-modal-root" transition:persist></div>

    <!-- Fixed Top Nav -->
    <nav class="fixed-top-nav" transition:persist>
        <a href="/" class="nav-logo">alif.</a>

        <div class="nav-actions">
            <button class="nav-search-btn" id="open-search" type="button" aria-label="Search" style="background: transparent; border: none; outline: none; padding: 0; margin: 0; box-shadow: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 50%; width: 36px; height: 36px; -webkit-appearance: none; appearance: none;">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </button>

            <a href="/cart/" class="nav-cart-btn" id="cartIcon" aria-label="View Cart" style="position: relative; display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; text-decoration: none; color: #111111; background: transparent; border: none; outline: none;">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
                <span class="cart-count" id="cartCount">0</span>
            </a>

            <button class="nav-toggle-btn" id="navToggleBtn" type="button" aria-label="Open menu" aria-controls="sidebarMenu" aria-expanded="false" style="background: transparent; border: none; outline: none; padding: 0; margin: 0; box-shadow: none; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 50%; width: 36px; height: 36px; -webkit-appearance: none; appearance: none;">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round" style="pointer-events:none;">
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>
    </nav>

    <!-- Marquee Banner (Continuous Luxury Ticker) -->
    <div class="marquee-container" aria-label="Store Announcements">
        <div class="marquee-track">
            <div class="marquee-group">
                <span class="marquee-item">alif. · A CUSTOM CLOTHING STORE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">EXPLORE TRENDING REELS</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">WHATSAPP BOOKING AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">DOORSTEP DELIVERY AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
            </div>
            <div class="marquee-group" aria-hidden="true">
                <span class="marquee-item">alif. · A CUSTOM CLOTHING STORE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">EXPLORE TRENDING REELS</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">WHATSAPP BOOKING AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">DOORSTEP DELIVERY AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
            </div>
            <div class="marquee-group" aria-hidden="true">
                <span class="marquee-item">alif. · A CUSTOM CLOTHING STORE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">EXPLORE TRENDING REELS</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">WHATSAPP BOOKING AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
                <span class="marquee-item">DOORSTEP DELIVERY AVAILABLE</span>
                <span class="marquee-sep" aria-hidden="true">·</span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <main>
        <slot />
    </main>

    <!-- Bottom Navigation Bar (Mobile) -->
    <nav class="bottom-nav" transition:persist>
        <a href="/" data-astro-prefetch="tap" class={`b-nav-item ${currentPath === '/' ? 'active' : ''}`} id="bNavHome" aria-label="Home">
            <span class="b-nav-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
            </span>
            <span class="b-nav-label">Home</span>
        </a>
        <a href="/reels/" data-astro-prefetch="tap" class={`b-nav-item ${currentPath.startsWith('/reels/') ? 'active' : ''}`} id="bNavReels" aria-label="Explore Reels">
            <span class="b-nav-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2.5" y="2.5" width="19" height="19" rx="4.5" />
                    <line x1="2.5" y1="8.5" x2="21.5" y2="8.5" />
                    <line x1="8" y1="2.5" x2="10.5" y2="8.5" />
                    <line x1="14" y1="2.5" x2="16.5" y2="8.5" />
                    <polygon points="10 12 15 15 10 18 10 12" fill="currentColor" stroke="none" />
                </svg>
            </span>
            <span class="b-nav-label">Reels</span>
        </a>
        <a href="/products/" data-astro-prefetch="tap" class={`b-nav-item ${currentPath.startsWith('/products/') ? 'active' : ''}`} aria-label="Products">
            <span class="b-nav-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </span>
            <span class="b-nav-label">Products</span>
        </a>
        <a href="/services/" data-astro-prefetch="tap" class={`b-nav-item ${currentPath.startsWith('/services/') ? 'active' : ''}`} aria-label="Services">
            <span class="b-nav-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="6" cy="6" r="3"></circle>
                    <circle cx="6" cy="18" r="3"></circle>
                    <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                    <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                    <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
                </svg>
            </span>
            <span class="b-nav-label">Services</span>
        </a>
        <a href="/contact-us/" data-astro-prefetch="tap" class={`b-nav-item ${currentPath.startsWith('/contact-us/') ? 'active' : ''}`} aria-label="Contact">
            <span class="b-nav-icon-box">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
            </span>
            <span class="b-nav-label">Contact</span>
        </a>
    </nav>

    <!-- Minimalist Mobile Popup Drawer (From ELEMENTS/sidebar % ARABICA UAE) -->
    <div 
        class="arabica-clone-drawer" 
        id="sidebarMenu"
        role="dialog"
        aria-modal="true"
        aria-hidden="true"
        transition:persist
    >
        <!-- Signature Arabica Dotted Box Close Button -->
        <button 
            type="button" 
            class="drawer-close-btn" 
            id="sidebarCloseBtn" 
            aria-label="Close menu"
        >
            <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor">
                <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
            </svg>
        </button>

        <!-- Centered Inner Wrapper -->
        <div class="drawer-inner">
            <!-- Brand Logo Area -->
            <div class="drawer-logo">
                <h2 class="drawer-brand-title">alif.</h2>
                <span class="drawer-brand-sub">A CUSTOM CLOTHING STORE</span>
            </div>

            <!-- Navigation Links with Luxury Hierarchy (Left-Aligned & Prominent) -->
            <nav class="drawer-nav" aria-label="Main navigation">
                <ul class="drawer-main-list">
                    <li class="drawer-nav-item">
                        <a href="/" class="drawer-top-link">Home</a>
                    </li>

                    <!-- Product Group Hierarchy -->
                    <li class="drawer-nav-item drawer-nav-group" id="drawerGroupProduct">
                        <button type="button" class="drawer-group-btn" aria-expanded="false" aria-controls="drawerSubmenuProduct">
                            <span>PRODUCT</span>
                        </button>
                        <ul class="drawer-submenu" id="drawerSubmenuProduct">
                            <li><a href="/products/" class="drawer-sub-link">All Products</a></li>
                            <li><a href="/products/?category=curated-sets" class="drawer-sub-link">Curated Sets</a></li>
                            <li><a href="/reels/" class="drawer-sub-link">Reels</a></li>
