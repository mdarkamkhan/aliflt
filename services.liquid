---
layout: base.liquid
title: Tailoring Services
description: Custom blouse stitching, designer suits, bridal lehengas, and boutique tailoring services in Sahibganj by ALiF Ladies Tailor.
permalink: /services/
---

<div class="container section fade-in-section">
  <div style="text-align: center; margin-bottom: 35px;">
    <h1 style="font-family: var(--font-heading); font-size: 1.8rem; margin: 0 0 8px 0; text-transform: uppercase; letter-spacing: 2px;">Tailoring Services</h1>
    <p style="color: #666; font-size: 0.9rem; margin: 0; font-family: var(--font-body); letter-spacing: 0.5px;">Custom boutique stitching, bridal wear, and designer tailoring crafted to perfection.</p>
  </div>

  <div class="product-grid">
    {% for item in collections.service reversed %}
      <a href="{{ item.url }}" class="product-card" style="border: 1px solid #eaeaea; background: #fff; transition: transform 0.3s ease, box-shadow 0.3s ease; text-decoration: none; color: inherit; display: flex; flex-direction: column;">
        <div class="product-card-image-wrapper" style="aspect-ratio: 1 / 1.15; background: #0e0e0e; overflow: hidden; position: relative;">
          {% if item.data.image %}
            <img src="{{ item.data.image }}" alt="{{ item.data.title | escape }}" style="width: 100%; height: 100%; object-fit: cover;">
          {% else %}
            <div style="width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 24px; text-align: center; background: radial-gradient(circle at center, #1c1c1c 0%, #0a0a0a 100%); color: #fff; box-sizing: border-box; position: relative;">
              <div style="position: absolute; inset: 10px; border: 1px solid rgba(255, 255, 255, 0.08); pointer-events: none;"></div>
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" style="opacity: 0.8; margin-bottom: 12px; color: #fff;">
                <circle cx="6" cy="6" r="3"></circle>
                <circle cx="6" cy="18" r="3"></circle>
                <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
                <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
                <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
              </svg>
              <span style="font-family: var(--font-heading); font-size: 1.15rem; letter-spacing: 2.5px; text-transform: uppercase; color: #fff; font-weight: 500;">ALiF</span>
              <span style="display: block; width: 24px; height: 1px; background: rgba(255,255,255,0.25); margin: 6px 0;"></span>
              <span style="font-family: var(--font-body); font-size: 0.65rem; letter-spacing: 2px; color: #aaa; text-transform: uppercase;">BOUTIQUE</span>
            </div>
          {% endif %}
        </div>

        <div class="product-card-name" style="padding: 16px 14px; display: flex; flex-direction: column; flex-grow: 1;">
          <div class="product-card-title" style="font-family: var(--font-heading); font-size: 1.05rem; font-weight: 500; color: #111;">
            {{ item.data.title | default: 'Tailoring Service' }}
          </div>

          {% if item.data.price %}
          <div class="product-card-price" style="font-size: 0.95rem; font-weight: 500; color: #111; margin-top: 5px;">
            Starting from ₹{{ item.data.price }}
          </div>
          {% endif %}

          {% if item.data.category %}
          <div class="product-card-category" style="font-size: 0.72rem; color: #888; text-transform: uppercase; letter-spacing: 1.2px; margin-top: 4px;">
            {{ item.data.category }}
          </div>
          {% endif %}

          <div style="margin-top: auto; padding-top: 14px; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 500; color: #000; display: inline-flex; align-items: center; gap: 4px;">
            <span>Details &amp; Book</span>
            <span>&rarr;</span>
          </div>
        </div>
      </a>
    {% endfor %}

    {% if collections.service.size == 0 %}
      <p class="empty-gallery-message" style="position:static; transform:none; color:#333; width:100%; text-align:center; padding: 40px 0;">
        Services coming soon. Please contact us for custom stitching orders.
      </p>
    {% endif %}
  </div>
</div>
